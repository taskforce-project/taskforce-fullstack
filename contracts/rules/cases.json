    {
      "name": "reading a file is allowed",
      "facts": {
        "action": "file.read",
        "path": "src/a.ts"
      },
      "expect": {
        "effect": "allow",
        "rule": "read-files"
      }
    },
    {
      "name": "writing in the copy is allowed",
      "facts": {
        "action": "file.write",
        "path": "src/a.ts"
      },
      "expect": {
        "effect": "allow",
        "rule": "write-sandbox-files"
      }
    },
    {
      "name": "the agent running the tests is denied: the runner runs them (S1)",
      "facts": {
        "action": "shell",
        "command": "npm test"
      },
      "expect": {
        "effect": "deny",
        "rule": "no-agent-scripts"
      }
    },
    {
      "name": "the agent running a test script is denied",
      "facts": {
        "action": "shell",
        "command": "npm run test:unit"
      },

{
  "description": "Shared cases: the runner (TypeScript) and the server (Java) must give exactly these answers. Decisions use default.rules.json; rule is null when no rule matched.",
  "globs": [
    {
      "pattern": "tf/**",
      "value": "tf/web-48",
      "match": true
    },
    {
      "pattern": "tf/**",
      "value": "tf/a/b",
      "match": true
    },
    {
      "pattern": "tf/**",
      "value": "tfx/a",
      "match": false
    },
    {
      "pattern": "tf/*",
      "value": "tf/a/b",
      "match": false
    },
    {
      "pattern": "tf/*",
      "value": "tf/a",
      "match": true
    },
    {
      "pattern": "*",
      "value": "",
      "match": true
    },
    {
      "pattern": "a.b",
      "value": "aXb",
      "match": false
    },
    {
      "pattern": "a.b",
      "value": "a.b",
      "match": true
    },
    {
      "pattern": "{a,b}",
      "value": "c",
      "match": false
    },
    {
      "pattern": "{a,b}",
      "value": "b",
      "match": true
    },
    {
      "pattern": "npm {test,run test}**",
      "value": "npm run test:unit",
      "match": true
    },
    {
      "pattern": "npm {test,run test}**",
      "value": "npm install",
      "match": false
    },
    {
      "pattern": "git push**",
      "value": "git push origin main",
      "match": true
    },
    {
      "pattern": "gh **",
      "value": "gh pr create --fill",
      "match": true
    },
    {
      "pattern": "src/*.ts",
      "value": "src/a/b.ts",
      "match": false
    },
    {
      "pattern": "src/**.ts",
      "value": "src/a/b.ts",
      "match": true
    },
    {
      "pattern": "{npm,yarn,pnpm} {test,run}**",
      "value": "pnpm run lint",
      "match": true
    },
    {
      "pattern": "{npm,yarn,pnpm} {test,run}**",
      "value": "npm install",
      "match": false
    },
    {
      "pattern": "{cd,ls}{, **}",
      "value": "ls",
      "match": true
    },
    {
      "pattern": "{cd,ls}{, **}",
      "value": "ls -la src",
      "match": true
    },
    {
      "pattern": "{cd,ls}{, **}",
      "value": "cd \"/work/run-6\"",
      "match": true
    },
    {
      "pattern": "{cd,ls}{, **}",
      "value": "lsof -i",
      "match": false
    }

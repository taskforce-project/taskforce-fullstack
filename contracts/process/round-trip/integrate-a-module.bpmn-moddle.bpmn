<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tf="https://taskforce-project.fr/schema/process/1" id="integrate-a-module.definitions" targetNamespace="https://taskforce-project.fr/processes" exporter="TaskForce" exporterVersion="taskforce-process/1">
  <bpmn:message id="acceptance-report.message" name="The acceptance report from the client&#39;s tester" />
  <bpmn:process id="integrate-a-module" name="Integrate a module" isExecutable="true">
    <bpmn:documentation>The default workflow of software delivery: integrate a new module into the company's base tool, from its scope to its delivery, with who answers for each step, who decides, and three pause points: before every agent mission (the checklist opens with its last answer), before the agents' changes are applied, and before the work is delivered.</bpmn:documentation>
    <bpmn:extensionElements>
      <tf:process format="taskforce-process/1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="requested" name="Module requested">
      <bpmn:outgoing>requested-frame</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="frame" name="Frame">
      <bpmn:incoming>requested-frame</bpmn:incoming>
      <bpmn:outgoing>frame-go-ahead</bpmn:outgoing>
      <bpmn:startEvent id="frame-start" name="Framing starts">
        <bpmn:outgoing>frame-start-write-scope</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="write-scope" name="Write the module&#39;s scope">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="input" question="What must the module do, and by when?">
              <tf:field id="goal" label="What the module must do" type="text" />
              <tf:field id="due" label="When it is needed" type="date" />
              <tf:field id="out-of-scope" label="What it won&#39;t do" type="text" />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>frame-start-write-scope</bpmn:incoming>
        <bpmn:outgoing>write-scope-approve-scope</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="approve-scope" name="Approve the scope">
        <bpmn:extensionElements>
          <tf:step answeredBy="role:owner">
            <tf:human who="role:owner" kind="approval" meaning="approval" question="Do we integrate this module, with this scope?" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>write-scope-approve-scope</bpmn:incoming>
        <bpmn:outgoing>approve-scope-frame-end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="frame-end" name="Scope decided">
        <bpmn:incoming>approve-scope-frame-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="frame-start-write-scope" sourceRef="frame-start" targetRef="write-scope" />
      <bpmn:sequenceFlow id="write-scope-approve-scope" sourceRef="write-scope" targetRef="approve-scope" />
      <bpmn:sequenceFlow id="approve-scope-frame-end" sourceRef="approve-scope" targetRef="frame-end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="go-ahead" name="Go ahead with the module?" default="go-ahead-stopped">
      <bpmn:extensionElements>
        <tf:step answeredBy="role:owner" />
      </bpmn:extensionElements>
      <bpmn:incoming>frame-go-ahead</bpmn:incoming>
      <bpmn:outgoing>go-ahead-specify</bpmn:outgoing>
      <bpmn:outgoing>go-ahead-stopped</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stopped" name="Integration stopped">
      <bpmn:incoming>go-ahead-stopped</bpmn:incoming>
      <bpmn:terminateEventDefinition id="stopped.terminate" />
    </bpmn:endEvent>
    <bpmn:subProcess id="specify" name="Specify">
      <bpmn:incoming>go-ahead-specify</bpmn:incoming>
      <bpmn:outgoing>specify-break-down</bpmn:outgoing>
      <bpmn:startEvent id="specify-start" name="Specification starts">
        <bpmn:outgoing>specify-start-before-mission</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="before-mission" name="Before the agents start">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>specify-start-before-mission</bpmn:incoming>
        <bpmn:incoming>spec-approved-before-mission</bpmn:incoming>
        <bpmn:outgoing>before-mission-spec-zone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:adHocSubProcess id="spec-zone" name="Draft the specification">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="read-files" />
            <tf:rule ref="search-files" />
            <tf:rule ref="search-knowledge" />
            <tf:rule ref="no-agent-push" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-mission-spec-zone</bpmn:incoming>
        <bpmn:outgoing>spec-zone-review-spec</bpmn:outgoing>
        <bpmn:serviceTask id="draft-spec" name="Draft the specification from the base tool&#39;s documentation">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="cortex" attempts="3" timeout="PT1H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:userTask id="review-spec" name="Review the specification">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="approval" meaning="review" question="Does the specification say what the module must do, in the base tool&#39;s terms?" />
            <tf:document name="Specification" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>spec-zone-review-spec</bpmn:incoming>
        <bpmn:outgoing>review-spec-spec-approved</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="spec-approved" name="Is the specification approved?" default="spec-approved-before-mission">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" />
        </bpmn:extensionElements>
        <bpmn:incoming>review-spec-spec-approved</bpmn:incoming>
        <bpmn:outgoing>spec-approved-specify-end</bpmn:outgoing>
        <bpmn:outgoing>spec-approved-before-mission</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="specify-end" name="Specification approved">
        <bpmn:incoming>spec-approved-specify-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="specify-start-before-mission" sourceRef="specify-start" targetRef="before-mission" />
      <bpmn:sequenceFlow id="before-mission-spec-zone" sourceRef="before-mission" targetRef="spec-zone" />
      <bpmn:sequenceFlow id="spec-zone-review-spec" sourceRef="spec-zone" targetRef="review-spec" />
      <bpmn:sequenceFlow id="review-spec-spec-approved" sourceRef="review-spec" targetRef="spec-approved" />
      <bpmn:sequenceFlow id="spec-approved-specify-end" name="Yes" sourceRef="spec-approved" targetRef="specify-end">
        <bpmn:extensionElements>
          <tf:condition step="review-spec" outcome="approved" />
        </bpmn:extensionElements>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://taskforce-project.fr/schema/process/1#condition">The specification is approved</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="spec-approved-before-mission" name="Otherwise" sourceRef="spec-approved" targetRef="before-mission" />
    </bpmn:subProcess>
    <bpmn:subProcess id="break-down" name="Break down">
      <bpmn:incoming>specify-break-down</bpmn:incoming>
      <bpmn:outgoing>break-down-build</bpmn:outgoing>
      <bpmn:startEvent id="break-down-start" name="Breakdown starts">
        <bpmn:outgoing>break-down-start-before-mission-breakdown</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="before-mission-breakdown" name="Before the agents break the work down">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>break-down-start-before-mission-breakdown</bpmn:incoming>
        <bpmn:outgoing>before-mission-breakdown-breakdown-zone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:adHocSubProcess id="breakdown-zone" name="Break the work down">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="read-issues" />
            <tf:rule ref="create-issue" />
            <tf:rule ref="update-issue" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-mission-breakdown-breakdown-zone</bpmn:incoming>
        <bpmn:outgoing>breakdown-zone-approve-breakdown</bpmn:outgoing>
        <bpmn:serviceTask id="split-into-issues" name="Split the specification into issues, each with its acceptance criteria">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="cortex" attempts="3" timeout="PT1H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:userTask id="approve-breakdown" name="Approve the breakdown">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="approval" meaning="approval" question="Do these issues cover the specification, each with its acceptance criteria?" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>breakdown-zone-approve-breakdown</bpmn:incoming>
        <bpmn:outgoing>approve-breakdown-break-down-end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="break-down-end" name="Work broken down">
        <bpmn:incoming>approve-breakdown-break-down-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="break-down-start-before-mission-breakdown" sourceRef="break-down-start" targetRef="before-mission-breakdown" />
      <bpmn:sequenceFlow id="before-mission-breakdown-breakdown-zone" sourceRef="before-mission-breakdown" targetRef="breakdown-zone" />
      <bpmn:sequenceFlow id="breakdown-zone-approve-breakdown" sourceRef="breakdown-zone" targetRef="approve-breakdown" />
      <bpmn:sequenceFlow id="approve-breakdown-break-down-end" sourceRef="approve-breakdown" targetRef="break-down-end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="build" name="Build">
      <bpmn:incoming>break-down-build</bpmn:incoming>
      <bpmn:incoming>accepted-build</bpmn:incoming>
      <bpmn:outgoing>build-test</bpmn:outgoing>
      <bpmn:startEvent id="build-start" name="Build starts">
        <bpmn:outgoing>build-start-before-mission-build</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="before-mission-build" name="Before the agents build">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>build-start-before-mission-build</bpmn:incoming>
        <bpmn:incoming>unblock-build-before-mission-build</bpmn:incoming>
        <bpmn:outgoing>before-mission-build-build-zone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:adHocSubProcess id="build-zone" name="Build the module">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="no-mission-public-repo" />
            <tf:rule ref="no-agent-push" />
            <tf:rule ref="no-agent-gh" />
            <tf:rule ref="push-agent-branch-private" />
            <tf:rule ref="open-pull-request" />
            <tf:rule ref="floor-irreversible" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-mission-build-build-zone</bpmn:incoming>
        <bpmn:outgoing>build-zone-build-end</bpmn:outgoing>
        <bpmn:serviceTask id="write-code" name="Write the module&#39;s code">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="claude-code" attempts="3" timeout="PT4H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="write-tests" name="Write the module&#39;s tests">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="claude-code" attempts="3" timeout="PT4H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="update-docs" name="Update the module&#39;s documentation">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="claude-code" attempts="3" timeout="PT2H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:boundaryEvent id="build-failed" name="The build failed" attachedToRef="build-zone">
        <bpmn:outgoing>build-failed-unblock-build</bpmn:outgoing>
        <bpmn:errorEventDefinition id="build-failed.event" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="build-late" name="Two days without a result" attachedToRef="build-zone">
        <bpmn:outgoing>build-late-unblock-build</bpmn:outgoing>
        <bpmn:timerEventDefinition id="build-late.event">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="unblock-build" name="Look at what blocks the build">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="input" question="What should the agent change before it tries again?">
              <tf:field id="instructions" label="What to change" type="text" />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>build-failed-unblock-build</bpmn:incoming>
        <bpmn:incoming>build-late-unblock-build</bpmn:incoming>
        <bpmn:outgoing>unblock-build-before-mission-build</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="build-end" name="Module built">
        <bpmn:incoming>build-zone-build-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="build-start-before-mission-build" sourceRef="build-start" targetRef="before-mission-build" />
      <bpmn:sequenceFlow id="before-mission-build-build-zone" sourceRef="before-mission-build" targetRef="build-zone" />
      <bpmn:sequenceFlow id="build-zone-build-end" sourceRef="build-zone" targetRef="build-end" />
      <bpmn:sequenceFlow id="build-failed-unblock-build" sourceRef="build-failed" targetRef="unblock-build" />
      <bpmn:sequenceFlow id="build-late-unblock-build" sourceRef="build-late" targetRef="unblock-build" />
      <bpmn:sequenceFlow id="unblock-build-before-mission-build" sourceRef="unblock-build" targetRef="before-mission-build" />
    </bpmn:subProcess>
    <bpmn:subProcess id="test" name="Test">
      <bpmn:incoming>build-test</bpmn:incoming>
      <bpmn:outgoing>test-review</bpmn:outgoing>
      <bpmn:startEvent id="test-start" name="Tests start">
        <bpmn:outgoing>test-start-before-mission-test</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="before-mission-test" name="Before the agents test">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>test-start-before-mission-test</bpmn:incoming>
        <bpmn:incoming>fix-zone-before-mission-test</bpmn:incoming>
        <bpmn:outgoing>before-mission-test-test-zone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:adHocSubProcess id="test-zone" name="Test the module">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="no-agent-scripts" />
            <tf:rule ref="no-agent-push" />
            <tf:rule ref="push-agent-branch-private" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-mission-test-test-zone</bpmn:incoming>
        <bpmn:outgoing>test-zone-test-end</bpmn:outgoing>
        <bpmn:serviceTask id="test-criteria" name="Test the module against each acceptance criterion">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="claude-code" attempts="3" timeout="PT2H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:boundaryEvent id="tests-failed" name="The tests fail" attachedToRef="test-zone">
        <bpmn:outgoing>tests-failed-before-mission-fix</bpmn:outgoing>
        <bpmn:errorEventDefinition id="tests-failed.event" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="before-mission-fix" name="Before the agents fix what the tests found">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>tests-failed-before-mission-fix</bpmn:incoming>
        <bpmn:outgoing>before-mission-fix-fix-zone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:adHocSubProcess id="fix-zone" name="Fix what the tests found">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="no-agent-push" />
            <tf:rule ref="no-agent-gh" />
            <tf:rule ref="push-agent-branch-private" />
            <tf:rule ref="floor-irreversible" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-mission-fix-fix-zone</bpmn:incoming>
        <bpmn:outgoing>fix-zone-before-mission-test</bpmn:outgoing>
        <bpmn:serviceTask id="fix-tests" name="Fix what the tests found">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="claude-code" attempts="3" timeout="PT4H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:endEvent id="test-end" name="Module tested">
        <bpmn:incoming>test-zone-test-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="test-start-before-mission-test" sourceRef="test-start" targetRef="before-mission-test" />
      <bpmn:sequenceFlow id="before-mission-test-test-zone" sourceRef="before-mission-test" targetRef="test-zone" />
      <bpmn:sequenceFlow id="test-zone-test-end" sourceRef="test-zone" targetRef="test-end" />
      <bpmn:sequenceFlow id="tests-failed-before-mission-fix" sourceRef="tests-failed" targetRef="before-mission-fix" />
      <bpmn:sequenceFlow id="before-mission-fix-fix-zone" sourceRef="before-mission-fix" targetRef="fix-zone" />
      <bpmn:sequenceFlow id="fix-zone-before-mission-test" sourceRef="fix-zone" targetRef="before-mission-test" />
    </bpmn:subProcess>
    <bpmn:subProcess id="review" name="Review">
      <bpmn:incoming>test-review</bpmn:incoming>
      <bpmn:outgoing>review-accept</bpmn:outgoing>
      <bpmn:startEvent id="review-start" name="Review starts">
        <bpmn:outgoing>review-start-review-code</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="review-code" name="Review the code">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="approval" meaning="review" question="Does the change do what the specification says, the way the base tool does things?" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>review-start-review-code</bpmn:incoming>
        <bpmn:incoming>remarks-zone-review-code</bpmn:incoming>
        <bpmn:outgoing>review-code-review-approved</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="review-approved" name="Is the review approved?" default="review-approved-before-mission-remarks">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" />
        </bpmn:extensionElements>
        <bpmn:incoming>review-code-review-approved</bpmn:incoming>
        <bpmn:outgoing>review-approved-before-apply</bpmn:outgoing>
        <bpmn:outgoing>review-approved-before-mission-remarks</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="before-mission-remarks" name="Before the agents apply the review&#39;s remarks">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>review-approved-before-mission-remarks</bpmn:incoming>
        <bpmn:outgoing>before-mission-remarks-remarks-zone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:adHocSubProcess id="remarks-zone" name="Apply the review&#39;s remarks">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="no-agent-push" />
            <tf:rule ref="no-agent-gh" />
            <tf:rule ref="push-agent-branch-private" />
            <tf:rule ref="floor-irreversible" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-mission-remarks-remarks-zone</bpmn:incoming>
        <bpmn:outgoing>remarks-zone-review-code</bpmn:outgoing>
        <bpmn:serviceTask id="apply-remarks" name="Apply the review&#39;s remarks">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="claude-code" attempts="3" timeout="PT4H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:userTask id="before-apply" name="Before applying the changes">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-apply">
            <tf:human who="project-lead" kind="checklist" meaning="approval" question="Can the module&#39;s changes be applied to the base tool?">
              <tf:item text="The tests pass with the environment sheet&#39;s command." />
              <tf:item text="The review is approved." />
              <tf:item text="No protected branch was touched." />
              <tf:item text="The module&#39;s documentation is up to date." />
              <tf:item text="Every change to the data can be undone." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>review-approved-before-apply</bpmn:incoming>
        <bpmn:outgoing>before-apply-review-end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="review-end" name="Changes applied">
        <bpmn:incoming>before-apply-review-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="review-start-review-code" sourceRef="review-start" targetRef="review-code" />
      <bpmn:sequenceFlow id="review-code-review-approved" sourceRef="review-code" targetRef="review-approved" />
      <bpmn:sequenceFlow id="review-approved-before-apply" name="Yes" sourceRef="review-approved" targetRef="before-apply">
        <bpmn:extensionElements>
          <tf:condition step="review-code" outcome="approved" />
        </bpmn:extensionElements>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://taskforce-project.fr/schema/process/1#condition">The review is approved</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="review-approved-before-mission-remarks" name="Otherwise" sourceRef="review-approved" targetRef="before-mission-remarks" />
      <bpmn:sequenceFlow id="before-mission-remarks-remarks-zone" sourceRef="before-mission-remarks" targetRef="remarks-zone" />
      <bpmn:sequenceFlow id="remarks-zone-review-code" sourceRef="remarks-zone" targetRef="review-code" />
      <bpmn:sequenceFlow id="before-apply-review-end" sourceRef="before-apply" targetRef="review-end" />
    </bpmn:subProcess>
    <bpmn:subProcess id="accept" name="Accept">
      <bpmn:incoming>review-accept</bpmn:incoming>
      <bpmn:outgoing>accept-accepted</bpmn:outgoing>
      <bpmn:startEvent id="accept-start" name="Acceptance starts">
        <bpmn:outgoing>accept-start-before-mission-notes</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="before-mission-notes" name="Before the agents write the release notes">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-mission">
            <tf:human who="project-lead" kind="checklist" meaning="responsibility" question="Is everything ready for the agents?" prefill="last-answer">
              <tf:item text="The base tool&#39;s documentation is imported, with its version." />
              <tf:item text="The environment sheet is validated: install, build, test and run." />
              <tf:item text="The approved scope is written in the project." />
              <tf:item text="The rules that apply to the module are written." />
              <tf:item text="The agents work on a branch of their own, never on a protected branch." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>accept-start-before-mission-notes</bpmn:incoming>
        <bpmn:outgoing>before-mission-notes-accept-split</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="accept-split">
        <bpmn:incoming>before-mission-notes-accept-split</bpmn:incoming>
        <bpmn:outgoing>accept-split-acceptance-report</bpmn:outgoing>
        <bpmn:outgoing>accept-split-notes-zone</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:intermediateCatchEvent id="acceptance-report" name="Wait for the acceptance report">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:wait from="project-lead" />
            <tf:document name="Acceptance report" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>accept-split-acceptance-report</bpmn:incoming>
        <bpmn:outgoing>acceptance-report-accept-join</bpmn:outgoing>
        <bpmn:messageEventDefinition id="acceptance-report.event" messageRef="acceptance-report.message" />
      </bpmn:intermediateCatchEvent>
      <bpmn:adHocSubProcess id="notes-zone" name="Prepare the release notes">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:rule ref="read-files" />
            <tf:rule ref="search-knowledge" />
            <tf:rule ref="create-note" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>accept-split-notes-zone</bpmn:incoming>
        <bpmn:outgoing>notes-zone-accept-join</bpmn:outgoing>
        <bpmn:serviceTask id="write-notes" name="Write the release notes from the applied changes">
          <bpmn:extensionElements>
            <tf:step answeredBy="project-lead">
              <tf:agent provider="cortex" attempts="3" timeout="PT1H" />
            </tf:step>
          </bpmn:extensionElements>
        </bpmn:serviceTask>
      </bpmn:adHocSubProcess>
      <bpmn:parallelGateway id="accept-join">
        <bpmn:incoming>acceptance-report-accept-join</bpmn:incoming>
        <bpmn:incoming>notes-zone-accept-join</bpmn:incoming>
        <bpmn:outgoing>accept-join-sign-acceptance</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="sign-acceptance" name="Sign the acceptance">
        <bpmn:extensionElements>
          <tf:step answeredBy="role:owner">
            <tf:human who="role:owner" kind="approval" meaning="approval" question="Is the module accepted, as the acceptance report says?" />
            <tf:document name="Acceptance report" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>accept-join-sign-acceptance</bpmn:incoming>
        <bpmn:outgoing>sign-acceptance-accept-end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="accept-end" name="Acceptance decided">
        <bpmn:incoming>sign-acceptance-accept-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="accept-start-before-mission-notes" sourceRef="accept-start" targetRef="before-mission-notes" />
      <bpmn:sequenceFlow id="before-mission-notes-accept-split" sourceRef="before-mission-notes" targetRef="accept-split" />
      <bpmn:sequenceFlow id="accept-split-acceptance-report" sourceRef="accept-split" targetRef="acceptance-report" />
      <bpmn:sequenceFlow id="accept-split-notes-zone" sourceRef="accept-split" targetRef="notes-zone" />
      <bpmn:sequenceFlow id="acceptance-report-accept-join" sourceRef="acceptance-report" targetRef="accept-join" />
      <bpmn:sequenceFlow id="notes-zone-accept-join" sourceRef="notes-zone" targetRef="accept-join" />
      <bpmn:sequenceFlow id="accept-join-sign-acceptance" sourceRef="accept-join" targetRef="sign-acceptance" />
      <bpmn:sequenceFlow id="sign-acceptance-accept-end" sourceRef="sign-acceptance" targetRef="accept-end" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="accepted" name="Is the module accepted?" default="accepted-build">
      <bpmn:extensionElements>
        <tf:step answeredBy="role:owner" />
      </bpmn:extensionElements>
      <bpmn:incoming>accept-accepted</bpmn:incoming>
      <bpmn:outgoing>accepted-deliver</bpmn:outgoing>
      <bpmn:outgoing>accepted-build</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="deliver" name="Deliver">
      <bpmn:incoming>accepted-deliver</bpmn:incoming>
      <bpmn:outgoing>deliver-delivered</bpmn:outgoing>
      <bpmn:startEvent id="deliver-start" name="Delivery starts">
        <bpmn:outgoing>deliver-start-before-delivery</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="before-delivery" name="Before delivering">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" lock="pause-point" lockRef="before-delivery">
            <tf:human who="project-lead" kind="checklist" meaning="approval" question="Can the module go to the client?">
              <tf:item text="The acceptance is signed." />
              <tf:item text="The release notes are written." />
              <tf:item text="The version number follows the base tool&#39;s numbering." />
              <tf:item text="The way back to the previous version is written." />
              <tf:item text="The client knows when the module arrives." />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>deliver-start-before-delivery</bpmn:incoming>
        <bpmn:outgoing>before-delivery-deliver-module</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="deliver-module" name="Deliver the module">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="input" question="Which version went to the client, and when?">
              <tf:field id="version" label="Version delivered" type="text" />
              <tf:field id="delivered-on" label="Delivered on" type="date" />
            </tf:human>
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>before-delivery-deliver-module</bpmn:incoming>
        <bpmn:outgoing>deliver-module-watch</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateCatchEvent id="watch" name="Watch the module in use">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead" />
        </bpmn:extensionElements>
        <bpmn:incoming>deliver-module-watch</bpmn:incoming>
        <bpmn:outgoing>watch-close-integration</bpmn:outgoing>
        <bpmn:timerEventDefinition id="watch.event">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:userTask id="close-integration" name="Close the integration">
        <bpmn:extensionElements>
          <tf:step answeredBy="project-lead">
            <tf:human who="project-lead" kind="approval" meaning="approval" question="Did the module run without a problem since it was delivered?" />
          </tf:step>
        </bpmn:extensionElements>
        <bpmn:incoming>watch-close-integration</bpmn:incoming>
        <bpmn:outgoing>close-integration-deliver-end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="deliver-end" name="Integration closed">
        <bpmn:incoming>close-integration-deliver-end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="deliver-start-before-delivery" sourceRef="deliver-start" targetRef="before-delivery" />
      <bpmn:sequenceFlow id="before-delivery-deliver-module" sourceRef="before-delivery" targetRef="deliver-module" />
      <bpmn:sequenceFlow id="deliver-module-watch" sourceRef="deliver-module" targetRef="watch" />
      <bpmn:sequenceFlow id="watch-close-integration" sourceRef="watch" targetRef="close-integration" />
      <bpmn:sequenceFlow id="close-integration-deliver-end" sourceRef="close-integration" targetRef="deliver-end" />
    </bpmn:subProcess>
    <bpmn:endEvent id="delivered" name="Module delivered">
      <bpmn:incoming>deliver-delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="requested-frame" sourceRef="requested" targetRef="frame" />
    <bpmn:sequenceFlow id="frame-go-ahead" sourceRef="frame" targetRef="go-ahead" />
    <bpmn:sequenceFlow id="go-ahead-specify" name="Yes" sourceRef="go-ahead" targetRef="specify">
      <bpmn:extensionElements>
        <tf:condition step="approve-scope" outcome="approved" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://taskforce-project.fr/schema/process/1#condition">The scope is approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="go-ahead-stopped" name="Otherwise" sourceRef="go-ahead" targetRef="stopped" />
    <bpmn:sequenceFlow id="specify-break-down" sourceRef="specify" targetRef="break-down" />
    <bpmn:sequenceFlow id="break-down-build" sourceRef="break-down" targetRef="build" />
    <bpmn:sequenceFlow id="build-test" sourceRef="build" targetRef="test" />
    <bpmn:sequenceFlow id="test-review" sourceRef="test" targetRef="review" />
    <bpmn:sequenceFlow id="review-accept" sourceRef="review" targetRef="accept" />
    <bpmn:sequenceFlow id="accept-accepted" sourceRef="accept" targetRef="accepted" />
    <bpmn:sequenceFlow id="accepted-deliver" name="Yes" sourceRef="accepted" targetRef="deliver">
      <bpmn:extensionElements>
        <tf:condition step="sign-acceptance" outcome="approved" />
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://taskforce-project.fr/schema/process/1#condition">The acceptance is signed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="accepted-build" name="Otherwise" sourceRef="accepted" targetRef="build" />
    <bpmn:sequenceFlow id="deliver-delivered" sourceRef="deliver" targetRef="delivered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="integrate-a-module.diagram">
    <bpmndi:BPMNPlane id="integrate-a-module.plane" bpmnElement="integrate-a-module">
      <bpmndi:BPMNShape id="requested.di" bpmnElement="requested">

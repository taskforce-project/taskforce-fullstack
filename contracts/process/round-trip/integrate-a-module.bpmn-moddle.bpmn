        <di:waypoint x="1049" y="398" />
        <di:waypoint x="1049" y="298" />
        <di:waypoint x="1064" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="break-down.di" bpmnElement="break-down" isExpanded="true">
        <dc:Bounds x="1820" y="248" width="712" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="break-down-start.di" bpmnElement="break-down-start">
        <dc:Bounds x="1850" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="before-mission-breakdown.di" bpmnElement="before-mission-breakdown">
        <dc:Bounds x="1946" y="318" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="breakdown-zone.di" bpmnElement="breakdown-zone" isExpanded="true">
        <dc:Bounds x="2106" y="288" width="140" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split-into-issues.di" bpmnElement="split-into-issues">
        <dc:Bounds x="2126" y="328" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve-breakdown.di" bpmnElement="approve-breakdown">
        <dc:Bounds x="2306" y="318" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="break-down-end.di" bpmnElement="break-down-end">
        <dc:Bounds x="2466" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="break-down-start-before-mission-breakdown.di" bpmnElement="break-down-start-before-mission-breakdown">
        <di:waypoint x="1886" y="358" />
        <di:waypoint x="1946" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="before-mission-breakdown-breakdown-zone.di" bpmnElement="before-mission-breakdown-breakdown-zone">
        <di:waypoint x="2046" y="358" />
        <di:waypoint x="2106" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="breakdown-zone-approve-breakdown.di" bpmnElement="breakdown-zone-approve-breakdown">
        <di:waypoint x="2246" y="358" />
        <di:waypoint x="2306" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="approve-breakdown-break-down-end.di" bpmnElement="approve-breakdown-break-down-end">
        <di:waypoint x="2406" y="358" />
        <di:waypoint x="2466" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="build.di" bpmnElement="build" isExpanded="true">
        <dc:Bounds x="2592" y="100" width="669" height="507" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="build-start.di" bpmnElement="build-start">
        <dc:Bounds x="2622" y="292" width="36" height="36" />

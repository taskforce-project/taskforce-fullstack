{
  "format": "taskforce-mission-steps/1",
  "about": "The step a mission is at, one of understand, plan, do, check and handover, given its status, its timeline and its requests. The server computes it for the workflow view (MissionSteps), the screen for the work view (missionSequence, the step marked current): both replay these cases and must give the same step.",
  "cases": [
    { "name": "queued, nothing done yet", "status": "QUEUED", "events": [], "approvals": [], "step": "understand" },
    { "name": "started only", "status": "RUNNING", "events": [{ "kind": "start", "tool": null, "text": "Claude Code 2.1.312 started with claude-opus-5" }], "approvals": [], "step": "understand" },
    { "name": "a delivered mission hands over", "status": "DONE", "events": [{ "kind": "tool", "tool": "Edit", "text": "src/footer.tsx" }, { "kind": "text", "tool": null, "text": "Done: the footer links work." }], "approvals": [], "step": "handover" },
    { "name": "reading a file is understanding", "status": "RUNNING", "events": [{ "kind": "start", "tool": null, "text": "started" }, { "kind": "tool", "tool": "Read", "text": "README.md" }], "approvals": [], "step": "understand" },
    { "name": "editing a file is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "README.md" }, { "kind": "tool", "tool": "Edit", "text": "src/footer.tsx" }], "approvals": [], "step": "do" },
    { "name": "reading again after writing is still doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Write", "text": "notes.md" }, { "kind": "tool", "tool": "Grep", "text": "footer" }], "approvals": [], "step": "do" },
    { "name": "a todo list before writing is planning", "status": "RUNNING", "events": [{ "kind": "start", "tool": null, "text": "started" }, { "kind": "tool", "tool": "TodoWrite", "text": "{\"todos\":[]}" }], "approvals": [], "step": "plan" },
    { "name": "announcing the work after reading is planning", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "src/footer.tsx" }, { "kind": "text", "tool": null, "text": "The links point to the old domain. I'll update them to the new one." }], "approvals": [], "step": "plan" },
    { "name": "announcing only a look is still understanding", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "src/footer.tsx" }, { "kind": "text", "tool": null, "text": "I'll read the header next." }], "approvals": [], "step": "understand" },
    { "name": "announcing before reading anything is still understanding", "status": "RUNNING", "events": [{ "kind": "start", "tool": null, "text": "started" }, { "kind": "text", "tool": null, "text": "I will fix the footer links." }], "approvals": [], "step": "understand" },
    { "name": "an announcement in French counts", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Glob", "text": "**/*.tsx" }, { "kind": "text", "tool": null, "text": "Je vais corriger les liens du pied de page." }], "approvals": [], "step": "plan" },
    { "name": "a plan named as such counts", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "LS", "text": "src" }, { "kind": "text", "tool": null, "text": "My plan: rewrite the header, then test it." }], "approvals": [], "step": "plan" },
    { "name": "Markdown marks do not hide an announcement", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "src/footer.tsx" }, { "kind": "text", "tool": null, "text": "## Next\n**I'll** rewrite `footer.tsx` now." }], "approvals": [], "step": "plan" },
    { "name": "words after writing are doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "src/footer.tsx" }, { "kind": "text", "tool": null, "text": "Now posting the summary." }], "approvals": [], "step": "do" },
    { "name": "the project's tests are checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "src/footer.tsx" }, { "kind": "test", "tool": "npm test", "text": "Tests passed: 12 of 12" }], "approvals": [], "step": "check" },
    { "name": "npm test is checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "a.ts" }, { "kind": "tool", "tool": "Bash", "text": "npm test" }], "approvals": [], "step": "check" },
    { "name": "a lint script is checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "npm run lint" }], "approvals": [], "step": "check" },
    { "name": "a type check through npx is checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "npx tsc --noEmit" }], "approvals": [], "step": "check" },
    { "name": "pytest through python -m is checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "python -m pytest -q" }], "approvals": [], "step": "check" },
    { "name": "a commit is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "git add -A && git commit -m \"Fix the footer\"" }], "approvals": [], "step": "do" },
    { "name": "a redirect writes a file", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "echo hello > notes.txt" }], "approvals": [], "step": "do" },
    { "name": "a redirect to nowhere writes nothing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "ls src > /dev/null" }], "approvals": [], "step": "understand" },
    { "name": "sed in place edits", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "sed -i 's/old/new/' src/footer.tsx" }], "approvals": [], "step": "do" },
    { "name": "sed alone reads", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "sed -n 1,20p src/footer.tsx" }], "approvals": [], "step": "understand" },
    { "name": "an install neither reads nor changes", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "npm install" }], "approvals": [], "step": "understand" },
    { "name": "of several commands, the tests win", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "cd frontend && npx vitest run lib" }], "approvals": [], "step": "check" },
    { "name": "a separator inside quotes does not split the line", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "echo \"a && rm -rf build\"" }], "approvals": [], "step": "understand" },
    { "name": "an assignment before the program is skipped", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "CI=1 npx vitest run" }], "approvals": [], "step": "check" },
    { "name": "a new branch is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "git checkout -b tf/web-12" }], "approvals": [], "step": "do" },
    { "name": "switching branch is neither", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "git checkout main" }], "approvals": [], "step": "understand" },
    { "name": "git status reads", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "git status --short" }], "approvals": [], "step": "understand" },
    { "name": "opening a pull request is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "gh pr create --fill" }], "approvals": [], "step": "do" },
    { "name": "a program path with its extension, quoted", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "\"C:\\Program Files\\nodejs\\npm.cmd\" test" }], "approvals": [], "step": "check" },
    { "name": "maven verify is checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "mvn -q verify" }], "approvals": [], "step": "check" },
    { "name": "make build is neither", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "make build" }], "approvals": [], "step": "understand" },
    { "name": "an unknown program is neither", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "terraform plan" }], "approvals": [], "step": "understand" },
    { "name": "removing a file is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "rm -rf build" }], "approvals": [], "step": "do" },
    { "name": "touching a file is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Bash", "text": "touch src/new.ts" }], "approvals": [], "step": "do" },
    { "name": "a TaskForce tool that reads", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "taskforce: get_issue", "text": "{\"projectId\":6,\"issueId\":308}" }], "approvals": [], "step": "understand" },
    { "name": "a TaskForce tool that changes", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "taskforce: add_comment", "text": "{\"content\":\"Done\"}" }], "approvals": [], "step": "do" },
    { "name": "an unknown TaskForce tool is neither", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "taskforce: something_new", "text": "{}" }], "approvals": [], "step": "understand" },
    { "name": "a connector tool that creates", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "linear: create_issue", "text": "{}" }], "approvals": [], "step": "do" },
    { "name": "a connector tool that searches", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "notion: search_pages", "text": "{}" }], "approvals": [], "step": "understand" },
    { "name": "a refused change stays where the change was", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }, { "kind": "denied", "tool": "Edit", "text": "The rules refuse this edit." }], "approvals": [], "step": "do" },
    { "name": "an error stays on the step before", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "a.ts" }, { "kind": "error", "tool": null, "text": "Exit code 1" }], "approvals": [], "step": "do" },
    { "name": "a limit stays on the step before", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }, { "kind": "limit", "tool": null, "text": "The runner sent 10000 events for this run." }], "approvals": [], "step": "understand" },
    { "name": "an exit hands over", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "a.ts" }, { "kind": "exit", "tool": "git push", "text": "allowed by the rule push-agent-branch-private" }], "approvals": [], "step": "handover" },
    { "name": "a pending request to run the tests is checking", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "a.ts" }], "approvals": [{ "tool": "Run the project's tests", "summary": "npm test", "status": "PENDING" }], "step": "check" },
    { "name": "a pending push is handing over", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }], "approvals": [{ "tool": "git push", "summary": "Push the branch tf/web-12", "status": "PENDING" }], "step": "handover" },
    { "name": "a pending start is understanding", "status": "RUNNING", "events": [], "approvals": [{ "tool": "Start the mission", "summary": "Claude Code on WEB-12", "status": "PENDING" }], "step": "understand" },
    { "name": "a pending request of the agent goes where its action goes", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }], "approvals": [{ "tool": "Bash", "summary": "rm -rf build", "status": "PENDING" }], "step": "do" },
    { "name": "a pending read after writing is doing", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Edit", "text": "a.ts" }], "approvals": [{ "tool": "WebSearch", "summary": "electron-updater progress", "status": "PENDING" }], "step": "do" },
    { "name": "an answered request does not count", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }], "approvals": [{ "tool": "git push", "summary": "Push", "status": "ALLOWED" }], "step": "understand" },
    { "name": "the oldest pending request counts", "status": "RUNNING", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }], "approvals": [{ "tool": "git push", "summary": "Push", "status": "DENIED" }, { "tool": "Run the project's tests", "summary": "npm test", "status": "PENDING" }, { "tool": "git push", "summary": "Push", "status": "PENDING" }], "step": "check" },
    { "name": "a failed mission stays where it stopped", "status": "FAILED", "events": [{ "kind": "tool", "tool": "Edit", "text": "a.ts" }, { "kind": "tool", "tool": "Bash", "text": "npm test" }], "approvals": [], "step": "check" },
    { "name": "a failed mission's requests no longer count", "status": "FAILED", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }], "approvals": [{ "tool": "git push", "summary": "Push", "status": "PENDING" }], "step": "understand" },
    { "name": "a mission stopped while planning", "status": "FAILED", "events": [{ "kind": "tool", "tool": "Read", "text": "a.ts" }, { "kind": "tool", "tool": "TodoWrite", "text": "{}" }], "approvals": [], "step": "plan" }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskforce-project.fr/contracts/taskforce-evidence-1.schema.json",
  "title": "TaskForce evidence file, version 1",
  "description": "The chained journal of one mission: who asked, which agent acted, on which sources, under which rules, who decided, what left the sandbox. Each event is chained to the previous one (see contracts/README.md); the header comes from the chain; an exported file is checked without TaskForce by recomputing the hashes, the header, the texts kept beside the chain, the decisions judged again with the rules bundle, and the seal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "mission", "events", "root"],
  "properties": {
    "format": { "const": "taskforce-evidence/1" },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace", "requestedBy", "agent", "rules"],
      "properties": {
        "id": { "type": "integer" },
        "workspace": { "type": "string" },
        "project": { "type": ["integer", "null"] },
        "issue": { "type": ["string", "null"], "description": "The issue key, for example WEB-48." },
        "requestedBy": { "type": "string", "description": "The person who delegated." },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["claude-code", "internal", "codex", "cursor", "gemini", "copilot"] },
            "version": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "digest"],
          "properties": {
            "version": { "type": "integer" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "runner": { "type": ["string", "null"] },
        "taskforce": { "type": ["string", "null"] }
      }
    },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
    "root": { "$ref": "#/$defs/hash" },
    "rules": {
      "type": "object",
      "description": "The rules bundle as the mission received it (taskforce-rules/1): its digest is the one mission.started holds, so a third party judges each decision again."
    },
    "texts": {
      "type": "object",
      "description": "The texts kept beside the chain, by their hash: the chain holds only their sha256 and length. An erased text is absent.",
      "propertyNames": { "pattern": "^sha256:[0-9a-f]{64}$" },
      "additionalProperties": { "type": "string" }
    },
    "seal": { "$ref": "#/$defs/envelope" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "envelope": {
      "type": "object",
      "description": "The last seal: a DSSE envelope of an in-toto Statement v1, signed in Ed25519 (contracts/README.md, Seal).",
      "required": ["payload", "payloadType", "signatures"],
      "properties": {
        "payload": { "type": "string", "description": "The canonical JSON of the statement, in base64." },
        "payloadType": { "const": "application/vnd.in-toto+json" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["keyid", "sig"],
            "properties": {
              "keyid": { "$ref": "#/$defs/hash" },
              "sig": { "type": "string", "description": "The Ed25519 signature of the DSSE pre-authentication encoding, in base64." }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "at", "type", "actor", "data", "prev", "hash"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "at": { "type": "string", "format": "date-time" },
        "type": {
          "enum": [
            "mission.started", "mission.ended",
            "action.requested", "action.decided", "action.result",
            "source.read", "test.result",
            "exit.intent", "exit.result",
            "human.decision", "limit.reached", "note"
          ]
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["agent", "person", "rule", "runner", "server"] },
            "id": { "type": "string" }
          }
        },
        "data": { "type": "object", "description": "Integers, strings, booleans, null, arrays and objects only: no decimal numbers." },
        "prev": { "$ref": "#/$defs/hash" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

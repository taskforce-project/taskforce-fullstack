# ─ Serveur MCP TaskForce — configuration ──────────────────────────────────────
# API TaskForce (backend Spring). En Docker dev, exposé sur localhost:8080.
TASKFORCE_API_URL=http://localhost:8080/api
# Workspace par défaut (les tools acceptent un param `workspace` pour surcharger).
TASKFORCE_WORKSPACE=taskforce-demo
TASKFORCE_TIMEOUT_MS=200000

# ─ Auth ───────────────────────────────────────────────────────────────────────
# Option A : token Bearer déjà obtenu (prioritaire, court-circuite Keycloak).
# TASKFORCE_TOKEN=eyJhbGciOi...

# Option B (dev) : password grant Keycloak. En dev l'issuer est `keycloak:8080`
# alors que Keycloak est exposé sur localhost:8180 → on force l'en-tête Host.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_HOST_HEADER=keycloak:8080
KEYCLOAK_REALM=taskforce-dev
KEYCLOAK_CLIENT_ID=taskforce-api
KEYCLOAK_CLIENT_SECRET=__depuis_.env.dev__
TASKFORCE_USERNAME=admin@taskforce.dev
TASKFORCE_PASSWORD=Admin@2024

# ─ Transport HTTP (remote/SaaS — `npm run start:http`) ────────────────────────
# Ignoré en stdio (`npm start`). Binder sur localhost par défaut (derrière reverse proxy en prod).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Origines navigateur autorisées (anti DNS-rebinding), séparées par des virgules. Vide = pas de
# filtre (les clients non-navigateur comme Claude Desktop n'envoient pas d'Origin, toujours OK).
# MCP_HTTP_ALLOWED_ORIGINS=https://claude.ai
# Auth HTTP : si ni TASKFORCE_TOKEN ni (KEYCLOAK_CLIENT_SECRET+TASKFORCE_PASSWORD) ne sont définis,
# le pass-through est OBLIGATOIRE → chaque client doit présenter `Authorization: Bearer <token>`.

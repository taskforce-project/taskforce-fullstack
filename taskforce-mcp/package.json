{
  "name": "taskforce-mcp",
  "version": "0.2.0",
  "description": "Serveur MCP exposant TaskForce (Brain OS + projets + agent Cortex) à Claude et à tout client MCP. TaskForce comme étape de réflexion/process avant d'agir.",
  "type": "module",
  "bin": {
    "taskforce-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "verify": "tsx src/verify.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

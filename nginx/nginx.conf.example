# ===============================
# NGINX — REVERSE PROXY DE PRODUCTION
# ===============================
# ⚠️ ÉTAPE OBLIGATOIRE : copier ce fichier en `nginx/nginx.conf`.
#     cp nginx/nginx.conf.example nginx/nginx.conf
#     mkdir -p nginx/ssl
# Le compose monte `./nginx/nginx.conf` et `./nginx/ssl`. Si ces chemins n'existent pas, Docker crée
# des RÉPERTOIRES vides à leur place et nginx refuse de démarrer — sans message explicite.
#
# Remplacer ensuite les noms de domaine :
#   app.example.com    → frontend Next.js (l'application)
#   api.example.com    → backend Spring Boot
#   auth.example.com   → Keycloak
#   files.example.com  → MinIO (URL présignées des pièces jointes)
#   www.example.com    → landing page Astro
#
# Ils doivent rester cohérents avec `.env.prod` :
#   PUBLIC_API_URL        = https://api.example.com
#   MINIO_PUBLIC_ENDPOINT = https://files.example.com
#   KEYCLOAK_HOSTNAME     = auth.example.com
#   CORS_ALLOWED_ORIGINS  = https://app.example.com,https://www.example.com
#
# ⚠️ `PUBLIC_API_URL` et `MINIO_PUBLIC_ENDPOINT` sont figées au BUILD de l'image frontend :
# les modifier impose `docker compose build frontend`, pas un simple redémarrage.
#
# Certificats attendus dans ./nginx/ssl/ : fullchain.pem, privkey.pem
# (Certbot/Let's Encrypt via le challenge ACME déclaré plus bas.)
# ===============================

events {
    worker_connections 1024;
}

http {
    # Ne pas annoncer la version de nginx : réduit le ciblage automatisé.
    server_tokens off;

    client_max_body_size 20M;
    # Empêche un client lent d'immobiliser un worker (Slowloris).
    client_body_timeout 15s;
    client_header_timeout 15s;

    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_http_version 1.1;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;

    proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=api_cache:10m max_size=100m inactive=60m;

    # ── Résolution DNS différée ──────────────────────────────────────────────
    # 127.0.0.11 = résolveur interne de Docker. Indispensable : avec un `proxy_pass` littéral
    # (`http://frontend:3000`), nginx résout le nom AU DÉMARRAGE et refuse de démarrer si un seul
    # amont est absent — un frontend en cours de redémarrage suffirait alors à empêcher nginx de
    # monter, et donc à faire tomber TOUT le site, pas seulement ce service.
    # En passant par une variable, la résolution a lieu à chaque requête : le service indisponible
    # renvoie 502, les autres continuent de répondre.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # ── Garde-fous de débit ──────────────────────────────────────────────────
    # Le backend a déjà bucket4j (par utilisateur, partagé via Redis). Ceci est la couche AVANT :
    # elle protège ce que bucket4j ne voit pas — la poignée de main TLS, Keycloak, et le backend
    # lui-même face à une rafale non authentifiée.
    limit_req_zone $binary_remote_addr zone=api_zone:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=5r/s;
    limit_req_status 429;
    limit_conn_zone $binary_remote_addr zone=conn_zone:10m;

    # HSTS. Absent de la version précédente : sans lui, la toute première visite en http:// reste
    # interceptable malgré la redirection 301.
    # `X-XSS-Protection` est volontairement ABSENT : obsolète, et son filtrage heuristique a
    # lui-même introduit des vulnérabilités. La CSP le remplace.
    map $host $hsts {
        default "max-age=31536000; includeSubDomains; preload";
    }

    # ── Réglages TLS partagés ────────────────────────────────────────────────
    ssl_protocols TLSv1.2 TLSv1.3;
    # Suites modernes explicites : `HIGH:!aNULL:!MD5` laissait passer du CBC et du SHA-1.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # ================================
    # HTTP -> HTTPS (+ challenge ACME)
    # ================================
    server {
        listen 80;
        server_name app.example.com api.example.com auth.example.com files.example.com www.example.com example.com;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ================================
    # HTTPS — Application (Next.js)
    # ================================
    server {
        listen 443 ssl;
        http2 on;
        server_name app.example.com;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        add_header Strict-Transport-Security $hsts always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        # Pas de CSP ici : Next.js pose la sienne (next.config.ts), bâtie avec les bonnes origines
        # d'API et de stockage. En ajouter une seconde ferait appliquer l'INTERSECTION des deux par
        # le navigateur — la plus permissive ne l'emporte jamais, et on casserait l'application.

        limit_conn conn_zone 20;

        location / {
            set $up_frontend frontend:3000;
            proxy_pass http://$up_frontend;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        access_log /var/log/nginx/app.access.log;
        error_log  /var/log/nginx/app.error.log;
    }

    # ================================
    # HTTPS — API (Spring Boot)
    # ================================
    server {
        listen 443 ssl;
        http2 on;
        server_name api.example.com;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        # Le backend pose déjà HSTS/nosniff/frame-deny/CSP/referrer/permissions (SecurityConfig,
        # couvert par SecurityHeadersWebMvcTest). On ne redouble QUE HSTS, pour couvrir les réponses
        # d'erreur produites par nginx lui-même, avant d'avoir atteint l'application.
        add_header Strict-Transport-Security $hsts always;

        limit_conn conn_zone 20;

        location /api/ {
            limit_req zone=api_zone burst=40 nodelay;

            set $up_backend backend:8080;
            proxy_pass http://$up_backend;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $host;
            proxy_set_header X-Forwarded-Port  $server_port;

            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
        }

        # Sonde de vie : ni cache, ni limitation de débit — sinon le healthcheck finit par être
        # rejeté en 429 et le conteneur est déclaré malsain.
        location = /api/actuator/health {
            set $up_backend backend:8080;
            proxy_pass http://$up_backend;
            proxy_set_header Host $host;
            access_log off;
        }

        # Le reste d'actuator (métriques, env, beans, mappings) ne doit JAMAIS être public.
        location /api/actuator/ {
            return 404;
        }

        # Temps réel STOMP/SockJS : exige la bascule WebSocket et un timeout long, sinon la
        # connexion est coupée toutes les 60 s.
        location /ws {
            set $up_backend backend:8080;
            proxy_pass http://$up_backend;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        "upgrade";
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
        }

        location /ws-sockjs {
            set $up_backend backend:8080;
            proxy_pass http://$up_backend;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        "upgrade";
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
        }

        access_log /var/log/nginx/api.access.log;
        error_log  /var/log/nginx/api.error.log;
    }

    # ================================
    # HTTPS — Keycloak
    # ================================
    server {
        listen 443 ssl;
        http2 on;
        server_name auth.example.com;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        add_header Strict-Transport-Security $hsts always;
        add_header X-Content-Type-Options "nosniff" always;

        limit_conn conn_zone 10;

        location / {
            # Débit plus serré : c'est la surface de bourrage d'identifiants.
            limit_req zone=auth_zone burst=10 nodelay;

            set $up_keycloak keycloak:8080;
            proxy_pass http://$up_keycloak;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Requis par KC_PROXY=edge pour reconstruire les URL publiques.
            proxy_set_header X-Forwarded-Host  $host;
            proxy_set_header X-Forwarded-Port  443;
            proxy_buffering off;
        }

        # La console d'administration n'a rien à faire sur Internet. La rouvrir revient à exposer la
        # gestion de tous les comptes : préférer un tunnel privé ou une restriction par IP.
        location /admin/ {
            return 404;
        }

        access_log /var/log/nginx/auth.access.log;
        error_log  /var/log/nginx/auth.error.log;
    }

    # ================================
    # HTTPS — Stockage objet (MinIO)
    # ================================
    server {
        listen 443 ssl;
        http2 on;
        server_name files.example.com;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        add_header Strict-Transport-Security $hsts always;
        # Décisif ici : sans `nosniff`, une pièce jointe HTML déposée par un utilisateur serait
        # interprétée par le navigateur et s'exécuterait sur ce domaine.
        add_header X-Content-Type-Options "nosniff" always;

        location / {
            set $up_minio minio:9000;
            proxy_pass http://$up_minio;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Les URL présignées portent une signature calculée sur l'hôte : réécrire l'en-tête Host
            # l'invaliderait et toutes les pièces jointes retourneraient 403.
            proxy_buffering off;
            client_max_body_size 20M;
        }

        # Console d'administration MinIO (port 9001) délibérément NON exposée.

        access_log /var/log/nginx/files.access.log;
        error_log  /var/log/nginx/files.error.log;
    }

    # ================================
    # HTTPS — Landing (Astro)
    # ================================
    server {
        listen 443 ssl;
        http2 on;
        server_name www.example.com example.com;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        add_header Strict-Transport-Security $hsts always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;

        location / {
            set $up_landing landing:4321;
            proxy_pass http://$up_landing;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        access_log /var/log/nginx/landing.access.log;
        error_log  /var/log/nginx/landing.error.log;
    }

    # ================================
    # Hôte par défaut — tout domaine non déclaré
    # ================================
    # Sans ce bloc, nginx sert le PREMIER server{} à quiconque frappe l'IP nue : l'application
    # devient accessible hors de son domaine et les scanners l'indexent.
    server {
        listen 80  default_server;
        listen 443 ssl default_server;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;

        # Sonde interne du conteneur (healthcheck du compose).
        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location / {
            return 444;  # fermeture de connexion sans réponse
        }
    }
}

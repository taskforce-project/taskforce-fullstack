# Copier en `.env` sur la VM2 et renseigner un mot de passe fort (généré, pas réutilisé).
# Grafana refuse de démarrer sans GRAFANA_ADMIN_PASSWORD (garde-fou volontaire).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Datasource PostgreSQL (métriques produit) ---------------------------------
# Grafana lit les vues `metrics.*` via le relais socat de la VM1 (Tailscale only).
# Le mot de passe = celui du rôle `grafana_ro` créé par monitoring/vm1/metrics/grafana-metrics.sql.
# GRAFANA_PG_DB doit valoir le POSTGRES_DB de .env.prod (VM1).
GRAFANA_PG_HOST=100.122.50.25:9102
GRAFANA_PG_DB=taskforce
GRAFANA_PG_USER=grafana_ro
GRAFANA_PG_PASSWORD=

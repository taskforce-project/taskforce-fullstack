# ==============================================
# CONFIGURATION ENVIRONNEMENT - TASKFORCE
# Copiez ce fichier en .env.dev et remplissez les valeurs
# NE JAMAIS committer un fichier .env avec des secrets réels
# ==============================================

# ==============================================
# BASE DE DONNÉES POSTGRESQL
# ==============================================
POSTGRES_DB=taskforce-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
POSTGRES_IMAGE=pgvector/pgvector:pg18

# ==============================================
# BACKEND - SPRING BOOT
# ==============================================
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================
# FRONTEND - NEXT.JS
# ==============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Site vitrine (Astro) : autre projet, autre origine. Cible du logo et de « Retour au site » sur les
# pages d'authentification — sans cela, le lien renvoyait au tableau de bord de l'application.
# Mettre 4321 si le serveur Astro est lancé à la main, LANDING_PORT (18081) si c'est le conteneur.
SITE_PUBLIC_URL=http://localhost:4321

# ==============================================
# LANDING PAGE - ASTRO
# ==============================================
LANDING_PORT=18081

# ==============================================
# IA INTERNE (service Python)
# ==============================================
AI_SERVICE_URL=http://localhost:8000
# Provider CHAT : laisser GROQ_API_KEY VIDE = Ollama local (défaut). Renseigner une clé (console.groq.com)
# = bascule auto du chat sur Groq (hébergé, pour VM sans compute local). Embeddings toujours sur Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
# Plafonds IA (facultatifs, 0 = désactivé, c'est le défaut). À régler si le CHAT passe par une API
# payante (Groq, OpenAI...) : plafond mensuel de tokens par compte, et débit par minute (tokens pour
# toute l'instance, tokens et requêtes par compte).
AI_MONTHLY_TOKENS_PER_ACCOUNT=0
AI_RATE_GLOBAL_TPM=0
AI_RATE_ACCOUNT_TPM=0
AI_RATE_ACCOUNT_RPM=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_SERVICE_LOG_LEVEL=INFO

# ==============================================
# KEYCLOAK - AUTHENTIFICATION / OIDC
# ==============================================
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=taskforce-dev
KEYCLOAK_CLIENT_ID=taskforce-api
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
# URI public (visible dans les tokens navigateur)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/taskforce-dev
# URI interne (backend Docker → keycloak container)
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/taskforce-dev/protocol/openid-connect/certs

# ==============================================
# EMAIL - MAILTRAP (développement)
# Créer un compte sur https://mailtrap.io
# ==============================================
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@taskforce.dev
MAIL_FROM_NAME=TaskForce Dev

# ==============================================
# MINIO - STOCKAGE OBJET S3-COMPATIBLE
# Console: http://localhost:9001
# ==============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=taskforce-attachments

# ==============================================
# PGADMIN (Développement uniquement)
# ==============================================
PGADMIN_EMAIL=admin@taskforce.local
PGADMIN_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050

# ==============================================
# OBSERVABILITÉ - SIGNOZ (profil: observability)
# UI: http://localhost:3301
# ==============================================
SIGNOZ_JWT_SECRET=change-me-signoz-secret-for-prod
# Mettre à false pour activer l'export OTel depuis backend/frontend
OTEL_SDK_DISABLED=true

# ==============================================
# INTÉGRATIONS OAUTH
# ==============================================

# GitHub OAuth App
# Créer sur https://github.com/settings/applications/new
# Callback URL: http://localhost:8080/api/integrations/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Slack App
# Créer sur https://api.slack.com/apps
# Redirect URL: http://localhost:8080/api/integrations/slack/callback
SLACK_CLIENT_ID=your_slack_oauth_client_id
SLACK_CLIENT_SECRET=your_slack_oauth_client_secret

# ==============================================
# RABBITMQ - BROKER WEBSOCKET / STOMP
# ==============================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_STOMP_PORT=61613

# ==============================================
# APPLICATION
# ==============================================
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ==============================================
# NGINX (Production uniquement)
# ==============================================
HTTP_PORT=80
HTTPS_PORT=443

# ==============================================
# ENVIRONNEMENT
# ==============================================
ENVIRONMENT=dev
TZ=UTC

# ==============================================
# MESURE D'AUDIENCE — Umami (CERT-C20)
# ==============================================
# Umami est auto-hébergé et sans cookie : aucun transfert hors UE, aucun consentement à recueillir.
# C'est la raison du choix, cf. docker-compose.dev.yml (service `umami`).
#
# Console : http://localhost:3001 (identifiants initiaux : admin / umami, à changer au 1er accès).
# Le WEBSITE_ID est généré par Umami à la création du site ; il est public par conception.
#
# Laisser ces deux variables VIDES en développement : sans elles, aucun script n'est injecté, et
# les builds locaux comme les audits Lighthouse ne polluent pas les statistiques.
UMAMI_PORT=3001
UMAMI_APP_SECRET=
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=

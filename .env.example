# ==============================================
# CONFIGURATION ENVIRONNEMENT - TASKFORCE
# Copiez ce fichier en .env.dev et remplissez les valeurs
# NE JAMAIS committer un fichier .env avec des secrets réels
# ==============================================

# ==============================================
# BASE DE DONNÉES POSTGRESQL
# ==============================================
POSTGRES_DB=taskforce-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
POSTGRES_IMAGE=pgvector/pgvector:pg18

# ==============================================
# BACKEND - SPRING BOOT
# ==============================================
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Secret — minimum 256 bits (32 caractères), HS512
JWT_SECRET=change-me-super-secret-jwt-key-minimum-256-bits-for-hs512

# ==============================================
# FRONTEND - NEXT.JS
# ==============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==============================================
# LANDING PAGE - ASTRO
# ==============================================
LANDING_PORT=18081

# ==============================================
# IA INTERNE (service Python)
# ==============================================
AI_SERVICE_URL=http://localhost:8000
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_SMART_ASSIGN_MODEL=llama-3.1-8b-instant
GROQ_ASSISTANT_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_SERVICE_LOG_LEVEL=INFO

# ==============================================
# KEYCLOAK - AUTHENTIFICATION / OIDC
# ==============================================
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=taskforce-dev
KEYCLOAK_CLIENT_ID=taskforce-api
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
# URI public (visible dans les tokens navigateur)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/taskforce-dev
# URI interne (backend Docker → keycloak container)
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/taskforce-dev/protocol/openid-connect/certs

# ==============================================
# STRIPE - PAIEMENT
# ==============================================
# Clés API Stripe (Mode Test: pk_test_... / Mode Live: pk_live_...)
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs (commence par price_...)
# Prix récurrents PAR SIÈGE (par membre/mois) — cf. docs/STRIPE_SETUP.md
STRIPE_PRICE_ID_BASIC=price_your_basic_plan_id_here
STRIPE_PRICE_ID_BUSINESS=price_your_business_plan_id_here
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_plan_id_here

# URLs de redirection après paiement
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# ==============================================
# EMAIL - MAILTRAP (développement)
# Créer un compte sur https://mailtrap.io
# ==============================================
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@taskforce.dev
MAIL_FROM_NAME=TaskForce Dev

# ==============================================
# MINIO - STOCKAGE OBJET S3-COMPATIBLE
# Console: http://localhost:9001
# ==============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=taskforce-attachments

# ==============================================
# PGADMIN (Développement uniquement)
# ==============================================
PGADMIN_EMAIL=admin@taskforce.local
PGADMIN_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050

# ==============================================
# OBSERVABILITÉ - SIGNOZ (profil: observability)
# UI: http://localhost:3301
# ==============================================
SIGNOZ_JWT_SECRET=change-me-signoz-secret-for-prod
# Mettre à false pour activer l'export OTel depuis backend/frontend
OTEL_SDK_DISABLED=true

# ==============================================
# INTÉGRATIONS OAUTH
# ==============================================

# GitHub OAuth App
# Créer sur https://github.com/settings/applications/new
# Callback URL: http://localhost:8080/api/integrations/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Slack App
# Créer sur https://api.slack.com/apps
# Redirect URL: http://localhost:8080/api/integrations/slack/callback
SLACK_CLIENT_ID=your_slack_oauth_client_id
SLACK_CLIENT_SECRET=your_slack_oauth_client_secret

# ==============================================
# RABBITMQ - BROKER WEBSOCKET / STOMP
# ==============================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_STOMP_PORT=61613

# ==============================================
# APPLICATION
# ==============================================
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ==============================================
# NGINX (Production uniquement)
# ==============================================
HTTP_PORT=80
HTTPS_PORT=443

# ==============================================
# ENVIRONNEMENT
# ==============================================
ENVIRONMENT=dev
TZ=UTC

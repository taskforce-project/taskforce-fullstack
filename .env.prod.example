# ===============================
# VARIABLES DE PRODUCTION — GABARIT
# ===============================
# Copier en `.env.prod` (ignoré par git) et renseigner les valeurs réelles :
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# ⚠️ `docker compose config` sort 0 même avec des variables VIDES (cf. TF-INFRA-011) : sa réussite
# ne prouve donc rien. Toute valeur laissée vide ci-dessous passera la validation et cassera au
# démarrage, ou pire, silencieusement à l'exécution.
#
# Aucun secret réel ne doit être commité (règle d'or n°8).

# ── Base de données ──────────────────────────────────────────────────────────
# L'image DOIT embarquer pgvector : les migrations déclarent des colonnes `vector(384)`.
POSTGRES_IMAGE=pgvector/pgvector:pg18
DB_NAME=taskforce
DB_USER=taskforce
DB_PASSWORD=

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# ⚠️ DOIVENT correspondre au realm importé (keycloak/realms/prod/taskforce-prod-realm.json).
KEYCLOAK_REALM=taskforce-prod
KEYCLOAK_CLIENT_ID=taskforce-api
KEYCLOAK_CLIENT_SECRET=
# Nom d'hôte public de Keycloak, sans schéma (KC_HOSTNAME).
KEYCLOAK_HOSTNAME=auth.example.com
# Issuer tel qu'il figure dans les jetons reçus du navigateur. Doit correspondre EXACTEMENT à
# l'URL publique, sinon la validation JWT échoue (piège déjà rencontré en dev : `keycloak:8080`
# côté réseau Docker vs `localhost:8180` côté navigateur).
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/taskforce-prod

# ── URL publiques ────────────────────────────────────────────────────────────
# DOMAINE DE BASE — le seul « bouton » à changer pour basculer tout le déploiement sur un autre
# domaine. « Préfixe (sous-domaine) dans le code, suffixe (domaine) ici. » Le FRONTEND en dérive ses
# origines — api.<base> / files.<base> / <base> (site) — via ses build.args et `lib/config/urls.ts` ;
# sur la VM frontend, le compose compose les NEXT_PUBLIC_* à partir de lui (un seul knob à rebuild).
# Les variables discrètes ci-dessous (backend + overrides explicites) doivent rester cohérentes.
BASE_DOMAIN=example.com
#
# Consommée au BUILD du frontend (NEXT_PUBLIC_API_URL) : changer cette valeur impose de reconstruire
# l'image frontend, pas seulement de la redémarrer.
PUBLIC_API_URL=https://api.example.com
# Site vitrine (projet Astro), servi sur une AUTRE origine que l'application : www.<domaine> face à
# app.<domaine>. Cible du logo et du bouton « Retour au site » des pages d'authentification.
# Également consommée au BUILD du frontend (NEXT_PUBLIC_SITE_URL) — même contrainte de reconstruction.
SITE_PUBLIC_URL=https://www.example.com
# Origines autorisées par le CORS du backend (séparées par des virgules).
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# URLs applicatives lues par le backend AU BOOT (app.url / frontend-url / api-url) ET utilisées pour
# substituer les redirectUris/webOrigins du realm Keycloak importé. APP_URL/FRONTEND_URL = l'application
# (app.<domaine>) ; API_URL = le backend public (= PUBLIC_API_URL).
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
API_URL=https://api.example.com
APP_API_URL=https://api.example.com

# ── Stockage objet (MinIO) ───────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=taskforce-attachments
MINIO_REGION=us-east-1
# Hôte qui SIGNE les URL présignées : il doit être joignable depuis le navigateur des utilisateurs.
# Sert aussi au build du frontend (NEXT_PUBLIC_STORAGE_URL) et à la CSP `img-src`/`connect-src`.
MINIO_PUBLIC_ENDPOINT=https://files.example.com

# ── Email transactionnel (OTP, invitations, réinitialisation) ────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=TaskForce
# Adresse qui reçoit les retours « Give feedback » (défaut : feedback@taskforce.dev)
FEEDBACK_NOTIFY_EMAIL=

# ── Paiement (Stripe) ────────────────────────────────────────────────────────
# À renseigner directement dans `.env.prod`, jamais ici.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Chiffrement au repos des données personnelles (RGPD) ─────────────────────
# OBLIGATOIRE : sans elle, le backend REFUSE de démarrer (aucune valeur par défaut en prod).
# C'est délibéré — une clé absente désactiverait le chiffrement en silence.
#
# Phrase secrète longue et aléatoire, PAS une clé base64 : la clé AES-256 est dérivée par
# SHA-256 de cette valeur (cf. EncryptedStringConverter.configure). Toute chaîne convient,
# sa longueur et son entropie font la sécurité.
#
# Sa PERTE rend les données chiffrées irrécupérables : la sauvegarder hors du serveur, au même
# titre que les dumps de base. La CHANGER rend illisible tout ce qui a été chiffré avant.
#
# Colonnes concernées : connector_connections.config, integrations.access_token,
# enterprise_inquiries.message, enterprise_inquiries.notes.
TF_ENCRYPTION_KEY=

# ── Anti-robot à l'inscription — DEUX rideaux indépendants ────────────────────
# 1) Défi signé maison : aucune dépendance externe. Phrase secrète longue et aléatoire.
#    Vide = inactif. Filtre les soumissions instantanées et les jetons non émis par nous.
TF_HUMAN_CHALLENGE_SECRET=
# 2) Cloudflare Turnstile : juge le visiteur (empreinte navigateur, réputation).
#    Clés à créer sur https://dash.cloudflare.com → Turnstile → Add widget.
#    La clé de SITE est publique (servie au navigateur) ; la clé SECRÈTE ne sort jamais du serveur.
#    Vides = inactif, aucun widget affiché.
#    ⚠️ RGPD : Turnstile reçoit l'ADRESSE IP des visiteurs. C'est un sous-traitant, à inscrire au
#    registre des traitements. Il ne pose aucun cookie et ne pratique pas de suivi inter-sites.
TF_TURNSTILE_SITE_KEY=
TF_TURNSTILE_SECRET_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Ollama n'est PAS hébergé par ce compose : les modèles pèsent ~15,7 Go et exigeraient ~24 Gio de
# RAM et un GPU pour des temps de réponse acceptables. Pointer ici une machine dédiée ou un service
# managé exposant l'API Ollama.
# ── CHAT via Groq (hébergé, OpenAI-compatible) — RECOMMANDÉ pour une petite VM (zéro compute local). ──
# Si GROQ_API_KEY est renseignée, l'ai-service route le CHAT vers Groq ; sinon Ollama local. Clé sur
# console.groq.com. ⚠️ Groq est derrière Cloudflare qui bloque l'UA `Python-urllib` (403) — l'ai-service
# envoie un User-Agent applicatif (cf. ollama_gateway.py). Les EMBEDDINGS restent TOUJOURS sur Ollama.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# EMBEDDINGS Ollama : sans Ollama (VM 4 Go), pointer un hôte qui refuse vite → repli lexical immédiat.
# Avec Ollama auto-hébergé, pointer la machine dédiée exposant l'API Ollama.
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_MODEL_FAST=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=300
# GROQ_API_KEY / GROQ_MODEL retirés le 24/07/2026. Groq a été sorti du code le 16/07 : plus aucune
# propriété ne les lit, ni côté backend ni côté ai-service. Le « secours cloud » qu'ils annonçaient
# n'existe pas. Toute l'inférence passe par Ollama auto-hébergé : aucun contenu de travail ne quitte
# l'infrastructure, ce qui est l'argument central du registre des traitements RGPD.

# ── Divers ───────────────────────────────────────────────────────────────────
AI_SERVICE_LOG_LEVEL=INFO

# ── Mesure d'audience (Umami, CERT-C20) ──────────────────────────────────────
# Auto-hébergé et sans cookie : aucun transfert hors UE, aucun bandeau de consentement requis.
# APP_SECRET signe les sessions de la console : générer une valeur aléatoire longue, ne pas réutiliser.
UMAMI_APP_SECRET=
# Consommées au BUILD de la landing : les changer impose de reconstruire l'image.
PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=

{
  "format": "taskforce-rules/1",
  "workspace": "template",
  "project": null,
  "version": 1,
  "rules": [
    { "id": "read-files", "when": { "action": "file.read" }, "class": "read", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Reading leaves a trace and changes nothing (R7').", "review": "2027-01-31" },
    { "id": "search-files", "when": { "action": "file.search" }, "class": "read", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Searching leaves a trace and changes nothing (R7').", "review": "2027-01-31" },
    { "id": "read-issues", "when": { "action": "issue.read" }, "class": "read", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Reading leaves a trace and changes nothing (R7').", "review": "2027-01-31" },
    { "id": "search-knowledge", "when": { "action": "knowledge.search" }, "class": "read", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "The search itself filters what this agent may read (sensitivity, rights).", "review": "2027-01-31" },
    { "id": "search-web", "when": { "action": "web.search" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A web search sends its query out of the machine, where it cannot be taken back.", "review": "2027-01-31" },
    { "id": "fetch-web", "when": { "action": "web.fetch" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "An address can carry the mission's data out of the machine, where it cannot be taken back.", "review": "2027-01-31" },
    { "id": "read-company-tools", "when": { "action": "mcp.read" }, "class": "read", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Read by default in the company's tools (session 2).", "review": "2027-01-31" },
    { "id": "write-sandbox-files", "when": { "action": "file.write" }, "class": "sandbox-write", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Free but supervised: the copy is the agent's to change.", "review": "2027-01-31" },
    { "id": "delete-sandbox-files", "when": { "action": "file.delete" }, "class": "sandbox-write", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Inside the copy, git keeps what was deleted.", "review": "2027-01-31" },
    { "id": "commit-locally", "when": { "action": "git.commit" }, "class": "sandbox-write", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "A local commit stays in the copy.", "review": "2027-01-31" },
    { "id": "start-mission", "when": { "action": "mission.start" }, "class": "sandbox-write", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "A mission starts in its own copy; what leaves it follows its own rules.", "review": "2027-01-31" },
    { "id": "no-mission-public-repo", "when": { "action": "mission.start", "repoVisibility": "public" }, "class": "irreversible", "effect": "deny", "inverse": null, "owner": "workspace-owner", "reason": "TaskForce doesn't start missions on public repositories yet: link a private repository to delegate this task.", "review": "2026-11-30" },
    { "id": "no-agent-scripts", "when": { "action": "shell", "command": "{npm,yarn,pnpm} {test,run}**" }, "class": "irreversible", "effect": "deny", "inverse": null, "owner": "workspace-owner", "reason": "While the computer isn't isolated, the agent doesn't run the repository's scripts: TaskForce runs the project's tests after the agent.", "review": "2026-11-30" },
    { "id": "run-git-reads", "when": { "action": "shell", "command": "git {status,diff,log,show,add}**" }, "class": "sandbox-write", "effect": "allow", "inverse": null, "owner": "workspace-owner", "reason": "Local git commands that stay in the copy.", "review": "2027-01-31" },
    { "id": "no-agent-push", "when": { "action": "shell", "command": "git push**" }, "class": "irreversible", "effect": "deny", "inverse": null, "owner": "workspace-owner", "reason": "Exits go through the runner, after the tests and under these rules, never through the agent's own shell.", "review": "2027-01-31" },
    { "id": "no-agent-gh", "when": { "action": "shell", "command": "gh **" }, "class": "irreversible", "effect": "deny", "inverse": null, "owner": "workspace-owner", "reason": "The GitHub CLI acts outside the copy; the runner does it under these rules.", "review": "2027-01-31" },
    { "id": "push-agent-branch-private", "when": { "action": "git.push", "branch": "tf/**", "repoVisibility": "private" }, "class": "reversible-exit", "effect": "allow", "inverse": "delete-branch", "owner": "workspace-owner", "reason": "The agent's branch can be deleted, and a private repository exposes nothing.", "review": "2027-01-31" },
    { "id": "push-public-repo", "when": { "action": "git.push", "repoVisibility": "public" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "Pushing to a public repository exposes the code; it cannot be taken back.", "review": "2027-01-31" },
    { "id": "open-pull-request", "when": { "action": "pr.open" }, "class": "reversible-exit", "effect": "allow", "inverse": "close-pull-request", "owner": "workspace-owner", "reason": "A pull request is closed in one gesture; nothing is merged.", "review": "2027-01-31" },
    { "id": "open-pull-request-public", "when": { "action": "pr.open", "repoVisibility": "public" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A pull request on a public repository is public at once.", "review": "2027-01-31" },
    { "id": "create-issue", "when": { "action": "issue.create" }, "class": "reversible-exit", "effect": "allow", "inverse": "close-issue", "owner": "workspace-owner", "reason": "An issue in the mission's project is closed in one gesture.", "review": "2027-01-31" },
    { "id": "create-project", "when": { "action": "project.create" }, "class": "reversible-exit", "effect": "allow", "inverse": "archive-project", "owner": "workspace-owner", "reason": "A project the person asks for in the conversation is created at once; it is archived in one gesture.", "review": "2027-01-31" },
    { "id": "update-issue", "when": { "action": "issue.update" }, "class": "reversible-exit", "effect": "allow", "inverse": "restore-issue", "owner": "workspace-owner", "reason": "The issue keeps its history; a change is put back from it.", "review": "2027-01-31" },
    { "id": "comment", "when": { "action": "comment.create" }, "class": "reversible-exit", "effect": "allow", "inverse": "delete-comment", "owner": "workspace-owner", "reason": "A comment is deleted in one gesture.", "review": "2027-01-31" },
    { "id": "create-note", "when": { "action": "knowledge.create" }, "class": "reversible-exit", "effect": "allow", "inverse": "delete-note", "owner": "workspace-owner", "reason": "A note the person asks for in the conversation is created at once; it is deleted in one gesture.", "review": "2027-01-31" },
    { "id": "propose-knowledge", "when": { "action": "knowledge.write" }, "class": "reversible-exit", "effect": "ask", "inverse": "restore-note", "owner": "workspace-owner", "reason": "The agent proposes an update with its source; a person decides.", "review": "2027-01-31" },
    { "id": "merge", "when": { "action": "git.merge" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A merge reaches what others build on.", "review": "2027-01-31" },
    { "id": "merge-pull-request", "when": { "action": "pr.merge" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A merge reaches what others build on.", "review": "2027-01-31" },
    { "id": "publish-package", "when": { "action": "package.publish" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A published version cannot be withdrawn from those who took it.", "review": "2027-01-31" },
    { "id": "deploy", "when": { "action": "deploy" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "Production is a one-way door.", "review": "2027-01-31" },
    { "id": "send-message", "when": { "action": "message.send" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A sent message cannot be unsent.", "review": "2027-01-31" },
    { "id": "pay", "when": { "action": "payment" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "Money moves only on a person's decision.", "review": "2027-01-31" },
    { "id": "use-secret", "when": { "action": "secret.use" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "A secret acts with someone's authority; its owner allows each use.", "review": "2027-01-31" },
    { "id": "write-company-tools", "when": { "action": "mcp.write" }, "class": "irreversible", "effect": "ask", "inverse": null, "owner": "workspace-owner", "reason": "Unknown inverse until a rule for this tool says otherwise.", "review": "2027-01-31" },
    { "id": "no-harness-change", "when": { "action": "harness.change" }, "class": "irreversible", "effect": "deny", "inverse": null, "owner": "workspace-owner", "reason": "No agent changes the rules.", "review": "2027-01-31" }
  ]
}

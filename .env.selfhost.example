# TaskForce self-hosted settings, read by docker-compose.yml.
# scripts/selfhost-init.sh (Windows: scripts\selfhost-init.ps1) copies this file to .env and fills in the secrets.
# Details: SELF_HOSTING.md.

# ── Addresses, as a browser reaches each service ───────────────────────────────────────────────────────────────
# The app, the API (also used by coding agent runners), Keycloak (its admin console) and the file storage.
# On another machine of your network: BIND_ADDRESS=0.0.0.0 and this machine's address in the four URLs, then
# rebuild the frontend (docker compose up -d --build frontend): the app keeps the addresses it was built with.
TF_APP_URL=http://localhost:3000
TF_API_URL=http://localhost:8080
TF_KEYCLOAK_URL=http://localhost:8180
TF_STORAGE_URL=http://localhost:9000
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
API_PORT=8080
KEYCLOAK_PORT=8180
STORAGE_PORT=9000

# ── Secrets, generated by scripts/selfhost-init ──────────────────────────────────────────────────────────────────
# Keep them with your backups: the database and the encrypted data (integration tokens) cannot be read without them.
DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
MINIO_ROOT_PASSWORD=
TF_ENCRYPTION_KEY=
AI_SERVICE_TOKEN=
TF_HUMAN_CHALLENGE_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Ollama on this machine by default, with qwen3:8b for chat and bge-m3 for search (ollama pull qwen3:8b bge-m3).
# On Linux, Ollama must listen beyond localhost (OLLAMA_HOST=0.0.0.0) for the containers to reach it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Or any OpenAI-compatible API (OpenAI, Groq, Mistral, a vLLM server...):
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_MODEL_FAST=
# No AI at all: AI_PROVIDER=none

# ── Email (optional) ────────────────────────────────────────────────────────────────────────────────────────────
# Without email, sign-up does not verify addresses (anyone who reaches the app can create an account with any
# address) and passwords are reset from the Keycloak console. With an SMTP server, fill MAIL_* and set
# SIGNUP_EMAIL_VERIFICATION=true.
SIGNUP_EMAIL_VERIFICATION=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=

# ── Integrations (optional) ─────────────────────────────────────────────────────────────────────────────────────
# OAuth apps created at GitHub (Settings > Developer settings > OAuth Apps) and Slack (api.slack.com/apps), with
# <TF_API_URL>/api/integrations/github/callback and <TF_API_URL>/api/integrations/slack/callback as callback URLs.
# Slack bot scopes: chat:write, chat:write.public, channels:read, channels:history, users:read, incoming-webhook.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# true = MCP servers and webhook receivers on your own network are allowed (n8n on the same machine, for example).
# MCP_ALLOW_PRIVATE_NETWORK=false
# WEBHOOKS_ALLOW_PRIVATE_NETWORK=false

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import { LevelBadge } from "@/components/site/Section";
import type { Maturity } from "@/components/site/nav";
import { APP_URL } from "@/components/site/nav";

type Item = { title: string; desc: string; level: Maturity };
type Phase = { key: string; heading: string; blurb: string; accent: string; items: Item[] };

const PHASES: Phase[] = [
  {
    key: "now",
    heading: "Now",
    blurb: "Shipped and in your hands today.",
    accent: "bg-emerald-500",
    items: [
      { title: "Real-time collaboration", desc: "Boards, issues and cycles, live for the whole team.", level: "live" },
      { title: "Smart Assign", desc: "The right task to the right person — an agent counts as an assignee.", level: "live" },
      { title: "Delivery analytics", desc: "Lead time, throughput and approval rate, per project.", level: "live" },
      { title: "Integrations", desc: "47 tools across your tracker, repo, chat and cloud.", level: "live" },
      { title: "Human approvals", desc: "A required sign-off at each checkpoint of a run.", level: "beta" },
    ],
  },
  {
    key: "next",
    heading: "Next",
    blurb: "In progress — usable, still hardening.",
    accent: "bg-amber-400",
    items: [
      { title: "TaskForce Memory retrieval", desc: "Runs recall the decisions and constraints you already set.", level: "beta" },
      { title: "Scoped agent roles", desc: "CPO, CTO and COO agents rather than one generalist.", level: "labs" },
      { title: "Model choice per step", desc: "The right model for each checkpoint — local or hosted.", level: "labs" },
    ],
  },
  {
    key: "later",
    heading: "Later",
    blurb: "Where this is going. Direction, not a deadline.",
    accent: "bg-indigo-400",
    items: [
      { title: "Governed orchestration", desc: "The full intent-to-deploy run, planned end to end.", level: "labs" },
      { title: "Learning from reviews", desc: "What you send back improves the next run.", level: "labs" },
      { title: "Beyond engineering", desc: "The same governed run for teams outside software.", level: "labs" },
    ],
  },
];
---

<BaseLayout
  title="Roadmap — TaskForce"
  description="What is live, what is in progress and where TaskForce is going — in the open. We commit to sequence, not to dates we can't keep."
>
  <PageHero
    eyebrow="Roadmap"
    title="What's shipped, what's next, and where this goes"
    lead="We publish the direction in the open. We commit to sequence, not to dates we can't keep — the changelog firms things up as work actually lands."
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
  />

  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="grid gap-8 lg:grid-cols-3">
        {
          PHASES.map((phase) => (
            <div class="bg-card flex flex-col rounded-2xl border p-6">
              <div class="flex items-center gap-2.5">
                <span class:list={["size-2.5 rounded-full", phase.accent]} aria-hidden />
                <h2 class="text-[17px] font-semibold text-foreground">{phase.heading}</h2>
              </div>
              <p class="text-muted-foreground mt-1.5 text-[13px]">{phase.blurb}</p>

              <ul class="mt-6 flex flex-col gap-5 border-t pt-6">
                {phase.items.map((item) => (
                  <li>
                    <div class="flex items-center gap-2">
                      <h3 class="text-[14px] font-medium text-foreground">{item.title}</h3>
                      <LevelBadge level={item.level} />
                    </div>
                    <p class="text-muted-foreground mt-1 text-[13px] leading-5">{item.desc}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="text-muted-foreground mt-10 text-[13px]">
        Maturity labels are honest on purpose: <span class="text-foreground">Live</span> is in
        production, <span class="text-foreground">Beta</span> works with rough edges, and
        <span class="text-foreground">Planned</span> is direction we're building toward.
      </p>
    </div>
  </section>

  <PageCta
    title="Build on what's live today"
    lead="The delivery tools are shipped now. Start there, and grow into the run as it hardens."
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "Book a demo", href: "/book-a-demo" }}
  />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import FeatureSplit from "@/components/site/sections/FeatureSplit.astro";
import CalloutBand from "@/components/site/sections/CalloutBand.astro";
import Panel from "@/components/site/sections/Panel.astro";
import ScreenPlaceholder from "@/components/site/sections/ScreenPlaceholder.astro";
import { AutoAssign } from "@/components/site/illustrations/AutoAssign";
import { Sparkles, Gauge, Clock, Bot, ShieldCheck } from "lucide-react";
import { APP_URL } from "@/components/site/nav";

/**
 * Smart Assign — même grammaire de sections que la page modèle `orchestration.astro` :
 * showcase de l'île réelle (AutoAssign), grille à FILETS pour les signaux (DA « petits traits »),
 * un FeatureSplit + ScreenPlaceholder pour l'agent-assigné, un CalloutBand pour la gouvernance.
 * Copie 100 % préservée : on ré-agence, on ne réécrit pas. Pas de StatBand (aucun chiffre réel ici).
 */

const FACTORS = [
  { icon: Sparkles, title: "Skills", text: "Matched from each member's skill profile — the areas they're strongest in." },
  { icon: Gauge, title: "Load", text: "Current workload, so no one gets buried while others sit idle." },
  { icon: Clock, title: "Availability", text: "Who is genuinely free to pick the work up now." },
];

const REVIEW = [
  "Every recommendation can be approved or overridden — keep any you'd rather hand to a specific person.",
  "Every task still carries a named human reviewer, even when a coding agent executes it.",
  "Nothing ships without human approval. Assignment is a suggestion, not an autopilot.",
];
---

<BaseLayout
  title="Smart Assign — TaskForce"
  description="TaskForce routes each task to the teammate or coding agent best matched to the work, based on skills, current load and availability. Every recommendation comes with its reason, and a human approves it."
>
  <PageHero
    kicker="Smart Assign"
    title="The right work to the right hands"
    lead="TaskForce routes each task to the teammate or coding agent best matched to the work — based on skills, current load and availability. Every recommendation comes with the reason, and a human approves it."
    level="live"
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "See pricing", href: "/pricing" }}
  />

  {/* ── La vraie modale Smart Assign, animée — showcase pleine largeur ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">In practice</p>
        <h2 class="t-h2">Recommendations, not decisions</h2>
        <p class="t-lead mt-4">
          When a breakdown produces a batch of issues, Smart Assign proposes an owner for each —
          with the reason next to it. You approve, adjust, or keep any for a specific person.
        </p>
      </div>
      <div class="mt-12">
        <AutoAssign client:idle />
      </div>
    </div>
  </section>

  {/* ── How it decides — grille à FILETS (DA « petits traits »), remplace la grille de cartes ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">How it decides</p>
        <h2 class="t-h2">Three signals, and its reasoning shown</h2>
        <p class="t-lead mt-4">
          Not a black box. Smart Assign weighs three signals and shows the reason behind every
          suggestion — so a lead can trust it, or overrule it, in a glance.
        </p>
      </div>
      <div class="bg-border mt-12 grid gap-px overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3">
        {
          FACTORS.map((f) => (
            <div class="bg-card flex flex-col p-6">
              <span class="bg-secondary/60 text-foreground flex size-10 items-center justify-center rounded-lg border">
                <f.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="text-foreground mt-4 text-[15px] font-semibold">{f.title}</h3>
              <p class="text-muted-foreground mt-1.5 text-[13px] leading-6">{f.text}</p>
            </div>
          ))
        }
      </div>
      <p class="text-muted-foreground mt-6 flex items-center gap-2 text-[13px]">
        <Sparkles className="text-primary size-4 shrink-0" strokeWidth={2} />
        Skill profiles can be enriched as your team works, with a short onboarding capturing the rest
        — so it gets sharper without a data-entry chore.
      </p>
    </div>
  </section>

  {/* ── Agent as assignee — FeatureSplit + ScreenPlaceholder ── */}
  <FeatureSplit
    reverse
    bg="secondary"
    eyebrow="The difference"
    title="A coding agent is an assignee like any other"
  >
    <div slot="aside">
      <span class="text-foreground mt-6 inline-flex size-11 items-center justify-center rounded-xl border bg-card">
        <Bot className="size-5" strokeWidth={1.75} />
      </span>
      <div class="mt-6 flex flex-col gap-4 text-[15px] leading-7 text-foreground">
        <p>
          Same board, same card, same review checkpoint. Assign an issue to Claude Code, Cursor or
          a teammate — Smart Assign weighs them the same way, by what the work needs.
        </p>
        <p class="text-muted-foreground">
          That's the whole idea: an agent isn't a feature bolted on the side. It's a member of the
          team that happens not to need sleep — and it still hands its work to a human to approve.
        </p>
      </div>
    </div>
    <ScreenPlaceholder label="Board · agent as assignee" />
  </FeatureSplit>

  {/* ── Human review — CalloutBand + Panel (la liste réelle dans un visuel) ── */}
  <CalloutBand eyebrow="You stay in control" statement="A suggestion, never an autopilot" bg="card">
    <div class="mx-auto mt-10 max-w-xl text-left">
      <Panel>
        <ul class="flex flex-col">
          {
            REVIEW.map((r) => (
              <li class="text-foreground flex items-start gap-3 border-b py-3 text-[14px] leading-6 last:border-0">
                <ShieldCheck className="text-primary mt-0.5 size-4 shrink-0" strokeWidth={2} />
                <span>{r}</span>
              </li>
            ))
          }
        </ul>
      </Panel>
    </div>
  </CalloutBand>

  <PageCta
    title="Put the right work in the right hands"
    lead="Smart Assign is live today — route work to teammates or coding agents based on what the task actually needs."
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "Book a demo", href: "/book-a-demo" }}
  />
</BaseLayout>

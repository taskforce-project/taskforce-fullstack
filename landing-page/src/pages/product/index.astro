---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import { LevelBadge } from "@/components/site/Section";
import { PRODUCT_PLATFORM, PRODUCT_DELIVERY, isLive, APP_URL } from "@/components/site/nav";
import { hueFor } from "@/lib/site-icons";

const GROUPS = [
  { title: "Platform", items: PRODUCT_PLATFORM },
  { title: "Delivery", items: PRODUCT_DELIVERY },
];
---

<BaseLayout
  title="Product — TaskForce"
  description="One platform from intent to production: governed orchestration, a memory layer for every run, human approvals, and the delivery tools your team already works in."
>
  <PageHero
    kicker="Platform"
    title="One platform, from intent to production"
    lead="TaskForce runs the whole path — planning, memory, approvals and the board your team already uses — as one system where every part knows about the others."
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "See the run", href: "/product/orchestration" }}
  />

  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      {
        GROUPS.map((group) => (
          <div class="mb-14 last:mb-0">
            <p class="t-eyebrow mb-6">{group.title}</p>
            <div class="-mx-6 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-2 lg:grid-cols-4 lg:-mx-10">
              {group.items.map((item) => {
                const Icon = item.icon;
                const live = isLive(item.href);
                const body = (
                  <>
                    <span class="ic-tile flex size-10 items-center justify-center rounded-lg border" style={`--ic:${hueFor(Icon)}`}>
                      {Icon && <Icon className="size-[18px]" strokeWidth={1.75} />}
                    </span>
                    <div class="mt-3 flex items-center gap-2">
                      <h3 class="text-[15px] font-medium text-foreground">{item.label}</h3>
                      {live ? (
                        item.badge && <LevelBadge level={item.badge} />
                      ) : (
                        <span class="text-muted-foreground inline-flex items-center rounded-md border border-dashed px-1.5 py-px text-[10px] font-medium tracking-wide uppercase">
                          Soon
                        </span>
                      )}
                    </div>
                    <p class="text-muted-foreground mt-1.5 text-[13px] leading-5">{item.desc}</p>
                  </>
                );
                return live ? (
                  <a
                    href={item.href}
                    class="bg-card hover:bg-secondary/40 flex flex-col p-6 transition-colors"
                  >
                    {body}
                  </a>
                ) : (
                  <div class="bg-card flex flex-col p-6 opacity-60" aria-disabled="true">
                    {body}
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <PageCta
    title="See it run end to end"
    lead="The fastest way to understand TaskForce is to give it one outcome and approve each step."
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "Book a demo", href: "/book-a-demo" }}
  />
</BaseLayout>

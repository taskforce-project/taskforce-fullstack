---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import { LevelBadge } from "@/components/site/Section";
import { IntegrationCatalogue } from "@/components/site/illustrations/IntegrationCatalogue";
import { IntegrationsHubFlow } from "@/components/site/flows/OrchestrationFlows";
import { Plug, Brain, Terminal, ArrowRight, KeyRound, Lock, ShieldCheck, EyeOff } from "lucide-react";
import { hueFor } from "@/lib/site-icons";

/* Les trois temps d'une intégration — rendus EXPLICITES (review user) :
   availability → ingestion vers Memory → action via MCP. Chacun dit où il en est. */
const WAYS = [
  {
    icon: Plug,
    title: "Connect",
    kind: "Connector availability",
    level: "live" as const,
    text: "A connector can be configured and connected. OAuth is available for supported providers; the rest use encrypted credentials you provide.",
  },
  {
    icon: Brain,
    title: "Remember",
    kind: "Ingestion into Memory",
    level: "beta" as const,
    text: "A connected tool's data flows into the Brain OS decision graph, so runs can start from the context your team has already built. Live for Plane today, rolling out per tool.",
  },
  {
    icon: Terminal,
    title: "Act",
    kind: "Action via MCP",
    level: "beta" as const,
    text: "Agents can use the tools you connect. Anything not explicitly read-only is treated as a write — the agent proposes it, and it runs only after a human approves it.",
  },
];

/* Le flux produit, de bout en bout — c'est ce qui distingue Integrations d'un annuaire. */
// (Le flux est rendu en diagramme dans le template, pas en données.)

/* Raccord aux trois piliers : Integrations n'est pas isolé, il alimente le reste. */
const PILLARS = [
  { name: "Integrations", text: "brings in the context.", href: null },
  { name: "Memory", text: "preserves the reasoning.", href: "/product/brain-os" },
  { name: "Orchestration", text: "decides what happens next.", href: "/product/orchestration" },
];

const SECURITY = [
  {
    icon: KeyRound,
    title: "OAuth where supported",
    text: "GitHub and Slack connect over OAuth; the rest use tokens or keys you provide.",
  },
  {
    icon: Lock,
    title: "Encrypted at rest",
    text: "Every credential is stored encrypted, never in the codebase.",
  },
  {
    icon: ShieldCheck,
    title: "Bounded by capability",
    text: "Agents can only invoke what a connector exposes — and only what the credentials and scopes you configure permit.",
  },
  {
    icon: EyeOff,
    title: "Out of the prompt",
    text: "Connector secrets are used server-side to reach the tool; they're never placed in a model prompt.",
  },
];
---

<BaseLayout
  title="Integrations — TaskForce"
  description="Connect the tools your work already lives in — 129 connectors across 16 categories, from your tracker and repo to your cloud, docs and models. They bring context and capabilities into every run: connect, remember, act — with a human on every external action."
>
  <PageHero
    kicker="Integrations"
    title="Connect the tools your work already lives in"
    lead="One catalogue, 129 connectors across 16 categories — from your tracker and repo to your cloud, docs and models. Connect them in minutes, then bring their context and capabilities into your runs."
    level="beta"
    primary={{ label: "Run your first workflow", href: "/waitlist" }}
    secondary={{ label: "Browse the catalogue", href: "#catalogue" }}
  />

  {/* ── Le catalogue : preuve de profondeur, pas le message ── */}
  <section id="catalogue" class="bg-card border-b scroll-mt-20">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">The catalogue</p>
        <h2 class="t-h2">Find your stack</h2>
        <p class="t-lead mt-4">
          Start with the tools teams reach for first, or open the full catalogue. Adding a new one is
          a line of configuration — not a release.
        </p>
      </div>
      <div class="mt-10">
        <IntegrationCatalogue client:load />
      </div>
    </div>
  </section>

  {/* ── Comment ça marche : Connect → Remember → Act ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">How it works</p>
        <h2 class="t-h2">Connect, remember, act</h2>
        <p class="t-lead mt-4">
          An integration isn't a logo on a page. In TaskForce a tool earns its place in three steps —
          and each one is explicit about where it stands.
        </p>
      </div>

      <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-3 lg:-mx-10">
        {
          WAYS.map((w) => (
            <div class="bg-card flex flex-col p-6 sm:p-8">
              <div class="flex items-center justify-between gap-2">
                <span class="ic-tile flex size-11 items-center justify-center rounded-xl border" style={`--ic:${hueFor(w.icon)}`}>
                  <w.icon className="size-5" strokeWidth={1.75} />
                </span>
                <LevelBadge level={w.level} />
              </div>
              <h3 class="mt-4 text-[16px] font-semibold text-foreground">{w.title}</h3>
              <p class="text-primary mt-1 text-[12px] font-medium">{w.kind}</p>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{w.text}</p>
            </div>
          ))
        }
      </div>

      {/* Hub radial : ton stack se connecte à une mémoire commune — forme distincte des chaînes ailleurs. */}
      <div class="flow-canvas relative mx-auto mt-14 h-[440px] w-full max-w-2xl overflow-hidden border">
        <IntegrationsHubFlow client:only="react" />
      </div>
      <p class="text-muted-foreground mt-3 text-center text-[12.5px]">
        Illustrative — one shared memory, <span class="text-foreground font-medium">129 connectors</span> across 16 categories feeding every run.
      </p>

      {/* Raccord aux trois piliers. */}
      <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-3 lg:-mx-10">
        {
          PILLARS.map((p) => (
            <div class="bg-card flex flex-col p-6 sm:p-8">
              <p class="text-[14.5px] leading-6 text-foreground">
                <span class="font-semibold">{p.name}</span> {p.text}
              </p>
              {p.href && (
                <a
                  href={p.href}
                  class="link-underline text-muted-foreground hover:text-foreground mt-3 inline-flex w-fit items-center gap-1 text-[13px] font-medium"
                >
                  Learn more
                  <ArrowRight className="size-3.5" />
                </a>
              )}
            </div>
          ))
        }
      </div>

      <p class="text-muted-foreground mt-8 text-[13px] leading-6">
        We mark integrations <span class="text-foreground font-medium">Beta</span> on purpose:
        connecting is here today, deep sync and MCP actions are rolling out. Follow it on the{" "}
        <a href="/roadmap" class="link-underline text-foreground font-medium">public roadmap</a>.
      </p>
    </div>
  </section>

  {/* ── Sécurité & permissions : le pont vers le Trust Center ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Security &amp; permissions</p>
        <h2 class="t-h2">Your credentials, your scopes, your control</h2>
        <p class="t-lead mt-4">
          Connecting real systems to AI raises one question first: what can an agent actually do with
          that access? The short version is here — the full one lives in the Trust Center.
        </p>
      </div>
      <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-2 lg:grid-cols-4 lg:-mx-10">
        {
          SECURITY.map((s) => (
            <div class="bg-card flex flex-col p-6 sm:p-8">
              <span class="ic-tile flex size-11 items-center justify-center rounded-xl border" style={`--ic:${hueFor(s.icon)}`}>
                <s.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[15px] font-semibold text-foreground">{s.title}</h3>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{s.text}</p>
            </div>
          ))
        }
      </div>
      <a
        href="/trust"
        class="link-underline text-foreground mt-10 inline-flex items-center gap-1.5 text-[14px] font-medium"
      >
        See security &amp; data handling
        <ArrowRight className="size-4" />
      </a>
    </div>
  </section>

  <PageCta
    title="Your tools become context and capabilities for every run"
    lead="Connect your stack. Give every run the context it needs. Let agents act through the tools you already use — with humans still in control."
    primary={{ label: "Run your first workflow", href: "/waitlist" }}
    secondary={{ label: "Book a demo", href: "/book-a-demo" }}
  />
</BaseLayout>

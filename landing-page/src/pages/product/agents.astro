---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import { AgentsFlow } from "@/components/site/flows/OrchestrationFlows";
import { MemorySearchDemo, TakeNotesDemo, ConnectedToolsDemo } from "@/components/site/illustrations/AgentToolDemos";
import { Compass, Building2, CalendarClock, BrainCircuit, Boxes, ShieldCheck, SlidersHorizontal, Search, PenLine, Plug } from "lucide-react";
import { hueFor } from "@/lib/site-icons";

/* Les 3 rôles - mêmes que la page Orchestration (road_to_v2/Agents_C_Level.md). Direction Planned. */
const TEAM = [
  {
    code: "CPO",
    owns: "the what",
    icon: Compass,
    box: "ring-violet-200 text-violet-600",
    desc: "Shapes the product: vision, specifications, priorities and acceptance criteria.",
  },
  {
    code: "CTO",
    owns: "the how",
    icon: Building2,
    box: "ring-blue-200 text-blue-600",
    desc: "Owns technical coherence: architecture, APIs, data, trade-offs and technical risk.",
  },
  {
    code: "COO",
    owns: "the when & the risk",
    icon: CalendarClock,
    box: "ring-amber-200 text-amber-600",
    desc: "Owns delivery: sequencing, capacity, dependencies, milestones, risk and drift.",
  },
];

/* Ce que l'assistant fait RÉELLEMENT aujourd'hui (AgentService : RAG Brain OS + tool-calling). */
const TOOLS = [
  { icon: Search, title: "Search your Memory", text: "Retrieves the decisions, constraints and conventions behind your system before it answers." },
  { icon: PenLine, title: "Take notes", text: "Writes findings back as knowledge nodes, so what it learns stays in the graph." },
  { icon: Plug, title: "Use connected tools", text: "Calls tools exposed over MCP by the systems you've connected - and any external write waits for a human." },
];

/* Les garde-fous - cohérents avec Orchestration. « Governable » (pas « safe to trust » : l'IA
   peut se tromper avec assurance, cf. AI Transparency). Model-agnostic → Configurable (propriété
   d'architecture, pas de comportement). */
const RULES = [
  { icon: BrainCircuit, title: "Grounded", desc: "Uses your architecture, decisions and conventions - not generic guesses." },
  { icon: Boxes, title: "Specialized", desc: "Works within a defined responsibility instead of pretending to know everything." },
  { icon: ShieldCheck, title: "Governed", desc: "Proposes; a human approves. Nothing consequential runs on its own." },
  { icon: SlidersHorizontal, title: "Your models", desc: "Local through Ollama at zero model cost, or hosted - your call, fast or deep per run." },
];

---

<BaseLayout
  title="Agents - TaskForce"
  description="A delivery team, not a single generalist: specialized agents for product, architecture and delivery, grounded in your Memory and approved by a human. Today, one assistant agent grounded in your Brain OS; the specialized team is the direction."
>
  <PageHero
    kicker="Agents"
    title="A delivery team, not a single generalist"
    lead="Most AI workflows start with a generalist agent. TaskForce is building a small team of specialized agents - product, architecture and delivery - each grounded in your Memory, each producing proposals a human approves."
    level="labs"
    primary={{ label: "Run your first workflow", href: "/waitlist" }}
    secondary={{ label: "See the run", href: "/product/orchestration" }}
  />

  {/* ── The team (Planned) ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">The team</p>
        <h2 class="t-h2">Three roles, the way a strong org splits them</h2>
        <p class="t-lead mt-4">
          Responsibility is split the way a software organization does it - so no single agent has to
          be an expert at everything, and no single agent gets the final say.
        </p>
      </div>
      <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-3 lg:-mx-10">
        {
          TEAM.map((a) => (
            <div class="bg-card flex flex-col p-6 sm:p-8">
              <div class="flex items-center gap-3">
                <a.icon className="size-7 shrink-0" strokeWidth={1.75} style={{ color: hueFor(a.icon) }} />
                <div>
                  <p class="text-[16px] font-semibold text-foreground">{a.code}</p>
                  <p class="text-muted-foreground text-[12px] italic">{a.owns}</p>
                </div>
              </div>
              <p class="text-muted-foreground mt-4 text-[13.5px] leading-6">{a.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-[15px] font-medium text-foreground">
        Three perspectives. One run. No agent gets the final say.
      </p>
    </div>
  </section>

  {/* ── One run, three perspectives : texte | flux vertical (React Flow) à droite, fond à points (template hero) ── */}
  <section class="bg-card bg-dots border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,460px)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="t-eyebrow mb-3">Orchestration</p>
          <h2 class="t-h2">One run, three perspectives</h2>
          <p class="t-lead mt-4 max-w-xl">
            Each role produces an artifact - a spec, an approach, a breakdown - and hands it to the next
            only after a human approves it. Three perspectives, one accountable chain.
          </p>
          <p class="text-muted-foreground mt-6 flex items-center gap-2 text-[13px]">
            <ShieldCheck className="size-4 shrink-0" strokeWidth={2} style={{ color: hueFor(ShieldCheck) }} />
            A human approves at every checkpoint - no role hands off on its own.
          </p>
        </div>
        <div class="lg:pl-4">
          <div class="relative mx-auto w-full max-w-[320px]" style="aspect-ratio: 320 / 500">
            <AgentsFlow client:only="react" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── What's real today ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">What's real today</p>
        <h2 class="t-h2">One assistant, grounded in your Memory</h2>
        <p class="t-lead mt-4">
          The specialized team is the direction. Today, TaskForce ships an assistant grounded in your
          Brain OS: it retrieves the reasoning behind your system, uses connected tools - and
          hands consequential actions to a human.
        </p>
      </div>
      <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-3 lg:-mx-10">
        {
          TOOLS.map((t, i) => (
            <div class="bg-card flex flex-col p-6 sm:p-8">
              {i === 0 && <MemorySearchDemo client:visible />}
              {i === 1 && <TakeNotesDemo client:visible />}
              {i === 2 && <ConnectedToolsDemo client:visible />}
              <div class="mt-5 flex items-center gap-2.5">
                <t.icon className="size-5 shrink-0" strokeWidth={1.75} style={{ color: hueFor(t.icon) }} />
                <h3 class="text-[16px] font-semibold text-foreground">{t.title}</h3>
              </div>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{t.text}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/product/brain-os" class="link-underline text-foreground text-[14px] font-medium">
          How Memory works →
        </a>
        <a href="/product/integrations" class="link-underline text-muted-foreground hover:text-foreground text-[14px]">
          Connected tools →
        </a>
      </div>
    </div>
  </section>

  {/* ── The rules every agent follows ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">The rules</p>
        <h2 class="t-h2">What makes an agent governable</h2>
        <p class="t-lead mt-4">
          An agent is only as useful as it is accountable. Every agent - the assistant today, the
          specialized team as it lands - works to the same rules.
        </p>
      </div>
      <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-2 lg:grid-cols-4 lg:-mx-10">
        {
          RULES.map((r) => (
            <div class="bg-card flex flex-col p-6 sm:p-8">
              <span class="ic-tile flex size-10 items-center justify-center rounded-lg border" style={`--ic:${hueFor(r.icon)}`}>
                <r.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[15px] font-semibold text-foreground">{r.title}</h3>
              <p class="text-muted-foreground mt-1.5 text-[13px] leading-6">{r.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="text-muted-foreground mt-8 text-[13px] leading-6">
        Every proposal an agent makes waits for a human at a
        <a href="/product/orchestration" class="link-underline text-foreground font-medium"> checkpoint</a>
        - see how sign-off works in
        <a href="/product/approvals" class="link-underline text-foreground font-medium"> Approvals</a>.
      </p>
    </div>
  </section>

  <PageCta
    title="A team you direct, not a black box you hope for"
    lead="Specialized agents, grounded in your context, producing proposals you can review, approve or reject."
    primary={{ label: "Run your first workflow", href: "/waitlist" }}
    secondary={{ label: "See the roadmap", href: "/roadmap" }}
  />
</BaseLayout>

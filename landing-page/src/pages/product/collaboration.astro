---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import { CollabBoard } from "@/components/site/illustrations/CollabBoard";
import { KanbanSquare, CalendarRange, MessageSquare, ShieldCheck, Zap, RefreshCw, Bot } from "lucide-react";
import { APP_URL } from "@/components/site/nav";

const BLOCKS = [
  {
    icon: KanbanSquare,
    title: "Boards & issues",
    text: "Kanban boards with issues, keys, priorities, labels and assignees. Move a card and it moves for everyone.",
  },
  {
    icon: CalendarRange,
    title: "Cycles",
    text: "Group issues into cycles, and see what's in flight, what shipped and what slipped.",
  },
  {
    icon: MessageSquare,
    title: "Discussion",
    text: "Comment on any issue. The conversation stays attached to the work — not buried in a separate chat.",
  },
  {
    icon: ShieldCheck,
    title: "Roles & access",
    text: "Owners, admins, members and viewers. Viewers read; collaborators contribute; private projects stay private.",
  },
];

const LIVE = [
  {
    icon: Zap,
    title: "Instant",
    text: "Create, move, re-label or re-assign an issue — it propagates to everyone with the board open.",
  },
  {
    icon: RefreshCw,
    title: "No refresh",
    text: "The board patches itself as events arrive. Nobody works off a stale view.",
  },
  {
    icon: Bot,
    title: "Agents too",
    text: "A coding agent's changes are broadcast exactly like a teammate's — same board, same instant.",
  },
];
---

<BaseLayout
  title="Collaboration — TaskForce"
  description="Boards, issues and cycles your team already knows, kept in sync in real time. People and coding agents work the same board, and every change is broadcast live to everyone."
>
  <PageHero
    kicker="Collaboration"
    title="One board for your team and your agents"
    lead="Boards, issues and cycles your team already knows — kept in sync in real time. People and coding agents work the same board, and every change shows up for everyone the moment it happens."
    level="live"
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "See pricing", href: "/pricing" }}
  />

  {/* ── Le vrai board, en surface partagée ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">In practice</p>
        <h2 class="t-h2">The board your team already knows</h2>
        <p class="t-lead mt-4">
          Columns, issues, keys, priorities, labels and assignees — nothing to relearn. What changes
          is that it stays in sync for everyone at once, and a coding agent can own a card just like a
          teammate.
        </p>
      </div>
      <div class="mt-12">
        <CollabBoard />
      </div>
    </div>
  </section>

  {/* ── Les primitives ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">The building blocks</p>
        <h2 class="t-h2">Built to run the work, not just track it</h2>
        <p class="t-lead mt-4">
          The primitives are the ones you'd expect from a modern issue tracker — with the run's
          context attached to each one.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          BLOCKS.map((b) => (
            <div class="rounded-2xl border bg-card p-6">
              <span class="bg-card text-foreground flex size-11 items-center justify-center rounded-xl border">
                <b.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[16px] font-semibold text-foreground">{b.title}</h3>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Temps réel ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Real time</p>
        <h2 class="t-h2">Everyone sees the same board, the moment it changes</h2>
        <p class="t-lead mt-4">
          When anyone creates, moves, re-labels or re-assigns an issue, it updates on every open board
          instantly — over a live connection, no refresh. Your agents' changes arrive the same way
          people's do.
        </p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          LIVE.map((l) => (
            <div class="rounded-2xl border bg-card p-6">
              <span class="bg-card text-foreground flex size-11 items-center justify-center rounded-xl border">
                <l.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[16px] font-semibold text-foreground">{l.title}</h3>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{l.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Une seule surface : gens + agents ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,420px)_1fr] lg:gap-16">
        <div>
          <p class="t-eyebrow mb-3">One surface</p>
          <h2 class="t-h2">People and agents, on the same board</h2>
          <span class="text-foreground mt-6 inline-flex size-11 items-center justify-center rounded-xl border bg-card">
            <Bot className="size-5" strokeWidth={1.75} />
          </span>
        </div>
        <div class="flex flex-col gap-4 text-[15px] leading-7 text-foreground">
          <p>
            Assign a card to a teammate or to Claude Code, Cursor or another coding agent — same card,
            same columns, same review checkpoint. The board doesn't treat an agent as a separate kind
            of thing.
          </p>
          <p class="text-muted-foreground">
            That's the point: agents aren't a side panel. They work where your team already works, and
            what they produce still goes to a human to approve.
          </p>
          <p class="text-muted-foreground text-[13.5px]">
            <a href="/product/smart-assign" class="link-underline text-foreground font-medium">
              See how work gets routed →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <PageCta
    title="Bring your team onto one board"
    lead="Start with the delivery workspace — boards, issues, cycles and real-time collaboration, free. Invite your team and your agents to the same place."
    primary={{ label: "Run your first workflow", href: `${APP_URL}/auth/register` }}
    secondary={{ label: "Book a demo", href: "/book-a-demo" }}
  />
</BaseLayout>

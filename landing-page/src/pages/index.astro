---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Hero } from "@/components/sections/Hero";
import { LogosSection } from "@/components/sections/LogosSection";
import {
  StatementSection,
  OrchestrationFeature,
  SmartAssignFeature,
  AgentsFeature,
  BrainOSFeature,
  AnalyticsFeature,
} from "@/components/sections/HomeFeatures";
import {
  IntegrationsSection,
  EnterpriseSection,
  TestimonialsSection,
} from "@/components/sections/HomeSections";
import { HowItWorks } from "@/components/sections/HowItWorks";
import { CtaSection } from "@/components/sections/CtaSection";
---

<BaseLayout
  title="TaskForce — AI Delivery Operating System"
  description="TaskForce turns intent into shipped software: describe the outcome and it orchestrates your AI agents through every step of delivery — with human approval at each checkpoint."
>
  <Hero />
  <LogosSection />
  <StatementSection />
  <HowItWorks />
  <OrchestrationFeature />
  <SmartAssignFeature />
  <AgentsFeature />
  <BrainOSFeature />
  <AnalyticsFeature />
  <IntegrationsSection />
  <EnterpriseSection />
  <TestimonialsSection />
  <CtaSection />
</BaseLayout>

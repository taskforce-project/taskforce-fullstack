---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Hero } from "@/components/site/home/Hero";
import { BrainTeaser } from "@/components/site/home/Narrative";
import { Problem } from "@/components/site/home/Platform";
import { TeamGrid } from "@/components/site/home/Showcase";
import { Trust, WhereThisGoes, FinalCta } from "@/components/site/home/Proof";
import BeforeAfter from "@/components/site/home/BeforeAfter.astro";
import WhatShipsToday from "@/components/site/home/WhatShipsToday.astro";
import Synergy from "@/components/site/home/Synergy.astro";
import TheRun from "@/components/site/home/TheRun.astro";
---

<BaseLayout
  title="TaskForce — AI Delivery Operating System"
  description="Describe the outcome and TaskForce runs the delivery: agents plan and draft every step, a human approves each checkpoint, and the models can run on your own hardware."
>
  {/* PASSE DE RÉDUCTION (review 13, validée) : 16 → 10 sections, tout accroché à l'idée UNIQUE
      « software delivery loses context; TaskForce preserves it from intent to production ».
      Coupées / absorbées comme PREUVES (plus des « produits » séparés) :
        · Manifesto  → l'idée vit dans Problem
        · Pillars    → fondu dans Synergy (« Why it's different »)
        · Foundations→ redondant avec les bullets du Run + la checklist Trust
        · Integrations→ compat couverte par TeamGrid (« sits on your board/repo ») + logos du hero
        · Phases     → fondu dans TeamGrid (getting started / missing layer)
        · Maturity   → Vision porte déjà « dated roadmap »

      Spine : IDÉE (Problem + Before/After, la démo des fuites) → PRODUIT (Run) → MOAT (Memory) →
      WHY DIFFERENT (Synergy) → PREUVE (Enterprise) → WHO/HOW (Teams) → FUTUR (Vision) → TRY.
      Bandes alternées blanc/gris. 1 seul îlot (RunTimeline, `client:idle`). */}
  <Hero />

  <Problem />
  <BeforeAfter />
  <Synergy />
  <WhatShipsToday />

  <TheRun />
  <BrainTeaser />

  <Trust />
  <TeamGrid />

  <WhereThisGoes />
  <FinalCta />
</BaseLayout>

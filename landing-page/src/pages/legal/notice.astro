---
/**
 * Mentions légales : éditeur, hébergeurs, propriété intellectuelle, crédits des peintures (lib/backgrounds.ts).
 * Repris de l'ancienne page, sans l'hébergement de la webapp.
 */
import LegalDoc from "@/layouts/LegalDoc.astro";
import { BACKGROUNDS, type BackgroundName } from "@/lib/backgrounds";
import { LINKS } from "@/lib/site";

const WHERE: Record<BackgroundName, string> = {
  home: "Home page",
  features: "Features",
  agents: "Agents",
  security: "Security",
  download: "Download",
  migrate: "Moving from the web app",
  band: "Home page, local first",
  end: "Closing panel",
};
const CREDITS = (Object.keys(BACKGROUNDS) as BackgroundName[]).map((k) => ({ where: WHERE[k], ...BACKGROUNDS[k].credit }));
---


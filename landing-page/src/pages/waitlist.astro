---
/**
 * Waitlist — destination des CTA d'inscription tant que l'app n'est pas déployée (évite les liens morts
 * vers app.taskforce.dev). Capture par mailto (site statique, aucun backend) ; brancher un service de
 * formulaire (Formspree/Tally…) plus tard si besoin.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import { Check } from "lucide-react";

const CONTACT = "hello@taskforce.dev";
const PERKS = [
  "First access the day TaskForce opens up",
  "Early influence on what we build next",
  "One email when it's ready — no spam",
];
---

<BaseLayout
  title="Join the waitlist — TaskForce"
  description="TaskForce is launching soon. Join the waitlist and we'll let you know the moment you can run your first governed AI workflow."
>
  <PageHero
    kicker="Waitlist"
    title="Be first when TaskForce opens"
    lead="We're finishing the first release of the AI delivery operating system. Leave us a line and we'll tell you the moment you can run your first governed workflow — on your models, with a human at every checkpoint."
    primary={{ label: "Join the waitlist", href: `mailto:${CONTACT}?subject=TaskForce waitlist` }}
    secondary={{ label: "See the roadmap", href: "/roadmap" }}
  />

  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="mx-auto max-w-xl">
        <ul class="flex flex-col gap-4">
          {
            PERKS.map((p) => (
              <li class="text-foreground flex items-start gap-3 text-[15px] leading-7">
                <Check className="mt-1 size-4 shrink-0 text-emerald-500" strokeWidth={2.5} />
                {p}
              </li>
            ))
          }
        </ul>
        <p class="text-muted-foreground mt-10 text-[13.5px] leading-6">
          Prefer to talk? <a href="/book-a-demo" class="link-underline text-foreground font-medium">Book a demo</a>, or
          write to <a href={`mailto:${CONTACT}`} class="link-underline text-foreground font-medium">{CONTACT}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

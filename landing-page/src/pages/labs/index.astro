---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LabsBackdrop from "@/components/site/LabsBackdrop.astro";
import LabsGradientDefs from "@/components/site/labs/LabsGradientDefs.astro";
import { LabsShowcase } from "@/components/site/LabsShowcase";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { LABS } from "@/lib/labs";
import { FlaskConical, ArrowRight, Bot, Brain, Cpu, ShieldCheck, Sparkles } from "lucide-react";

/**
 * Labs — CLAIR, STATIQUE, SOBRE. Retours user 03/08 : image de fond plein cadre, pas de rails sur le hero,
 * icônes en dégradé (le TRAIT prend le dégradé, aucun fond), accents en BLEU (primaire)/neutre — plus de
 * violet ; dégradés tirés de l'image (sans violet). Système de sections/rails plutôt que des cartes flottantes.
 * D11 : on publie la DIRECTION, pas le mécanisme ; aucune expérience n'est « Live ».
 */

const ITEMS = Object.values(LABS);

type Mat = "live" | "beta" | "planned" | "research";
const MAT_LIGHT: Record<Mat, string> = {
  live: "border-emerald-200 bg-emerald-50 text-emerald-700",
  beta: "border-amber-200 bg-amber-50 text-amber-700",
  planned: "border-slate-200 bg-slate-100 text-slate-600",
  research: "border-sky-200 bg-sky-50 text-sky-700",
};
const MAT_LABEL: Record<Mat, string> = { live: "Live", beta: "Beta", planned: "Planned", research: "Research" };
const DOT: Record<string, string> = {
  live: "bg-emerald-500",
  beta: "bg-amber-500",
  planned: "bg-slate-400",
  research: "bg-sky-500",
  input: "bg-slate-300",
};

const SURFACES: Record<string, { at: string; href: string; mat: Mat }> = {
  "agent-roles": { at: "Orchestration", href: "/product/orchestration", mat: "planned" },
  "run-memory": { at: "TaskForce Memory", href: "/product/brain-os", mat: "beta" },
  "model-choice": { at: "Your models", href: "/enterprise", mat: "live" },
  "learning-from-reviews": { at: "Prediction & calibration", href: "/product/orchestration", mat: "planned" },
};

/* Données pour l'îlot LabsShowcase (onglets) — 1 sujet = 1 feature avec son storytelling complet. */
const SHOWCASE = ITEMS.map((lab, i) => ({
  key: lab.key,
  name: lab.name,
  lead: lab.lead,
  why: lab.why,
  exploring: lab.exploring,
  status: lab.status,
  links: lab.links,
  at: SURFACES[lab.key].at,
  href: SURFACES[lab.key].href,
  mat: SURFACES[lab.key].mat,
  exp: `EXP-${String(i + 1).padStart(2, "0")}`,
}));

const LOOP: { label: string; mat: Mat | null }[] = [
  { label: "Signal", mat: null },
  { label: "Memory", mat: "beta" },
  { label: "Reasoning", mat: "planned" },
  { label: "Model", mat: "live" },
  { label: "Evaluation", mat: "research" },
  { label: "Decision", mat: "beta" },
];

type Grad = { name: string; blurb: string; href: string; icon: typeof Bot; mat: Exclude<Mat, "planned" | "research"> };
const GRADUATED: Grad[] = [
  {
    name: "TaskForce Memory",
    blurb: "Runs start from what your team already decided — decisions, constraints and rejected paths, carried forward.",
    href: "/product/brain-os",
    icon: Brain,
    mat: "beta",
  },
  {
    name: "Your models — local or hosted",
    blurb: "Run on Ollama locally or a hosted model. Your models, your call — per deployment.",
    href: "/enterprise",
    icon: Cpu,
    mat: "live",
  },
  {
    name: "Approvals",
    blurb: "A human sign-off on the actions that matter, with a trail of who approved what.",
    href: "/product/approvals",
    icon: ShieldCheck,
    mat: "beta",
  },
  {
    name: "Smart Assign",
    blurb: "Work routed to the right person, from their skills and current load.",
    href: "/product/smart-assign",
    icon: Sparkles,
    mat: "live",
  },
];
const GRAD_FEATURED = GRADUATED[0];
const GRAD_REST = GRADUATED.slice(1);
const FeatIcon = GRAD_FEATURED.icon;
---

<BaseLayout
  title="Labs — TaskForce"
  description="TaskForce Labs — research in public. The delivery loop we're building, the experiments behind it, and what has already graduated to the product. We publish the direction; the mechanism stays in the lab until it ships."
>
  <LabsGradientDefs />

  {/* ── Hero : image plein cadre, sans rails ── */}
  <section class="relative overflow-hidden border-b bg-card">
    <LabsBackdrop />
    <div class="container-site relative py-20 lg:py-28">
      <div class="max-w-xl">
        <div class="flex flex-wrap items-center gap-2.5">
          <FlaskConical className="labs-ic-c size-7" strokeWidth={1.9} />
          <span class="labs-gtext font-mono text-[12px] font-semibold tracking-[0.16em] uppercase">
            TaskForce Labs
          </span>
        </div>
        <h1 class="t-h1 mt-6">Research in public.</h1>
        <p class="t-lead mt-5">
          Where we're honest about the frontier: the problems we're chasing and the benefit we're after.
          We publish the direction, and keep the mechanism in the lab until it ships.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/roadmap" class={cn(buttonVariants({ size: "pill" }))}>See the roadmap</a>
          <a href="/product" class={cn(buttonVariants({ variant: "outline", size: "pill" }))}>
            What ships today
          </a>
        </div>
        <p class="mt-7 flex items-center gap-2 font-mono text-[11.5px] text-muted-foreground">
          <span aria-hidden class="labs-g1 inline-block size-1.5 rounded-full"></span>
          // direction published · mechanism kept · nothing here is a shipped feature
        </p>
      </div>
    </div>
  </section>

  {/* ── Les sujets de recherche en features (onglets) ── */}
  <section class="bg-secondary border-b decor labs-pixels overflow-hidden">
    <div class="container-rail py-20 lg:py-28">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="labs-gtext font-mono text-[12px] font-semibold tracking-[0.14em] uppercase">The experiments</p>
        <h2 class="t-h2 mt-3">Pick a subject. See the whole story.</h2>
        <p class="t-lead mt-4">
          Each research direction as a feature — why it matters, what we're chasing, where it stands today,
          and where to go deeper. We publish the direction; the mechanism stays in the lab until it ships.
        </p>
      </div>
      <LabsShowcase subjects={SHOWCASE} client:load />
    </div>
  </section>

  {/* ── La boucle = diagramme de flux centré (plus un stepper serré) ── */}
  <section class="bg-card border-b decor labs-pixels overflow-hidden">
    <div class="container-rail py-20 lg:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <p class="labs-gtext font-mono text-[12px] font-semibold tracking-[0.14em] uppercase">The system</p>
        <h2 class="t-h2 mt-3">The pieces are one loop</h2>
        <p class="t-lead mt-4">
          The experiments aren't separate features — they're steps of one loop TaskForce reasons over. Intent
          enters, runs against what your organisation already decided, and every decision feeds back into memory.
        </p>
      </div>

      <div class="relative mt-16">
        {/* Piste horizontale reliant les étapes (desktop). */}
        <div
          aria-hidden
          class="via-border absolute inset-x-[9%] top-6 hidden h-px bg-gradient-to-r from-transparent to-transparent md:block"
        >
        </div>
        <ol class="grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 md:grid-cols-6 md:gap-y-0">
          {
            LOOP.map((step, i) => (
              <li class="relative flex flex-col items-center text-center">
                <span class="bg-card relative z-10 flex size-12 items-center justify-center rounded-full border font-mono text-[13px] font-semibold text-foreground shadow-sm">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="mt-3.5 text-[13.5px] font-semibold text-foreground">{step.label}</span>
                {step.mat ? (
                  <span class="text-muted-foreground mt-1.5 inline-flex items-center gap-1.5 font-mono text-[10px] tracking-wide uppercase">
                    <span class={cn("size-1.5 rounded-full", DOT[step.mat])} />
                    {MAT_LABEL[step.mat]}
                  </span>
                ) : (
                  <span class="text-muted-foreground/70 mt-1.5 font-mono text-[10px] tracking-wide uppercase">
                    Input
                  </span>
                )}
              </li>
            ))
          }
        </ol>

        {/* Fermeture de la boucle. */}
        <div class="mt-14 flex items-center justify-center gap-3">
          <span aria-hidden class="labs-g5 hidden h-px w-12 sm:block"></span>
          <span class="text-muted-foreground inline-flex items-center gap-2 font-mono text-[11.5px]">
            <span aria-hidden class="text-[15px] leading-none">↺</span>
            the decision feeds back into memory — the loop closes
          </span>
          <span aria-hidden class="labs-g6 hidden h-px w-12 sm:block"></span>
        </div>
      </div>
    </div>
  </section>

  {/* ── De la paillasse au produit : une vedette + une liste (asymétrique, pas 4 cartes) ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <p class="t-eyebrow">From the lab to the product</p>
        <h2 class="t-h2 mt-3">What has already graduated</h2>
        <p class="t-lead mt-4">
          When something works, it leaves Labs and ships with a maturity label. These started as questions
          here — they're in the product today.
        </p>
      </div>

      <div class="mt-12 grid gap-4 lg:grid-cols-5">
        {/* Vedette (produit phare) avec un visuel placeholder. */}
        <a
          href={GRAD_FEATURED.href}
          class="group bg-card hover:border-primary/30 relative flex flex-col overflow-hidden rounded-2xl border transition-colors lg:col-span-3"
        >
          <div aria-hidden class="labs-g6 relative h-44 overflow-hidden sm:h-52">
            <div class="absolute inset-0 bg-[radial-gradient(120%_120%_at_15%_15%,transparent,rgba(255,255,255,0.28))]"></div>
            <FeatIcon className="absolute right-6 bottom-4 size-24 text-white/85" strokeWidth={1.25} />
            <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-white/85 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wide text-slate-700 uppercase backdrop-blur-sm">
              Graduated from Labs
            </span>
          </div>
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <div class="flex items-center gap-2.5">
              <h3 class="t-h3">{GRAD_FEATURED.name}</h3>
              <span class={cn("inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold", MAT_LIGHT[GRAD_FEATURED.mat])}>
                {MAT_LABEL[GRAD_FEATURED.mat]}
              </span>
            </div>
            <p class="text-muted-foreground mt-2.5 flex-1 text-[14.5px] leading-6">{GRAD_FEATURED.blurb}</p>
            <span class="text-primary mt-5 inline-flex items-center gap-1.5 text-[13.5px] font-medium">
              Explore
              <ArrowRight className="size-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </div>
        </a>

        {/* Les autres, en lignes compactes. */}
        <div class="grid gap-4 lg:col-span-2">
          {
            GRAD_REST.map((g) => {
              const Icon = g.icon;
              return (
                <a
                  href={g.href}
                  class="group bg-card hover:border-primary/30 flex flex-1 items-start gap-3.5 rounded-2xl border p-5 transition-colors"
                >
                  <span class="bg-secondary flex size-9 shrink-0 items-center justify-center rounded-lg border">
                    <Icon className="text-foreground size-[18px]" strokeWidth={1.75} />
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="flex items-center gap-2">
                      <span class="text-foreground text-[14px] font-semibold">{g.name}</span>
                      <span class={cn("ml-auto shrink-0 inline-flex items-center rounded-full border px-1.5 py-px text-[10px] font-semibold", MAT_LIGHT[g.mat])}>
                        {MAT_LABEL[g.mat]}
                      </span>
                    </span>
                    <span class="text-muted-foreground mt-1 text-[12.5px] leading-5">{g.blurb}</span>
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  {/* ── CTA : la card, avec l'image derrière ── */}
  <section class="bg-secondary relative overflow-hidden border-b">
    <div aria-hidden class="pointer-events-none absolute inset-0 overflow-hidden">
      <img src="/labs/hero-wave.jpg" alt="" class="absolute inset-0 size-full object-cover object-center" />
      <div class="absolute inset-0 bg-white/45"></div>
    </div>
    <div class="container-site relative py-20 lg:py-24">
      <div class="bg-card relative mx-auto max-w-4xl overflow-hidden rounded-3xl border px-8 py-16 text-center shadow-xl sm:py-20">
        <h2 class="t-h2">Follow where this goes</h2>
        <p class="t-lead mx-auto mt-4 max-w-xl">
          The roadmap is public — hold us to it. And start with what already ships today.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/roadmap" class={cn(buttonVariants({ size: "pill-lg" }))}>See the roadmap</a>
          <a href="/product" class={cn(buttonVariants({ variant: "outline", size: "pill-lg" }))}>
            What ships today
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

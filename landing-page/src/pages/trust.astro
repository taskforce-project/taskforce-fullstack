---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import {
  ShieldCheck,
  KeyRound,
  ScrollText,
  Plug,
  Server,
  Radar,
  ArrowRight,
  Check,
  Minus,
} from "lucide-react";
import { isLive } from "@/components/site/nav";

/**
 * Trust Center — profond et HONNÊTE (review user 30/07). Plus un « security overview »
 * mais un vrai portail d'évaluation pour un RSSI / architecte sécu / procurement.
 * Règle absolue : statuts conservateurs, rien de non démontrable. Faits ancrés sur le
 * Brain OS (AES-256-GCM secrets, Keycloak OIDC, RBAC testé, GdprService réel, Semgrep/ZAP/Trivy).
 */

const CONTACT = "security@taskforce.dev";

/* Ton des pastilles de statut — la couleur ne porte jamais seule l'info (le libellé aussi). */
const TONE: Record<string, string> = {
  available: "bg-emerald-50 text-emerald-700 border-emerald-200",
  beta: "bg-amber-50 text-amber-700 border-amber-200",
  planned: "border-dashed bg-secondary text-muted-foreground",
  none: "bg-secondary text-muted-foreground",
};

/* ── Security at a glance ── */
const GLANCE: { area: string; label: string; tone: keyof typeof TONE }[] = [
  { area: "Self-hosting", label: "Available", tone: "available" },
  { area: "Encryption in transit", label: "TLS", tone: "available" },
  { area: "Secrets encrypted at rest", label: "AES-256-GCM", tone: "available" },
  { area: "SSO — OIDC", label: "Available", tone: "available" },
  { area: "Enterprise IdP federation", label: "SAML / OIDC", tone: "available" },
  { area: "RBAC & per-project access", label: "Available", tone: "available" },
  { area: "GDPR export & erasure", label: "Available", tone: "available" },
  { area: "Audit logging", label: "Available", tone: "available" },
  { area: "SAST · DAST · dependency scan", label: "In place", tone: "available" },
  { area: "Human approval gates", label: "Beta", tone: "beta" },
  { area: "AI model controls (hosted / local)", label: "Beta", tone: "beta" },
  { area: "Data retention controls", label: "Planned", tone: "planned" },
  { area: "SOC 2 / ISO 27001", label: "Not started", tone: "none" },
  { area: "Independent penetration test", label: "Not yet", tone: "none" },
];

const AI_GOV = [
  { t: "Model & provider selection", d: "Hosted models (Anthropic, OpenAI) or local models through Ollama — your choice." },
  { t: "Hosted vs local", d: "Run local models to keep every prompt and output inside your own network." },
  { t: "No training on your data", d: "Local models don't learn from your data; hosted providers are used under API terms that do not permit training on customer API data." },
  { t: "Human approval", d: "AI proposes a decision; a named human approves it. An agent can never approve its own work." },
  { t: "Model-call auditability", d: "Every call is recorded — which model, which step, on whose infrastructure." },
  { t: "Agent & connector scopes", d: "Agents act only within the connectors and permissions you explicitly grant." },
];

const IDENTITY = [
  "SSO — TaskForce authenticates through Keycloak over OIDC.",
  "Enterprise IdP federation — Keycloak can federate with your identity provider over SAML or OIDC.",
  "RBAC with workspace and project roles: Owner, Admin, Member, Viewer.",
  "Per-project access — membership is scoped, not workspace-wide by default.",
  "Session management: short-lived access tokens, refresh, revoke and provider-side logout.",
  "MFA is managed by your identity provider, not reinvented by us.",
  "Least privilege: sensitive actions are role-gated; audit logs are owner-only.",
];

const LIFECYCLE = [
  { t: "Collection", d: "Only what you connect or type into a run: repos, issues, docs and the outcomes you describe." },
  { t: "Processing", d: "During a run, the relevant context is sent to the model you selected — hosted or local." },
  { t: "Storage", d: "Workspace content and memory live in PostgreSQL; files in object storage (MinIO/S3); secrets in an encrypted store." },
  { t: "Retention", d: "Today, data is kept until you delete it. Granular retention controls are Planned." },
  { t: "Deletion", d: "Account and workspace erasure removes your data and the associated Keycloak identity." },
  { t: "Export", d: "GDPR data portability: export your workspace data on request." },
  { t: "Backups", d: "Self-hosted backups follow your own policy; managed backup guarantees are Planned." },
];

const SECRETS = [
  "OAuth for GitHub and Slack; encrypted API keys for other connectors.",
  "Connector credentials are encrypted at rest with AES-256-GCM and are never stored as plaintext database values.",
  "They are not included in the prompts sent to models.",
  "Scopes you grant define what a connector — and therefore an agent — can reach.",
  "Disconnect a connector at any time to revoke access.",
];

const SECOPS = [
  { t: "Static analysis (SAST)", d: "Semgrep runs against the codebase.", tone: "available" },
  { t: "Dynamic analysis (DAST)", d: "OWASP ZAP scans the running app.", tone: "available" },
  { t: "Dependency & container scanning", d: "Trivy checks dependencies and images.", tone: "available" },
  { t: "Latest scan · July 2026", d: "0 high-severity findings across SAST, DAST and dependency scanning at the last run.", tone: "available" },
  { t: "Responsible disclosure", d: `Report an issue to ${CONTACT} — we'll acknowledge and triage.`, tone: "available" },
  { t: "Incident response & monitoring", d: "Formal runbooks and 24/7 monitoring are Planned.", tone: "planned" },
];

const COMPLIANCE: { framework: string; status: string; tone: keyof typeof TONE }[] = [
  { framework: "GDPR", status: "Technical controls: export, erasure, anonymization", tone: "available" },
  { framework: "DPA", status: "On request", tone: "planned" },
  { framework: "Subprocessors", status: "Documented on request", tone: "planned" },
  { framework: "SOC 2", status: "Not started", tone: "none" },
  { framework: "ISO 27001", status: "Not started", tone: "none" },
];

const CURRENT = [
  "Secrets encrypted at rest (AES-256-GCM)",
  "RBAC and per-project access",
  "SSO via OIDC (Keycloak)",
  "GDPR export, erasure and anonymization",
  "Audit logging",
  "Self-hosting",
  "SAST, DAST and dependency scanning in CI",
];
const BUILDING = [
  "Run-level model-call audit trail (with orchestration)",
  "Granular data-retention controls",
  "Independent third-party penetration test",
  "DPA and a public subprocessors register",
  "SOC 2 groundwork",
];

const RESOURCES = [
  { label: "AI transparency", href: "/legal/ai-transparency" },
  { label: "Privacy policy", href: "/legal/privacy" },
  { label: "Data Processing Agreement", href: "/legal/dpa" },
  { label: "Subprocessors", href: "/legal/subprocessors" },
  { label: "Security overview", href: "/legal/security" },
  { label: "Security roadmap", href: "/roadmap" },
  { label: "Vulnerability disclosure", href: "/legal/vulnerability-disclosure" },
  { label: "Accessibility", href: "/legal/accessibility" },
];

/* Étages du flux de données. */
const FLOW = [
  { title: "Your workspace", items: ["Repos, issues, docs", "and the outcomes you describe"], tone: "plain" },
  { title: "TaskForce", items: ["Memory", "Workflow engine", "Audit trail"], tone: "primary" },
  { title: "Model provider", items: ["Anthropic", "OpenAI", "Ollama — local"], tone: "plain" },
];

---

<BaseLayout
  title="Trust center — TaskForce"
  description="Security you can verify, not just claim. How TaskForce handles data, who can do what, what every run leaves behind, and exactly where each control stands — Available, Beta, Planned or not started."
>
  <PageHero
    band
    eyebrow="Trust center"
    title="Security you can verify, not just claim"
    lead="TaskForce puts AI in your delivery path, so it should answer for it. Here is how data is handled, who can do what, and what every run leaves behind — with a public roadmap you can hold us to."
    primary={{ label: "Read the AI transparency note", href: "/legal/ai-transparency" }}
    secondary={{ label: "Book a security review", href: "/book-a-demo" }}
  />

  {/* ── 1 · Security at a glance ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">At a glance</p>
        <h2 class="t-h2">Where security stands today</h2>
        <p class="t-lead mt-4">
          No badges we haven't earned. Here is the honest status of each control — and the ones that
          aren't there yet are labelled just as plainly.
        </p>
      </div>

      <ul class="mt-10 grid gap-x-8 gap-y-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2">
        {
          GLANCE.map((row) => (
            <li class="bg-card flex items-center justify-between gap-3 px-4 py-3">
              <span class="text-[14px] text-foreground">{row.area}</span>
              <span class:list={["shrink-0 rounded-full border px-2.5 py-0.5 text-[11px] font-medium", TONE[row.tone]]}>
                {row.label}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="text-muted-foreground mt-4 text-[12.5px]">
        <span class="text-foreground font-medium">Available</span> is in production ·
        <span class="text-foreground font-medium"> Beta</span> works with rough edges ·
        <span class="text-foreground font-medium"> Planned</span> is on the roadmap ·
        <span class="text-foreground font-medium"> Not started</span> means exactly that.
      </p>
    </div>
  </section>

  {/* ── Security architecture ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Security architecture</p>
        <h2 class="t-h2">The trust boundaries, at a glance</h2>
        <p class="t-lead mt-4">
          Where authentication, your connected systems and the models sit relative to TaskForce — so
          an architect can read the model before the details.
        </p>
      </div>

      <div class="mt-10 rounded-2xl border bg-card p-6 sm:p-8">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-4">
          <div class="grid w-full gap-3 sm:grid-cols-2">
            <div class="bg-secondary/40 rounded-xl border p-4 text-center">
              <p class="text-[13px] font-semibold text-foreground">Your identity provider</p>
              <p class="text-muted-foreground mt-1 text-[11.5px]">authenticates users · OIDC</p>
            </div>
            <div class="bg-secondary/40 rounded-xl border p-4 text-center">
              <p class="text-[13px] font-semibold text-foreground">Your connected systems</p>
              <p class="text-muted-foreground mt-1 text-[11.5px]">GitHub · Linear · Slack · Postgres</p>
            </div>
          </div>

          <ArrowRight className="text-muted-foreground/50 size-5 rotate-90" />

          <div class="border-primary/30 bg-primary/[0.04] w-full rounded-xl border p-5 text-center">
            <p class="text-[14px] font-semibold text-foreground">TaskForce</p>
            <div class="mt-3 flex flex-wrap justify-center gap-2">
              {["Memory", "Workflow engine", "Audit trail"].map((x) => (
                <span class="bg-card rounded-full border px-3 py-1 text-[11.5px] text-foreground">{x}</span>
              ))}
            </div>
          </div>

          <div class="flex w-full items-center gap-3">
            <span class="bg-border h-px flex-1" />
            <span class="text-muted-foreground text-[11px] font-medium tracking-[0.08em] uppercase">
              Model boundary
            </span>
            <span class="bg-border h-px flex-1" />
          </div>

          <div class="grid w-full gap-3 sm:grid-cols-2">
            <div class="bg-secondary/40 rounded-xl border p-4 text-center">
              <p class="text-[13px] font-semibold text-foreground">Hosted model</p>
              <p class="text-muted-foreground mt-1 text-[11.5px]">Anthropic · OpenAI</p>
              <p class="mt-2 text-[11px] font-medium text-amber-700">leaves your network</p>
            </div>
            <div class="bg-secondary/40 rounded-xl border p-4 text-center">
              <p class="text-[13px] font-semibold text-foreground">Local model</p>
              <p class="text-muted-foreground mt-1 text-[11.5px]">Ollama</p>
              <p class="mt-2 text-[11px] font-medium text-emerald-700">stays in your network</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 2 · How your data flows ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Data flow</p>
        <h2 class="t-h2">Where your data goes — and where it doesn't</h2>
        <p class="t-lead mt-4">
          For an AI product this matters more than any single control. This is the path your data
          takes through a run, and what self-hosting changes about it.
        </p>
      </div>

      <div class="mt-10 rounded-2xl border bg-card p-6 sm:p-8">
        <div class="flex flex-col items-stretch gap-3 lg:flex-row lg:items-center">
          {
            FLOW.map((stage, i) => (
              <>
                <div
                  class:list={[
                    "flex-1 rounded-xl border p-4",
                    stage.tone === "primary" ? "border-primary/30 bg-primary/[0.04]" : "bg-secondary/40",
                  ]}
                >
                  <p class="text-[13.5px] font-semibold text-foreground">{stage.title}</p>
                  <ul class="mt-2 flex flex-col gap-1">
                    {stage.items.map((it) => (
                      <li class="text-muted-foreground text-[12.5px]">{it}</li>
                    ))}
                  </ul>
                </div>
                {i < FLOW.length - 1 && (
                  <div class="flex justify-center">
                    <ArrowRight className="text-muted-foreground/60 size-5 rotate-90 lg:rotate-0" />
                  </div>
                )}
              </>
            ))
          }
        </div>
        <p class="border-primary/25 bg-primary/[0.05] mt-5 flex items-start gap-2.5 rounded-lg border px-4 py-3 text-[13px] leading-6 text-foreground">
          <ShieldCheck className="text-primary mt-0.5 size-4 shrink-0" strokeWidth={2} />
          With self-hosting and local models, your model prompts, outputs and run context can remain
          entirely within your network.
        </p>
      </div>
    </div>
  </section>

  {/* ── 3 · AI security & governance ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">AI security & governance</p>
        <h2 class="t-h2">AI can propose. It cannot approve itself.</h2>
        <p class="t-lead mt-4">
          TaskForce treats the model as one component, not the authority. Every consequential step is
          a human decision, and every model call is accountable after the fact.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          AI_GOV.map((p) => (
            <div class="rounded-2xl border bg-card p-5">
              <h3 class="text-[15px] font-semibold text-foreground">{p.t}</h3>
              <p class="text-muted-foreground mt-1.5 text-[13.5px] leading-6">{p.d}</p>
            </div>
          ))
        }
      </div>
      <a href="/legal/ai-transparency" class="link-underline text-foreground mt-8 inline-flex items-center gap-1.5 text-[14px] font-medium">
        Read the full AI transparency note
        <ArrowRight className="size-4" />
      </a>
    </div>
  </section>

  {/* ── 4 · Identity & access ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,360px)_1fr] lg:gap-16">
        <div>
          <p class="t-eyebrow mb-3">Identity & access</p>
          <h2 class="t-h2">Your identity provider, your rules</h2>
          <span class="text-foreground mt-6 inline-flex size-11 items-center justify-center rounded-xl border bg-card">
            <KeyRound className="size-5" strokeWidth={1.75} />
          </span>
        </div>
        <ul class="flex flex-col gap-3.5">
          {
            IDENTITY.map((it) => (
              <li class="flex items-start gap-3 text-[14px] leading-6 text-foreground">
                <Check className="text-primary mt-[3px] size-4 shrink-0" strokeWidth={2.5} />
                {it}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── 5 · Data lifecycle ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Data lifecycle</p>
        <h2 class="t-h2">From collection to deletion</h2>
        <p class="t-lead mt-4">
          The questions a security questionnaire asks — answered up front, including the parts that
          are still on the roadmap.
        </p>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
        {
          LIFECYCLE.map((s) => (
            <div class="bg-card p-5">
              <p class="text-muted-foreground text-[11px] font-semibold tracking-[0.08em] uppercase">{s.t}</p>
              <p class="mt-2 text-[13.5px] leading-6 text-foreground">{s.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── 6 · Auditability & monitoring ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Auditability</p>
        <h2 class="t-h2">What every run leaves behind</h2>
        <p class="t-lead mt-4">
          A fair question for any AI tool: “so you log my prompts and outputs?” Here is the honest
          answer.
        </p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border bg-card p-6">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-foreground">
            <ScrollText className="text-primary size-4" strokeWidth={2} /> What is recorded
          </p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {["Who approved what, and when", "Which model ran which step, on whose infrastructure", "Workspace, project, timestamp, token usage and status", "Run artifacts — the drafts an agent produced, kept for your review"].map((x) => (
              <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                <Check className="text-primary mt-[3px] size-3.5 shrink-0" strokeWidth={2.5} />
                {x}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border bg-card p-6">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-foreground">
            <ShieldCheck className="text-primary size-4" strokeWidth={2} /> What stays in your hands
          </p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {["With local models, prompts and outputs never leave your network", "You choose the provider per deployment — or none but local", "Audit access is owner-only, not open to every member", "Run artifacts live in your workspace, deletable with it"].map((x) => (
              <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                <Check className="text-primary mt-[3px] size-3.5 shrink-0" strokeWidth={2.5} />
                {x}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 7 · Integrations & secrets ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Integrations & secrets</p>
        <h2 class="t-h2">What can an agent do with the keys you give it?</h2>
        <p class="t-lead mt-4">
          The real question isn't only “can TaskForce be breached?” — it's what an agent can reach
          with your connected credentials. Here is how they're contained.
        </p>
      </div>
      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_minmax(0,360px)] lg:gap-16">
        <ul class="flex flex-col gap-3.5">
          {
            SECRETS.map((it) => (
              <li class="flex items-start gap-3 text-[14px] leading-6 text-foreground">
                <Check className="text-primary mt-[3px] size-4 shrink-0" strokeWidth={2.5} />
                {it}
              </li>
            ))
          }
        </ul>
        <div class="border-primary/25 bg-primary/[0.04] flex flex-col justify-center rounded-2xl border p-6">
          <Plug className="text-primary size-5" strokeWidth={1.75} />
          <p class="mt-3 text-[14px] leading-6 text-foreground">
            An agent inherits the <span class="font-medium">scopes of the connector</span>, nothing
            more — and never the raw secret behind it.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 8 · Infrastructure & self-hosting ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Infrastructure</p>
        <h2 class="t-h2">Deployment models</h2>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border bg-card p-6">
          <div class="flex items-center gap-2.5">
            <Server className="text-foreground size-5" strokeWidth={1.75} />
            <h3 class="text-[16px] font-semibold text-foreground">Self-hosted</h3>
            <span class:list={["ml-auto rounded-full border px-2.5 py-0.5 text-[11px] font-medium", TONE.available]}>Available</span>
          </div>
          <p class="text-muted-foreground mt-3 text-[13.5px] leading-6">
            Run TaskForce inside your own infrastructure with Docker. With local models, model
            traffic stays entirely inside your network.
          </p>
        </div>
        <div class="rounded-2xl border bg-card p-6">
          <div class="flex items-center gap-2.5">
            <Server className="text-muted-foreground size-5" strokeWidth={1.75} />
            <h3 class="text-[16px] font-semibold text-foreground">Managed cloud</h3>
            <span class:list={["ml-auto rounded-full border px-2.5 py-0.5 text-[11px] font-medium", TONE.planned]}>Planned</span>
          </div>
          <p class="text-muted-foreground mt-3 text-[13.5px] leading-6">
            A TaskForce-managed deployment is on the roadmap. Until it ships, self-hosting is the way
            to run in production.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Threat model & shared responsibility ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Threat model</p>
        <h2 class="t-h2">What we defend, and what's yours to defend</h2>
        <p class="t-lead mt-4">
          Security is shared — especially when you self-host. Here is the honest split of
          responsibility.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border bg-card p-6">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-foreground">
            <ShieldCheck className="text-primary size-4" strokeWidth={2} /> What TaskForce protects against
          </p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {["Unauthorized workspace access", "Credential exposure", "Agent overreach beyond granted scopes", "Cross-project data access", "Prompt and context leakage", "Unauthorized model calls", "Malicious connector actions"].map((x) => (
              <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                <Check className="text-primary mt-[3px] size-3.5 shrink-0" strokeWidth={2.5} />
                {x}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border bg-card p-6">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-foreground">
            <Server className="text-muted-foreground size-4" strokeWidth={2} /> What remains your responsibility
          </p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {["Your own infrastructure and its hardening", "Your identity provider and its MFA policy", "The connector permissions you grant", "Local model hosting and its security", "Host, network and backup security when self-hosted"].map((x) => (
              <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                <Minus className="text-muted-foreground/60 mt-[5px] size-3 shrink-0" strokeWidth={3} />
                {x}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 9 · Compliance & certifications ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Compliance</p>
        <h2 class="t-h2">Compliance & certifications</h2>
        <p class="t-lead mt-4">
          Stated conservatively on purpose. We won't imply a certification we don't hold — if a row
          says “Not started,” that's the truth.
        </p>
      </div>
      <ul class="mt-10 overflow-hidden rounded-2xl border bg-border grid gap-px">
        {
          COMPLIANCE.map((c) => (
            <li class="bg-card flex flex-wrap items-center justify-between gap-3 px-5 py-4">
              <span class="text-[14.5px] font-medium text-foreground">{c.framework}</span>
              <span class="flex items-center gap-2.5">
                <span
                  aria-hidden
                  class:list={["size-1.5 shrink-0 rounded-full", c.tone === "available" ? "bg-emerald-500" : c.tone === "none" ? "bg-[#d4d4da]" : "bg-amber-400"]}
                />
                <span class="text-muted-foreground text-[13px]">{c.status}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── 10 · Security operations ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Security operations</p>
        <h2 class="t-h2">How the code is kept honest</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          SECOPS.map((s) => (
            <div class="rounded-2xl border bg-card p-5">
              <div class="flex items-center gap-2">
                <Radar className="text-primary size-4 shrink-0" strokeWidth={2} />
                <h3 class="text-[14px] font-semibold text-foreground">{s.t}</h3>
              </div>
              <p class="text-muted-foreground mt-2 text-[13px] leading-6">{s.d}</p>
              <span class:list={["mt-3 inline-flex rounded-full border px-2 py-0.5 text-[10px] font-medium", TONE[s.tone as keyof typeof TONE]]}>
                {s.tone === "available" ? "In place" : "Planned"}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── 11 · Security roadmap ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Security roadmap</p>
        <h2 class="t-h2">The security roadmap is public too</h2>
        <p class="t-lead mt-4">
          The honest way to avoid security theater: show what's live, and what we're still building.
        </p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border bg-card p-6">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-foreground">
            <span class="size-2.5 rounded-full bg-emerald-500" aria-hidden /> Current
          </p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {CURRENT.map((x) => (
              <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                <Check className="text-primary mt-[3px] size-3.5 shrink-0" strokeWidth={2.5} />
                {x}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border bg-card p-6">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-foreground">
            <span class="size-2.5 rounded-full bg-amber-400" aria-hidden /> Building
          </p>
          <ul class="mt-4 flex flex-col gap-2.5">
            {BUILDING.map((x) => (
              <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                <Minus className="text-muted-foreground/60 mt-[5px] size-3 shrink-0" strokeWidth={3} />
                {x}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 12 · Security resources ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Security resources</p>
        <h2 class="t-h2">Documentation hub</h2>
        <p class="t-lead mt-4">
          Everything a review needs, in one place. Public where possible, available on request where
          appropriate.
        </p>
      </div>
      <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          RESOURCES.map((r) => {
            const live = isLive(r.href);
            return live ? (
              <li>
                <a href={r.href} class="group bg-card hover:border-primary/30 flex items-center justify-between gap-2 rounded-xl border px-4 py-3 transition-colors">
                  <span class="text-[14px] font-medium text-foreground">{r.label}</span>
                  <ArrowRight className="text-muted-foreground group-hover:text-primary size-4 transition-colors" />
                </a>
              </li>
            ) : (
              <li>
                <div class="bg-card flex items-center justify-between gap-2 rounded-xl border px-4 py-3 opacity-60" aria-disabled="true">
                  <span class="text-[14px] font-medium text-foreground">{r.label}</span>
                  <span class="text-muted-foreground/70 rounded border border-dashed px-1.5 py-px text-[9px] font-semibold tracking-wide uppercase">
                    Coming soon
                  </span>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <PageCta
    title="Bring it to your security team"
    lead="Send us your security questionnaire, or book a review and we'll walk your team through the architecture, the controls and the roadmap — including the parts that aren't done yet."
    primary={{ label: "Book a security review", href: "/book-a-demo" }}
    secondary={{ label: "Read the AI transparency note", href: "/legal/ai-transparency" }}
    note={`Security contact — ${CONTACT}`}
  />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import PageCta from "@/components/site/PageCta.astro";
import { Brain, ShieldCheck, Server, GitBranch } from "lucide-react";
import { APP_URL } from "@/components/site/nav";
import { hueFor } from "@/lib/site-icons";

const BELIEFS = [
  {
    icon: ShieldCheck,
    title: "AI proposes, humans decide",
    text: "Putting AI in the delivery path only works if a person stays accountable. Approval is part of the workflow, not a setting.",
  },
  {
    icon: Brain,
    title: "Context is the product",
    text: "Most delivery tools track what happened. The hard part — and the real value — is keeping the reasoning behind it.",
  },
  {
    icon: Server,
    title: "Your infrastructure, your models",
    text: "Self-hosting and model choice stay first-class — available with Enterprise, so where your data and models run is your decision.",
  },
  {
    icon: GitBranch,
    title: "Built on the tools you trust",
    text: "TaskForce sits on your board, your repo and the coding agents you already use — it doesn't ask you to start over.",
  },
];
---

<BaseLayout
  title="About — TaskForce"
  description="TaskForce is building the decision infrastructure for AI-native software delivery: a governed path from intent to production, where AI proposes, humans decide, and the reasoning is kept."
>
  <PageHero
    eyebrow="About"
    title="Software delivery keeps losing its context. We're rebuilding it."
    lead="TaskForce is building the decision infrastructure for AI-native delivery — a governed path from a product outcome to production, where AI drafts the work, a human approves every step, and the reasoning behind each decision is kept."
    primary={{ label: "Run your first workflow", href: "/waitlist" }}
    secondary={{ label: "See the run", href: "/product/orchestration" }}
  />

  {/* ── Why we exist ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="mx-auto max-w-2xl">
        <p class="t-eyebrow mb-3">Why we exist</p>
        <h2 class="t-h2">AI can generate the work. Someone still has to own the decisions.</h2>
        <div class="mt-6 flex flex-col gap-5 text-[15px] leading-7 text-foreground">
          <p>
            A software project isn't one task for an AI to complete. It's a chain of decisions that
            compound — what to build, how to build it, in what order, at what risk. Generating a
            specification is easy now. Keeping the chain coherent, exposing the trade-offs and staying
            accountable is not.
          </p>
          <p class="text-muted-foreground">
            Today that context lives in people's heads, in chat threads and in meetings — and it leaks
            at every handoff. TaskForce exists to make it durable: a system where every decision has a
            reason attached, a human signs off on it, and the next step starts from what was actually
            decided.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── What we believe ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">What we believe</p>
        <h2 class="t-h2">The principles we build to</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          BELIEFS.map((b) => (
            <div class="border bg-card p-6">
              <span class="ic-tile flex size-11 items-center justify-center rounded-xl border" style={`--ic:${hueFor(b.icon)}`}>
                <b.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[16px] font-semibold text-foreground">{b.title}</h3>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Where we are (honnête) ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="mx-auto max-w-2xl">
        <p class="t-eyebrow mb-3">Where we are</p>
        <h2 class="t-h2">Early, and honest about it</h2>
        <div class="mt-6 flex flex-col gap-5 text-[15px] leading-7 text-foreground">
          <p>
            TaskForce is a young product. The delivery foundation — boards, issues, cycles, real-time
            collaboration, smart assignment, analytics and the memory layer — ships today. The full
            governed orchestration is the direction we're building toward, and we mark clearly what's
            Live, what's Beta and what's Planned.
          </p>
          <p class="text-muted-foreground">
            We'd rather show an honest, public roadmap than a polished promise. You can read exactly where each
            capability stands, and hold us to it.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/roadmap" class="link-underline text-foreground text-[14px] font-medium">
            See the public roadmap →
          </a>
          <a href="/trust" class="link-underline text-muted-foreground hover:text-foreground text-[14px]">
            Trust Center →
          </a>
        </div>
      </div>
    </div>
  </section>

  <PageCta
    title="Build delivery that remembers why"
    lead="Start with what ships today — a governed delivery workspace, free — and grow into the rest as it lands."
    primary={{ label: "Run your first workflow", href: "/waitlist" }}
    secondary={{ label: "Book a demo", href: "/book-a-demo" }}
  />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import {
  Server,
  ShieldCheck,
  SlidersHorizontal,
  KeyRound,
  Database,
  Plug,
  Boxes,
  Cpu,
  BrainCircuit,
  Bot,
  ArrowRight,
  Check,
} from "lucide-react";
import { APP_URL } from "@/components/site/nav";

/* ── 3 piliers (regroupés : déploiement / gouvernance / contrôle) ── */
const PILLARS = [
  {
    icon: Server,
    title: "Deploy privately",
    points: [
      "Self-host the entire platform on your own network",
      "Keep model inference local with Ollama",
      "Your infrastructure, your models, your data",
    ],
  },
  {
    icon: ShieldCheck,
    title: "Govern every run",
    points: [
      "A human approves each checkpoint",
      "RBAC and per-project access scope who can do what",
      "A full audit trail: who approved what, when, which model",
    ],
  },
  {
    icon: SlidersHorizontal,
    title: "Control your data and models",
    points: [
      "Choose hosted or local models, per step",
      "Your data is not used to train TaskForce models",
      "Agents get only the connector scopes you grant",
    ],
  },
  {
    icon: Plug,
    title: "Fit your existing stack",
    points: [
      "Connect the identity providers you already use",
      "Repositories, trackers and chat via connectors",
      "Hosted or local model providers",
    ],
  },
];

/* ── Built for your environment ── */
const ENV = [
  { icon: KeyRound, label: "Identity", items: "Keycloak · OIDC · SAML" },
  { icon: Boxes, label: "Runtime", items: "Docker · Docker Compose" },
  { icon: Cpu, label: "Models", items: "Anthropic · OpenAI · Ollama · local" },
  { icon: Database, label: "Data", items: "PostgreSQL · S3 / MinIO" },
  { icon: Plug, label: "Integrations", items: "GitHub · GitLab · Linear · Slack · +125 more" },
];

/* ── Enterprise controls — contrôle par couche ── */
const CONTROLS = [
  { layer: "Identity", control: "OIDC / SAML / IdP federation" },
  { layer: "Access", control: "RBAC + project-level permissions" },
  { layer: "AI", control: "Hosted or local models, per step" },
  { layer: "Data", control: "Private infrastructure + retention controls" },
  { layer: "Delivery", control: "Human approval at every checkpoint" },
  { layer: "Audit", control: "Run, approval and model-call history" },
  { layer: "Deployment", control: "Self-hosted" },
  { layer: "Security", control: "Security review + DPA" },
  { layer: "Operations", control: "Dedicated support + SLA" },
];

/* ── Deploy your way ── */
const DEPLOY = [
  { title: "Self-hosted", text: "Run TaskForce inside your network with Docker." },
  { title: "Private models", text: "Keep inference inside your infrastructure with Ollama or other local providers." },
  { title: "Enterprise deployment", text: "Work with your team to map identity, networking, storage, secrets and model access." },
];

/* ── Parcours d'adoption ── */
const STEPS = [
  { n: "01", title: "Architecture review", text: "We map identity, data flows, connectors and model providers." },
  { n: "02", title: "Deployment", text: "Your team deploys TaskForce in your environment, with our assistance." },
  { n: "03", title: "Security validation", text: "Review controls, permissions, data flows and retention." },
  { n: "04", title: "First workflow", text: "Start with one delivery workflow, validate the operating model, and expand from there." },
];

/* ── Why TaskForce (build vs buy) ── */
const WHY = [
  { icon: ShieldCheck, title: "Governed by default", text: "Human approval, attribution and auditability are built into the workflow." },
  { icon: Cpu, title: "Your models", text: "Run local models on your own infrastructure, or switch hosted providers — without rebuilding your delivery system." },
  { icon: BrainCircuit, title: "Context-aware", text: "TaskForce Memory carries architectural decisions, constraints and conventions into every run." },
  { icon: Bot, title: "Built around your agents", text: "Use Claude Code, Cursor or the coding agent your team already trusts." },
];
---

<BaseLayout
  title="Enterprise — TaskForce"
  description="TaskForce for engineering organizations: private deployment, governance at every run, and full control of your data and models — with a clear path from architecture review to first workflow."
>
  <PageHero
    kicker="Enterprise"
    title="AI in your delivery path, on your terms"
    lead="TaskForce keeps a human accountable at every checkpoint and can run entirely on your own infrastructure — so you get agent leverage without giving up control, attribution or ownership of your data."
    primary={{ label: "Book a demo", href: "/book-a-demo" }}
    secondary={{ label: "Read the trust center", href: "/trust" }}
  />

  {/* ── 3 piliers ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Why Enterprise</p>
        <h2 class="t-h2">Agent leverage a security team can sign off on</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          PILLARS.map((p) => (
            <div class="rounded-2xl border bg-card p-6">
              <span class="bg-card text-foreground flex size-11 items-center justify-center rounded-xl border">
                <p.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[16px] font-semibold text-foreground">{p.title}</h3>
              <ul class="mt-3 flex flex-col gap-2.5">
                {p.points.map((pt) => (
                  <li class="text-muted-foreground flex items-start gap-2 text-[13.5px] leading-6">
                    <Check className="text-primary mt-[3px] size-4 shrink-0" strokeWidth={2.5} />
                    {pt}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Built for your environment ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Built for your environment</p>
        <h2 class="t-h2">Fits the infrastructure you already run</h2>
        <p class="t-lead mt-4">
          TaskForce sits inside the infrastructure you already control. Connect the identity provider,
          repositories, trackers and model providers your organization already uses.
        </p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          ENV.map((e) => (
            <div class="rounded-2xl border bg-card p-5">
              <span class="bg-secondary/60 text-foreground flex size-10 items-center justify-center rounded-lg border">
                <e.icon className="size-5" strokeWidth={1.75} />
              </span>
              <p class="mt-3 text-[14px] font-semibold text-foreground">{e.label}</p>
              <p class="text-muted-foreground mt-1 text-[12.5px] leading-5">{e.items}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Architecture ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Architecture</p>
        <h2 class="t-h2">How TaskForce sits in your stack</h2>
        <p class="t-lead mt-4">
          Authentication in front, your systems and models around it, and everything that happens in
          between left auditable.
        </p>
      </div>

      <div class="mt-10 rounded-2xl border bg-card p-6 sm:p-8">
        <div class="mx-auto flex max-w-3xl flex-col items-center">
          <div class="bg-secondary/40 rounded-xl border px-4 py-3 text-center">
            <p class="text-[13px] font-semibold text-foreground">Your identity provider</p>
            <p class="text-muted-foreground mt-0.5 text-[11.5px]">OIDC / SAML</p>
          </div>

          <ArrowRight className="text-muted-foreground/50 my-3 size-5 rotate-90" />

          <div class="border-primary/30 bg-primary/[0.04] w-full rounded-2xl border p-5 text-center">
            <p class="text-[14px] font-semibold text-foreground">TaskForce</p>
            <div class="mt-3 flex flex-wrap justify-center gap-2">
              {["Governance", "Memory", "Orchestration"].map((x) => (
                <span class="bg-card rounded-full border px-3 py-1 text-[11.5px] font-medium text-foreground">
                  {x}
                </span>
              ))}
            </div>
            <p class="text-muted-foreground mt-2 text-[11px]">Approval · Context · Audit trail</p>
          </div>

          <ArrowRight className="text-muted-foreground/50 my-3 size-5 rotate-90" />

          <div class="grid w-full gap-3 sm:grid-cols-3">
            {
              [
                { t: "Connected systems", d: "GitHub · Linear · Slack" },
                { t: "Data", d: "PostgreSQL · S3 / MinIO" },
                { t: "Models", d: "Hosted · Local" },
              ].map((n) => (
                <div class="bg-secondary/40 rounded-xl border p-4 text-center">
                  <p class="text-[13px] font-semibold text-foreground">{n.t}</p>
                  <p class="text-muted-foreground mt-0.5 text-[11.5px]">{n.d}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Enterprise controls (par couche) ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Enterprise controls</p>
        <h2 class="t-h2">Control at every layer</h2>
      </div>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
        {
          CONTROLS.map((c) => (
            <li class="bg-card flex flex-col gap-1 px-5 py-4">
              <span class="text-muted-foreground text-[11px] font-semibold tracking-[0.08em] uppercase">
                {c.layer}
              </span>
              <span class="text-[13.5px] leading-5 text-foreground">{c.control}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Why TaskForce (build vs buy) ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Why TaskForce</p>
        <h2 class="t-h2">Don't build the governance layer yourself</h2>
        <p class="t-lead mt-4">
          Your team could assemble model providers, workflow engines, approval systems, audit logs
          and connector permissions independently. TaskForce puts those pieces behind one governed
          delivery workflow — so your team can focus on shipping, not maintaining the orchestration
          layer.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          WHY.map((w) => (
            <div class="rounded-2xl border bg-card p-5">
              <span class="bg-secondary/60 text-foreground flex size-10 items-center justify-center rounded-lg border">
                <w.icon className="size-5" strokeWidth={1.75} />
              </span>
              <h3 class="mt-4 text-[15px] font-semibold text-foreground">{w.title}</h3>
              <p class="text-muted-foreground mt-1.5 text-[13.5px] leading-6">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Deploy your way ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Deployment</p>
        <h2 class="t-h2">Deploy your way</h2>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          DEPLOY.map((d) => (
            <div class="rounded-2xl border bg-card p-6">
              <Server className="text-primary size-5" strokeWidth={1.75} />
              <h3 class="mt-4 text-[16px] font-semibold text-foreground">{d.title}</h3>
              <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{d.text}</p>
            </div>
          ))
        }
      </div>
      <p class="text-muted-foreground mt-6 text-[13px]">
        <span class="text-foreground font-medium">Docker Compose today.</span> Kubernetes deployment
        support is on the roadmap.
      </p>
    </div>
  </section>

  {/* ── Security & compliance (reformulée, prudente) ── */}
  <section class="bg-secondary border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,420px)_1fr] lg:gap-16">
        <div>
          <p class="t-eyebrow mb-3">Security & compliance</p>
          <h2 class="t-h2">No certification claims we can't substantiate</h2>
          <p class="t-lead mt-4">
            TaskForce documents the controls, data flows and security roadmap so your team can
            evaluate the current state before deployment.
          </p>
          <a
            href="/trust"
            class="link-underline text-foreground mt-6 inline-flex items-center gap-1.5 text-[14px] font-medium"
          >
            Open the trust center
            <ArrowRight className="size-4" />
          </a>
        </div>

        <div class="flex flex-col gap-4">
          <div class="bg-card rounded-2xl border p-5">
            <p class="text-[14px] font-semibold text-foreground">Your data</p>
            <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">
              TaskForce does not use your data to train its own models. For hosted providers, data
              handling follows the provider and your configured service terms; local models keep
              inference within your infrastructure.
            </p>
          </div>
          <div class="bg-border flex flex-col gap-px overflow-hidden rounded-2xl border">
            {
              [
                { k: "GDPR", v: "Technical controls for export, erasure and data handling are in place." },
                { k: "SOC 2", v: "Not certified. SOC 2 groundwork is on the roadmap." },
                { k: "DPA", v: "Available on request." },
              ].map((x) => (
                <div class="bg-card px-4 py-3.5">
                  <p class="text-[13.5px] font-semibold text-foreground">{x.k}</p>
                  <p class="text-muted-foreground mt-0.5 text-[12.5px] leading-5">{x.v}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── What happens next ── */}
  <section class="bg-card border-b">
    <div class="container-rail py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="t-eyebrow mb-3">Adoption</p>
        <h2 class="t-h2">From security review to first run</h2>
        <p class="t-lead mt-4">
          A clear path, so adopting TaskForce is a project with steps — not a leap of faith.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          STEPS.map((s) => (
            <div class="rounded-2xl border bg-card p-6">
              <span class="text-primary font-mono text-[13px] tabular-nums">{s.n}</span>
              <h3 class="mt-2 text-[15px] font-semibold text-foreground">{s.title}</h3>
              <p class="text-muted-foreground mt-1.5 text-[13.5px] leading-6">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── CTA + funnel ── */}
  <section class="bg-secondary">
    <div class="container-rail py-24">
      <div class="bg-card relative overflow-hidden rounded-3xl border px-8 py-16 text-center sm:py-20">
        <div
          aria-hidden
          class="pointer-events-none absolute top-0 left-1/2 h-72 w-[680px] -translate-x-1/2 rounded-full blur-3xl"
          style="background: radial-gradient(50% 50% at 50% 50%, color-mix(in oklab, var(--primary) 14%, transparent), transparent 70%)"
        >
        </div>
        <h2 class="t-h2 relative">Bring TaskForce to your organization</h2>
        <p class="t-lead relative mx-auto mt-4 max-w-lg">
          Book a call and we'll map the architecture, the controls and a deployment that fits your
          environment.
        </p>
        <div class="relative mt-8 flex flex-wrap justify-center gap-3">
          <a href="/book-a-demo" class={cn(buttonVariants({ size: "pill-lg" }))}>Book a demo</a>
          <a href="/trust" class={cn(buttonVariants({ variant: "outline", size: "pill-lg" }))}>
            Read the trust center
          </a>
        </div>
      </div>
      <p class="text-muted-foreground mt-6 text-center text-[13px]">
        Not ready for Enterprise?{" "}
        <a href="/pricing" class="link-underline text-foreground font-medium">
          Start with the delivery workspace →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

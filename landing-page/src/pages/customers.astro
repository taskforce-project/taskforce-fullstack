---
import AudienceTracking from "@/components/AudienceTracking.astro";
import "@/styles/global.css";
import "@/styles/accessibility.css";
import CustomersPage from "@/components/CustomersPage";
import { Header, Footer } from "@/components/layout/";

const title = "Customers - Taskforce";
const description = "Trusted by 50,000+ teams worldwide. See how companies like Hypersonica, Foxsense, MinimalArt and more use Taskforce.";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <AudienceTracking />
  </head>
  <body class="min-h-screen bg-[#0a0a0a] font-sans antialiased">
    <Header client:load />
    <CustomersPage client:load />
    <Footer client:load />
  </body>
</html>

---
/**
 * Migrate : passer de la webapp hébergée à l'app desktop. Les libellés de l'export sont ceux de la webapp
 * (barre d'outils du projet, Réglages > Privacy & Data) ; le contenu de l'export suit `ProjectExportService`.
 * À tenir à jour : date de fermeture (WEB_APP_CLOSES) et la liste MISSING si un export Brain OS arrive. Les étapes
 * forment une suite : elles sont numérotées, en frise.
 */
import { ArrowRight, Check, Minus } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import SectionHead from "@/components/site/SectionHead.astro";
import Pill from "@/components/site/Pill.astro";
import Faq, { type FaqItem } from "@/components/site/Faq.astro";
import CtaBand from "@/components/site/CtaBand.astro";
import MigrateFlow from "@/components/visuals/MigrateFlow";
import { formatDate } from "@/lib/release";

/** Date de fermeture de la webapp (AAAA-MM-JJ), null tant qu'elle n'est pas fixée. */
const WEB_APP_CLOSES: string | null = null;
const WEB_APP_HOST = "app.taskforce-project.fr";

const STEPS = [
  { n: "01", t: "Install the desktop app", d: "Download TaskForce for Windows or Linux (macOS soon).", dot: "bg-tint-blue text-ink-blue" },
  {
    n: "02",
    t: "Sign in with your account",
    d: "Use the email address and password you use on the web app. Your account stays the same.",
    dot: "bg-tint-green text-ink-green",
  },
  {
    n: "03",
    t: "Bring your projects",
    d: "TaskForce sees your web app projects and asks whether to bring them to this computer. Say yes, and they arrive with their comments and history.",
    dot: "bg-tint-pink text-ink-pink",
  },
  {
    n: "04",
    t: "Save what doesn't move",
    d: "Before the web app closes, copy the Brain OS pages and download the attachments you want to keep. The list is below.",
    dot: "bg-tint-yellow text-ink-yellow",
  },
];

const INCLUDED = [
  "Every issue, with its title, description, status, priority and labels",
  "Dates, story points and subtasks",
  "Comments, and each issue's history",
];

const MISSING = [
  { t: "Brain OS pages", d: "Copy the pages you want to keep before the web app closes." },
  { t: "Attachments", d: "Download the files attached to your issues." },
  { t: "Cycles, checklists and time entries", d: "Note what you still need, then recreate it in the app." },
  { t: "Connections and AI settings", d: "Connect GitHub and your tools again, and choose your AI on first launch." },
];

const FAQ: FaqItem[] = [
  {
    q: "Why is the web app closing?",
    a: "TaskForce is becoming a desktop app: your projects on your own computer, instead of on our servers. It is free and open source.",
  },
  {
    q: "What happens to the data left on the web app?",
    a: "Your projects on the web app are deleted when it closes. Your account stays, so you keep signing in to the desktop app with it.",
  },
  {
    q: "Will you tell me before it closes?",
    a: "Yes. Every web app account receives an email before the web app closes, with the date and the steps on this page.",
  },
  {
    q: "Can my team keep working together?",
    a: "The desktop app is made for one person, with no sync between computers. Each teammate can install it and import the projects they work on.",
  },
  {
    q: "Can I keep a copy of my account data?",
    a: "Yes. In the web app, open Settings, then Privacy & Data, and click Export my data. You get a JSON file with your personal data.",
  },
  {
    q: "I prefer a spreadsheet. Is there another format?",
    a: "Yes. In the web app, a project's Export menu offers CSV (issues and details): one row per issue, ready for any spreadsheet.",
  },
];
---

<BaseLayout
  title="Moving from the TaskForce web app to the desktop app | TaskForce"
  description="The TaskForce web app is closing. Export your projects, install the desktop app and import them: here is how, and what to save by hand."
>
  <PageHero
    bg="migrate"
    label="Moving from the web app"
    lead={`The TaskForce web app at ${WEB_APP_HOST} is closing. TaskForce goes on as a free desktop app, with your projects on your own computer. Your account stays: sign in with it, and bring your work along.`}
  >
    <Fragment slot="title">Bring your projects <span class="t-word">to your desktop.</span></Fragment>
    <p class="anim-fade-up mt-8 inline-flex items-center gap-2.5 rounded-full bg-white/80 px-4 py-2.5 text-[14.5px] shadow-sm ring-1 ring-black/5 backdrop-blur" style="--d: 200ms">
      <span class="relative flex size-2.5">
        <span class="anim-pulse-ring absolute inline-flex size-full rounded-full bg-shape-yellow"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-shape-yellow"></span>
      </span>
      {
        WEB_APP_CLOSES ? (
          <span>
            The web app closes on <strong class="font-semibold">{formatDate(WEB_APP_CLOSES)}</strong>.
          </span>
        ) : (
          <span>The closing date will be posted on this page.</span>
        )
      }
    </p>
  </PageHero>

  <section class="pt-10">
    <div class="container-wide anim-fade-up" style="--d: 260ms">
      <MigrateFlow client:visible host={WEB_APP_HOST} />
    </div>
  </section>

  {/* ───────── Les étapes ───────── */}
  <section class="section">
    <div class="container-site">
      <SectionHead label="Step by step" tone="yellow">
        <Fragment slot="title">Four steps <span class="t-word">to move over.</span></Fragment>
      </SectionHead>
      <ol class="mt-14 grid gap-10 sm:mt-16 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          STEPS.map((s, i) => (
            <li class="relative flex flex-col" data-reveal style={`--d: ${i * 80}ms`}>
              {i < STEPS.length - 1 && <span class="absolute top-[18px] right-[-2rem] left-12 hidden h-px bg-border lg:block" aria-hidden="true" />}
              <span class:list={["flex size-9 items-center justify-center rounded-full text-[14px] font-medium", s.dot]}>{i + 1}</span>
              <p class="t-h4 mt-5">{s.t}</p>
              <p class="t-small mt-2">{s.d}</p>
              {s.n === "01" && (
                <a href="/download" class="link-arrow mt-5 text-[15px]">
                  Download <ArrowRight aria-hidden="true" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ───────── Ce qui passe, ce qui ne passe pas ───────── */}
  <section class="section pt-0!">
    <div class="container-site">
      <SectionHead label="What comes with you" tone="green">
        <Fragment slot="title">Know what moves, <span class="t-word">and what doesn't.</span></Fragment>
      </SectionHead>
      <div class="mt-14 grid gap-5 sm:mt-16 lg:grid-cols-2">
        <article class="wash wash-green p-8 sm:p-10" data-reveal>
          <p class="t-label text-ink-green">Brought to your computer</p>
          <ul class="mt-6 flex flex-col gap-3.5">
            {
              INCLUDED.map((t) => (
                <li class="flex items-start gap-3 text-[16px] leading-relaxed">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-white text-ink-green">
                    <Check className="size-3.5" strokeWidth={2.6} aria-hidden="true" />
                  </span>
                  {t}
                </li>
              ))
            }
          </ul>
        </article>
        <article class="card p-8 sm:p-10" data-reveal style="--d: 100ms">
          <p class="t-label">Save or redo by hand</p>
          <ul class="mt-6 flex flex-col gap-4">
            {
              MISSING.map((m) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-white text-subtle">
                    <Minus className="size-3.5" strokeWidth={2.6} aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block text-[16px] font-medium">{m.t}</span>
                    <span class="t-small mt-0.5 block">{m.d}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </section>

  {/* ───────── FAQ ───────── */}
  <section class="section pt-0!">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal>
        <Pill tone="neutral">Questions</Pill>
        <h2 class="t-h2 mt-6">About <span class="t-word">the move.</span></h2>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>

  <CtaBand title="Ready when you are." text="Install TaskForce, sign in with your account and pick up where you left off." />
</BaseLayout>

---
// /docs redirige vers la documentation TaskForce (Fern, hebergee sur le cloud Fern).
// L'ancienne page « Start here » est remplacee : la vraie doc (guides + reference API) vit
// desormais sur docs.taskforce-project.fr. On garde la route /docs (menu « Documentation »)
// comme point d'entree stable qui redirige. Build statique -> redirection meta-refresh + JS.
const DEST = "https://docs.taskforce-project.fr";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${DEST}`} />
    <link rel="canonical" href={DEST} />
    <meta name="robots" content="noindex, follow" />
    <title>Documentation TaskForce</title>
    <script is:inline define:vars={{ DEST }}>
      window.location.replace(DEST);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Inter, "SF Pro Text", -apple-system, system-ui, sans-serif;
        background: #fbfbfc;
        color: #1d1d1f;
      }
      a { color: #2563eb; }
      @media (prefers-color-scheme: dark) {
        body { background: #0b0b0c; color: #f5f5f7; }
        a { color: #3b82f6; }
      }
    </style>
  </head>
  <body>
    <p>Redirection vers la documentation TaskForce&nbsp;: <a href={DEST}>{DEST}</a></p>
  </body>
</html>

---
/** Page introuvable : hors index, retour vers les pages utiles. */
import { ArrowRight } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Backdrop from "@/components/site/Backdrop.astro";
---

<BaseLayout title="Page not found | TaskForce" description="This page doesn't exist or has moved." noindex>
  <section class="relative -mt-16 pt-16">
    <Backdrop name="agents" class="inset-x-0 top-0 h-full" fade veil="center" priority />
    <div class="container-site flex min-h-[60vh] flex-col justify-center py-24">
      <span class="pill self-start" data-tone="glass">Error 404</span>
      <h1 class="t-h1 mt-5 max-w-2xl">This page <span class="t-word">doesn't exist.</span></h1>
      <p class="t-lead mt-6 max-w-xl">
        It may have moved when TaskForce became a desktop app. These pages are a good place to start.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/" class="btn btn-primary">Back to the home page</a>
        <a href="/download" class="link-arrow text-[15px]">Download <ArrowRight className="size-4" aria-hidden="true" /></a>
        <a href="/features" class="link-arrow text-[15px]">Features <ArrowRight className="size-4" aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

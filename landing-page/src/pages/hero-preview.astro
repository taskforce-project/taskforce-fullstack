---
// DEV HARNESS — aperçu isolé de l'above-fold (header + hero), à supprimer avant commit.
// Le Hero est hydraté (client:load) pour la simulation live + onglets interactifs.
import "@/styles/global.css";
import { SiteHeader } from "@/components/layout/SiteHeader";
import { Hero } from "@/components/sections/Hero";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Above-fold preview</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <SiteHeader client:load />
    <Hero client:load />
  </body>
</html>

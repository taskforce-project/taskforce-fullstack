---
/**
 * BaseLayout - coquille partagée de toutes les pages marketing (light-only).
 * <head>/SEO + Inter Variable + SiteHeader (îlot) + <slot/> + SiteFooter (statique, SSR/SEO).
 * Chaque page passe `title` / `description` (+ `image` OG optionnelle).
 */
import "@/styles/global.css";
import { SiteHeader } from "@/components/site/SiteHeader";
import { SiteFooter } from "@/components/site/SiteFooter";
import { CookieConsent } from "@/components/site/CookieConsent";
import { organizationLd, websiteLd, softwareApplicationLd, breadcrumbLd } from "@/lib/structured-data";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Classe(s) de <body> - permet à une zone (ex. /labs) de commiter son propre fond. Défaut light inchangé. */
  bodyClass?: string;
  /** Couleur de la barre navigateur mobile. Défaut blanc. */
  themeColor?: string;
  /** Ajoute le schema SoftwareApplication (page qui REPRESENTE le produit : la home). */
  software?: boolean;
  /** JSON-LD specifique a la page (ex. BreadcrumbList, FAQPage) en plus de l'entite globale. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og-image.png",
  bodyClass = "bg-white",
  themeColor = "#ffffff",
  software = false,
  jsonLd,
} = Astro.props;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
// og:image DOIT etre absolue (beaucoup de scrapers rejettent une URL relative -> preview vide).
const imageURL = Astro.site ? new URL(image, Astro.site).href : image;

// Donnees structurees : entite globale (toutes pages) + SoftwareApplication (home) + JSON-LD de page.
const origin = Astro.site ? Astro.site.origin : "https://taskforce-project.fr";
const structuredData: Record<string, unknown>[] = [organizationLd(origin), websiteLd(origin)];
if (software) structuredData.push(softwareApplicationLd(origin));
const breadcrumb = breadcrumbLd(origin, Astro.url.pathname);
if (breadcrumb) structuredData.push(breadcrumb);
if (jsonLd) structuredData.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TaskForce" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Donnees structurees Schema.org (entite TaskForce + produit) -->
    {structuredData.map((node) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
    ))}

    <!-- Sora (display) + Inter Variable (corps) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Sora:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class:list={["min-h-screen font-sans text-ink antialiased", bodyClass]}>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader client:load />
    <main id="main" class="pt-[100px]">
      <slot />
    </main>
    <SiteFooter />
    <CookieConsent client:load />
    {/* Titres de section révélés au scroll (h2.t-h2). Bundlé et différé par Astro. */}
    <script>
      import "@/scripts/reveal-titles";
    </script>
  </body>
</html>

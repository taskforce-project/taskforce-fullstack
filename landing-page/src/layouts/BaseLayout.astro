---
/**
 * Coquille de toutes les pages : <head> (SEO, OpenGraph, JSON-LD, polices servies par le site), en-tête,
 * contenu, pied de page. Site en clair ; aucun script de mesure, aucun cookie.
 */
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import { breadcrumbLd, organizationLd, softwareApplicationLd, websiteLd } from "@/lib/structured-data";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Ajoute le schéma SoftwareApplication (pages qui présentent le produit). */
  software?: boolean;
  /** Version desktop publiée, pour le schéma SoftwareApplication. */
  softwareVersion?: string;
  /** JSON-LD propre à la page (FAQPage…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Pages sans intérêt pour un moteur (404). */
  noindex?: boolean;
}

const { title, description, image = "/og-image.jpg", software = false, softwareVersion, jsonLd, noindex = false } =
  Astro.props;

// Sans barre finale, comme les liens internes et le sitemap (le build produit /features/ pour /features).
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = Astro.site ? new URL(pathname, Astro.site).href : pathname;
const imageURL = Astro.site ? new URL(image, Astro.site).href : image;
const origin = Astro.site ? Astro.site.origin : "https://taskforce-project.fr";

const structuredData: Record<string, unknown>[] = [organizationLd(origin), websiteLd(origin)];
if (software) structuredData.push(softwareApplicationLd(origin, softwareVersion));
const breadcrumb = breadcrumbLd(origin, Astro.url.pathname);
if (breadcrumb) structuredData.push(breadcrumb);
if (jsonLd) structuredData.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));

// Changement de page sans rechargement : l'ancien contenu s'efface en remontant, le nouveau arrive d'en bas
// (keyframes tf-page-out / tf-page-in de global.css). L'en-tête, persistant, ne bouge pas.
const pageAnimation = {
  old: { name: "tf-page-out", duration: "0.16s", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
  new: { name: "tf-page-in", duration: "0.45s", easing: "cubic-bezier(0.22, 1, 0.36, 1)", fillMode: "both" },
};
const pageTransition = { forwards: pageAnimation, backwards: pageAnimation };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // La classe « js » active les apparitions au défilement ; la navigation sans rechargement remplace les
      // attributs de <html>, on la remet après chaque changement de page.
      document.documentElement.classList.add("js");
      document.addEventListener("astro:after-swap", () => document.documentElement.classList.add("js"));
    </script>
    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TaskForce" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TaskForce, the desktop app for working with AI agents" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    {structuredData.map((node) => <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />)}
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="pt-16" transition:animate={pageTransition}>
      <slot />
    </main>
    <Footer />

    <script>
      // Apparition au défilement des blocs [data-reveal], relancée à chaque page (navigation sans rechargement) ;
      // tout apparaît d'un coup si l'utilisateur réduit les animations. En JavaScript simple : le Vite du conteneur
      // Docker de dev lit ce script sans TypeScript.
      let io = null;
      function reveal() {
        io?.disconnect();
        const items = document.querySelectorAll("[data-reveal]:not(.is-in)");
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-in"));
          return;
        }
        io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io?.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        items.forEach((el) => io?.observe(el));
      }
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>

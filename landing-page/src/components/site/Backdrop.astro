---
/**
 * Fond peint d'une zone (héros, bande, appel final) : l'image couvre la zone, cadrée sur ce qui compte. `fade` fond le
 * bas de l'image dans la page ; `veil` pose un voile clair très doux là où passe le texte, pour qu'il se lise sur la
 * peinture. La peinture vit : elle défile un peu moins vite que la page (`parallax`, part de la hauteur de la zone,
 * scripts/motion.js) et dérive très lentement. Décorative : sans texte alternatif, ignorée des lecteurs d'écran.
 */
import { BACKGROUNDS, type BackgroundName } from "@/lib/backgrounds";

interface Props {
  name: BackgroundName;
  class?: string;
  /** Le bas de l'image s'efface dans la page. */
  fade?: boolean;
  /** Voile clair derrière le texte : « top » quand le texte est en haut de la zone, « center » au milieu. */
  veil?: "top" | "center";
  /** Image du haut de page : chargée tout de suite, en priorité. */
  priority?: boolean;
  /** Décalage de défilement, en part de la hauteur de la zone (0 : la peinture suit la page). */
  parallax?: number;
}
const { name, class: cls, fade = false, veil, priority = false, parallax = 0.1 } = Astro.props;
const bg = BACKGROUNDS[name];
---

<div class:list={["backdrop", fade && "backdrop-fade", cls]} aria-hidden="true">
  <div class="backdrop-layer" data-parallax={parallax > 0 ? parallax : undefined}>
    <img
      class="backdrop-drift"
      src={bg.src}
      srcset={bg.srcset}
      sizes="100vw"
      alt=""
      style={`object-position: ${bg.position}`}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </div>
  {veil && <div class:list={["backdrop-veil", `backdrop-veil-${veil}`]} />}
</div>

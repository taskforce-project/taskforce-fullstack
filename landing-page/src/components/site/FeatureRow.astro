---
/**
 * Rangée de fonctionnalité (page Features) : étiquette, titre (slot `title`), chapô, liste cochée, et la vignette
 * animée de la fonctionnalité sur son lavis pastel. `reverse` place la vignette à gauche.
 */
import { Check } from "lucide-react";
import Pill from "./Pill.astro";
import Vignette from "@/components/visuals/Vignette";
import type { VignetteKey } from "@/components/visuals/vignettes";
import { toneInk, toneTint, type Tone } from "@/components/visuals/shapes";

interface Props {
  id: string;
  label: string;
  tone: Tone;
  lead: string;
  points: string[];
  art: VignetteKey;
  reverse?: boolean;
}
const { id, label, tone, lead, points, art, reverse = false } = Astro.props;
---

<section id={id} class="section scroll-mt-16">
  <div class="container-site">
    <div class:list={["grid items-center gap-12 lg:gap-20", reverse ? "lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]" : "lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"]}>
      <div class:list={[reverse && "lg:order-2"]} data-reveal>
        <Pill tone={tone}>{label}</Pill>
        <h2 class="t-h2 mt-6"><slot name="title" /></h2>
        <p class="t-lead mt-6 max-w-xl">{lead}</p>
        <ul class="mt-9 flex flex-col gap-3.5">
          {
            points.map((p) => (
              <li class="flex items-start gap-3 text-[16px] leading-relaxed">
                <span class={`mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full ${toneTint[tone]} ${toneInk[tone]}`}>
                  <Check className="size-3.5" strokeWidth={2.6} aria-hidden="true" />
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <div class:list={[reverse && "lg:order-1"]} data-reveal style="--d: 100ms">
        <Vignette client:visible art={art} tone={tone} />
      </div>
    </div>
  </div>
</section>

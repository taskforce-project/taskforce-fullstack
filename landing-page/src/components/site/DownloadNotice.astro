---
/**
 * Fenêtre ouverte par un clic sur un fichier de la release desktop, partout sur le site : le téléchargement part après
 * quelques secondes, et la fenêtre explique ce qui peut arriver ensuite. Windows : tant que l'installeur n'est pas
 * signé, l'avertissement de Windows ou du navigateur, Smart App Control (aucune exception possible : le couper) et la
 * quarantaine d'un antivirus, avec le rapport VirusTotal du fichier et comment le sortir de quarantaine. Linux : la commande d'installation. Sans release publiée : rien.
 * Windows propose d'abord le Microsoft Store, dont la version est signée ; le choisir annule le téléchargement.
 */
import { getDesktopRelease, SIGNED_BUILDS } from "@/lib/release";
import { LINKS } from "@/lib/site";

const release = await getDesktopRelease();
const files = Object.values(release?.assets ?? {}).map((a) => ({
  url: a.url,
  name: a.name,
  platform: a.platform,
  virustotal: a.virustotal ?? null,
}));
---

{
  files.length > 0 && (
    <dialog id="download-notice" class="download-notice" aria-labelledby="download-notice-title" data-files={JSON.stringify(files)}>
      <div class="flex items-start justify-between gap-6">
        <div>
          <span class="pill" data-tone="yellow">Early access</span>
          <h2 id="download-notice-title" class="t-h3 mt-4">Your download starts in a few seconds</h2>
          <p class="t-small mt-2 text-muted-foreground" data-status aria-live="polite">
            <span data-name class="font-mono" />
          </p>
        </div>
        <form method="dialog">
          <button class="download-notice-close" aria-label="Close">×</button>
        </form>
      </div>

      <div data-for="windows" class="mt-6 flex flex-col gap-4">
        <p class="t-small rounded-lg bg-tint-green px-4 py-3 text-ink-green">
          <strong class="font-medium">Easier: the Microsoft Store.</strong> Its version is signed by Microsoft, so
          Windows doesn't warn you, and the Store installs the updates.{" "}
          <a href={LINKS.microsoftStore} target="_blank" rel="noopener" class="link-inline" data-store>
            Get it from Microsoft Store
          </a>
        </p>
        {!SIGNED_BUILDS.windows && (
          <p class="t-small">
            TaskForce is free, open source and still early, and its installer is not code-signed for now. Windows,
            your browser or your antivirus may warn you, or put the file in quarantine, only because they don't know
            it yet.
          </p>
        )}
        <p class="t-small" data-vt>
          Every new version is scanned by dozens of antivirus engines on VirusTotal before it reaches this page:{" "}
          <a data-vt-link target="_blank" rel="noopener" class="link-inline">see the report for this file</a>.
        </p>
        {!SIGNED_BUILDS.windows && (
          <ol class="download-notice-steps t-small">
            <li>
              <strong>Your browser says the file isn't commonly downloaded:</strong> choose Keep.
            </li>
            <li>
              <strong>“Windows protected your PC”:</strong> choose More info, then Run anyway.
            </li>
            <li>
              <strong>Blocked by Smart App Control:</strong> it only runs signed apps, with no Run anyway. Open Windows
              Security, then App &amp; browser control, then Smart App Control settings, and choose Off.
            </li>
            <li>
              <strong>Quarantined by Microsoft Defender:</strong> open Windows Security, then Virus &amp; threat
              protection, then Protection history; select TaskForce, then Actions, then Restore.
            </li>
            <li>
              <strong>Another antivirus:</strong> restore the file from its quarantine, then open it again. Not sure
              how? <a data-chatgpt target="_blank" rel="noopener" class="link-inline">Ask ChatGPT</a>.
            </li>
          </ol>
        )}
      </div>

      <div data-for="linux-deb" class="mt-6 flex flex-col gap-3">
        <p class="t-small">Then, in a terminal, in the folder of the file:</p>
        <code class="download-notice-cmd">sudo apt install ./<span data-name /></code>
        <p class="t-small">apt installs what TaskForce needs with it. Open TaskForce from your applications.</p>
      </div>

      <div data-for="linux-appimage" class="mt-6 flex flex-col gap-3">
        <p class="t-small">Then make it executable, and open it:</p>
        <code class="download-notice-cmd">chmod +x <span data-name /></code>
        <p class="t-small">On Ubuntu 22.04 and later, AppImages need libfuse2 first (libfuse2t64 on Ubuntu 24.04):</p>
        <code class="download-notice-cmd">sudo apt install libfuse2</code>
      </div>

      <div data-for="linux-deb linux-appimage" class="mt-4">
        <p class="t-small" data-vt>
          This file was scanned on VirusTotal:{" "}
          <a data-vt-link target="_blank" rel="noopener" class="link-inline">see its report</a>.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-end gap-3">
        <a data-download-again class="btn btn-secondary btn-sm">Download again</a>
        <form method="dialog">
          <button class="btn btn-primary btn-sm">Got it</button>
        </form>
      </div>
    </dialog>
  )
}

<script>
  type NoticeFile = { url: string; name: string; platform: string; virustotal: string | null };

  /** Délai avant le téléchargement : le temps de lire le début de la fenêtre. */
  const DELAY_MS = 3000;
  let timer: number | undefined;
  let pending: string | null = null;

  function start() {
    if (timer !== undefined) window.clearTimeout(timer);
    timer = undefined;
    if (!pending) return;
    // Le fichier est servi en pièce jointe par GitHub : la page reste affichée.
    window.location.assign(pending);
    pending = null;
    const status = document.querySelector<HTMLElement>("#download-notice [data-status]");
    if (status) status.firstChild?.replaceWith(document.createTextNode("Your download has started. "));
  }

  function chatgptUrl(name: string): string {
    const question =
      `My antivirus quarantined ${name}, the installer of TaskForce, a free open source app I downloaded from ` +
      "taskforce-project.fr. How do I restore it from quarantine and allow it? Give the steps for the most common " +
      "antivirus programs (Microsoft Defender, McAfee, Norton, Avast, AVG, Bitdefender, Kaspersky, ESET).";
    return `https://chatgpt.com/?q=${encodeURIComponent(question)}`;
  }

  function open(dialog: HTMLDialogElement, file: NoticeFile) {
    dialog.querySelectorAll<HTMLElement>("[data-name]").forEach((el) => (el.textContent = file.name));
    dialog.querySelectorAll<HTMLElement>("[data-for]").forEach((el) => {
      el.hidden = !(el.dataset.for ?? "").split(" ").includes(file.platform);
    });
    dialog.querySelectorAll<HTMLElement>("[data-vt]").forEach((el) => (el.hidden = !file.virustotal));
    dialog.querySelectorAll<HTMLAnchorElement>("[data-vt-link]").forEach((a) => (a.href = file.virustotal ?? "#"));
    dialog.querySelectorAll<HTMLAnchorElement>("[data-chatgpt]").forEach((a) => (a.href = chatgptUrl(file.name)));
    const again = dialog.querySelector<HTMLAnchorElement>("[data-download-again]");
    if (again) again.href = file.url;
    const status = dialog.querySelector<HTMLElement>("[data-status]");
    if (status) {
      status.replaceChildren(document.createTextNode("Preparing "));
      const name = document.createElement("span");
      name.className = "font-mono";
      name.textContent = file.name;
      status.append(name);
    }
    pending = file.url;
    dialog.showModal();
    timer = window.setTimeout(start, DELAY_MS);
  }

  // Délégation sur le document : marche sur toutes les pages, navigation sans rechargement comprise.
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
    if (!link || link.closest("#download-notice")) return;
    const dialog = document.getElementById("download-notice") as HTMLDialogElement | null;
    if (!dialog) return;
    const files = JSON.parse(dialog.dataset.files ?? "[]") as NoticeFile[];
    const file = files.find((f) => f.url === link.href);
    if (!file) return;
    event.preventDefault();
    open(dialog, file);
  });

  // Le Microsoft Store choisi à la place : l'installeur ne se télécharge pas.
  document.addEventListener("click", (event) => {
    if (!(event.target as Element | null)?.closest?.("#download-notice [data-store]")) return;
    pending = null;
    if (timer !== undefined) window.clearTimeout(timer);
    timer = undefined;
    (document.getElementById("download-notice") as HTMLDialogElement | null)?.close();
  });

  // Fermée avant la fin du délai : le téléchargement part tout de suite.
  document.addEventListener(
    "close",
    (event) => {
      if ((event.target as Element | null)?.id === "download-notice") start();
    },
    true,
  );
</script>

<style>
  .download-notice {
    width: min(36rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow-y: auto;
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 24px 64px rgb(15 23 42 / 0.18);
  }
  .download-notice::backdrop {
    background: rgb(15 23 42 / 0.35);
    backdrop-filter: blur(3px);
  }
  .download-notice-close {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--muted-foreground);
    padding: 0.25rem 0.5rem;
    border-radius: 8px;
  }
  .download-notice-close:hover {
    background: var(--muted);
    color: var(--foreground);
  }
  .download-notice-steps {
    display: grid;
    gap: 0.6rem;
    padding-left: 1.15rem;
    list-style: decimal;
  }
  .download-notice-cmd {
    display: block;
    padding: 0.5rem 0.75rem;
    overflow-x: auto;
    border-radius: 8px;
    background: var(--muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    white-space: nowrap;
  }
  [hidden] {
    display: none !important;
  }
</style>

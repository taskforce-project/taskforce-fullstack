---
/**
 * Héros des pages intérieures : une peinture derrière le haut de page (elle s'efface doucement dans la page),
 * l'étiquette, le titre (slot `title`), le chapô, et ce que la page met dessous (slot par défaut : boutons, avis…).
 * La section n'isole pas son empilement : la peinture (z-index -1) reste ainsi sous le contenu de la section suivante
 * qu'elle déborde, au lieu de le recouvrir.
 */
import type { BackgroundName } from "@/lib/backgrounds";
import Backdrop from "./Backdrop.astro";
import Pill from "./Pill.astro";

interface Props {
  label: string;
  lead: string;
  /** La peinture de la page (lib/backgrounds.ts). */
  bg: BackgroundName;
}
const { label, lead, bg } = Astro.props;
---

<section class="relative -mt-16 pt-16">
  <Backdrop name={bg} class="inset-x-0 top-0 h-[760px] sm:h-[820px]" fade veil="top" priority />
  <div class="container-wide relative flex flex-col items-center pt-20 pb-6 text-center sm:pt-24 lg:pt-28">
    <span class="anim-fade-up"><Pill tone="glass">{label}</Pill></span>
    <h1 class="t-h1 anim-fade-up mt-8 max-w-4xl" style="--d: 70ms"><slot name="title" /></h1>
    <p class="t-lead anim-fade-up mt-7 max-w-2xl text-foreground/75" style="--d: 140ms">{lead}</p>
    <slot />
  </div>
</section>

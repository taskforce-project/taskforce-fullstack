---
/**
 * PageCta — bandeau d'appel à l'action de fin de page (repris de `FinalCta` de la home).
 * Carte blanche, halo bleu discret, titre display, jusqu'à deux CTA + note. AUCUN motif de points
 * (les points restent réservés au hero, cf. retour user 04/08).
 */
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  lead?: string;
  primary?: Cta;
  secondary?: Cta;
  note?: string;
}

const { title, lead, primary, secondary, note } = Astro.props;
---

<section class="bg-secondary">
  <div class="container-rail py-24">
    <div class="bg-card relative overflow-hidden rounded-3xl border px-8 py-16 text-center sm:py-20">
      <h2 class="t-h2 relative">{title}</h2>
      {lead && <p class="t-lead relative mx-auto mt-4 max-w-lg">{lead}</p>}
      {(primary || secondary) && (
        <div class="relative mt-8 flex flex-wrap justify-center gap-3">
          {primary && (
            <a href={primary.href} class={cn(buttonVariants({ size: "pill-lg" }))}>{primary.label}</a>
          )}
          {secondary && (
            <a href={secondary.href} class={cn(buttonVariants({ variant: "outline", size: "pill-lg" }))}>
              {secondary.label}
            </a>
          )}
        </div>
      )}
      {note && <p class="text-muted-foreground relative mt-6 text-[12.5px]">{note}</p>}
    </div>
  </div>
</section>

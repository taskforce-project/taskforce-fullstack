---
/**
 * LabsGradientDefs — déclare les dégradés SVG utilisés par les icônes Labs (`stroke: url(#lgX)`).
 * Invisible (0×0), à inclure UNE fois par page Labs. C'est ce qui permet à l'icône elle-même de
 * prendre le dégradé (retour user : « pas de fond derrière les icônes, c'est l'icône qui prend le dégradé »).
 * Palette tirée de l'image, sans violet.
 */
---

<svg aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;width:0;height:0">
  <defs>
    <linearGradient id="lgA" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ff8a7a"></stop>
      <stop offset="100%" stop-color="#ff6f91"></stop>
    </linearGradient>
    <linearGradient id="lgB" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7db8ff"></stop>
      <stop offset="100%" stop-color="#ff9ec7"></stop>
    </linearGradient>
    <linearGradient id="lgC" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffb489"></stop>
      <stop offset="100%" stop-color="#ff7eb3"></stop>
    </linearGradient>
    <linearGradient id="lgD" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ff9a6c"></stop>
      <stop offset="100%" stop-color="#ff6f91"></stop>
    </linearGradient>
    <linearGradient id="lgE" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7db8ff"></stop>
      <stop offset="100%" stop-color="#ff8a7a"></stop>
    </linearGradient>
  </defs>
</svg>

---
/** Pied de page : logo et promesse, liens par groupe, ligne de bas de page. Fond papier, coins du haut arrondis. */
import { ArrowUpRight } from "lucide-react";
import Logo from "./Logo.astro";
import { FOOTER_GROUPS, LINKS } from "@/lib/site";
import { PRODUCT_VERSION } from "@/product-version";

const year = new Date().getFullYear();
---

<footer class="bg-card">
  <div class="container-wide grid gap-14 pt-20 pb-16 md:grid-cols-[1.5fr_repeat(3,1fr)] md:gap-10">
    <div class="max-w-sm">
      <Logo class="text-foreground" />
      <p class="t-small mt-5">
        The desktop app to plan your work, keep its memory and hand tasks to AI agents. Free and open source.
      </p>
      <a href="/download" class="btn btn-primary btn-sm mt-7">Download TaskForce</a>
    </div>

    {
      FOOTER_GROUPS.map((group) => (
        <div>
          <p class="t-label">{group.title}</p>
          <ul class="mt-5 flex flex-col gap-3">
            {group.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? "_blank" : undefined}
                  rel={l.external ? "noopener" : undefined}
                  class="inline-flex items-center gap-1 text-[15px] text-foreground/80 transition-colors hover:text-foreground"
                >
                  {l.label}
                  {l.external && <ArrowUpRight className="size-3.5 text-subtle" aria-hidden="true" />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="container-wide">
    <div class="flex flex-col gap-3 border-t border-black/[0.07] py-6 text-[13.5px] text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} TaskForce · v{PRODUCT_VERSION} · Windows, Linux · macOS soon</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href={LINKS.license} target="_blank" rel="noopener" class="hover:text-foreground">Open source, AGPL-3.0</a>
        <a href={`mailto:${LINKS.email}`} class="hover:text-foreground">{LINKS.email}</a>
      </p>
    </div>
  </div>
</footer>

---
/**
 * TraitGrid — la grille à « traits intégrés » standard (cf. `.ai/landing-design-system.md` §3) :
 * edge-to-edge (`-mx` casse le rail), filets 1px (`gap-px bg-border`), filets haut/bas (`border-y`).
 * Les cellules passent par le <slot/> et DOIVENT être `bg-card` (ex. `<div class="bg-card p-6 sm:p-8">`).
 * Cellule pleine largeur : caler le `col-span` sur le MÊME breakpoint que le passage multi-colonnes,
 * sinon trou gris dans la plage intermédiaire. cols=2 → `sm:col-span-2`. cols=3 → `sm:col-span-2 lg:col-span-3`.
 * cols=4 → `sm:col-span-2 lg:col-span-4`. (Piège vécu : `lg:col-span-2` laissait un demi-gris de 640 à 1024px.)
 */
interface Props {
  cols?: 2 | 3 | 4;
  class?: string;
}
const { cols = 3, class: className = "" } = Astro.props;

/* Classes statiques (Tailwind ne purge pas ce qui est littéral ici). */
const COLS: Record<number, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};
---

<div class:list={["-mx-6 grid gap-px border-y border-border bg-border lg:-mx-10", COLS[cols], className]}>
  <slot />
</div>

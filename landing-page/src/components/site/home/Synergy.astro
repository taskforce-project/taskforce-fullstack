---
/**
 * Synergy (.astro) — « why it's different » : la thèse + la grille des 4 pièces (traits) + le bento
 * « la couche de savoir » avec le **graphe de décision en React Flow** (`DecisionGraphFlow`, sur canvas
 * à points). Anciennement `Showcase.tsx › Synergy` (React) : converti en `.astro` pour héberger l'îlot RF.
 */
import SectionShell from "@/components/site/sections/SectionShell.astro";
import { UseCaseDemo } from "@/components/site/illustrations/UseCaseDemo";
import { AuditTrailDemo } from "@/components/site/illustrations/LiveSchematics";
import { DecisionGraphFlow } from "@/components/site/flows/OrchestrationFlows";
import { ArrowRight } from "lucide-react";

/* Chaque pièce se DÉMONTRE (demo animé), façon page Agents. Verify = la piste d'audit réutilisée. */
const SYSTEMS = [
  {
    verb: "Plan",
    part: "Agent runtime",
    text: "Agents draft each checkpoint — the vision, the spec, the architecture.",
    demo: {
      kind: "draft" as const,
      title: "Checkpoint · Spec",
      chip: "Drafted for review",
      items: ["Frame the outcome & DoD", "Draft spec + acceptance criteria", "Hand to a human to approve"],
    },
  },
  {
    verb: "Remember",
    part: "TaskForce Memory",
    text: "Links every decision, constraint and trade-off — with the reason attached.",
    demo: {
      kind: "graph" as const,
      title: "Why this decision",
      center: "Postgres",
      nodes: ["GDPR residency", "vs Mongo", "3 files"],
    },
  },
  {
    verb: "Execute",
    part: "Workflow engine",
    text: "The governed run: checkpoints, approvals and assignment.",
    demo: {
      kind: "pipeline" as const,
      title: "Governed run",
      stages: ["Spec", "Approve", "Build", "QA", "Ship"],
    },
  },
  {
    verb: "Verify",
    part: "Audit system",
    text: "Every decision, approval and model call, recorded.",
    demo: null,
  },
];
---

<SectionShell
  eyebrow="Why it's different"
  title="A delivery system, not an assistant"
  lead="Most AI tools optimize execution. TaskForce optimizes the system that decides what gets executed — one platform where planning, memory, the governed run and the audit trail already know about each other, instead of four tools you wire together."
>
  <p class="mt-8 max-w-2xl text-[16px] leading-8 font-medium text-foreground">
    Agents without context become assistants.<br />
    Context without execution becomes documentation.<br />
    <span class="text-primary">TaskForce connects both.</span>
  </p>

  <div class="-mx-6 mt-12 grid grid-cols-1 gap-px border-y border-border bg-border sm:grid-cols-2 lg:-mx-10">
    {
      SYSTEMS.map((s, i) => (
        <div class="bg-card flex flex-col p-6 sm:p-8">
          {i === 3 ? (
            <AuditTrailDemo compact className="h-[172px]" client:visible />
          ) : (
            s.demo && <UseCaseDemo demo={s.demo} className="h-[172px]" client:visible />
          )}
          <div class="mt-5 flex items-center gap-2">
            <span class="text-muted-foreground font-mono text-[12px] tracking-[0.12em]">{`0${i + 1}`}</span>
            <h3 class="text-[16px] font-semibold text-foreground">{s.verb}</h3>
            <span class="text-muted-foreground text-[12px]">· {s.part}</span>
          </div>
          <p class="text-muted-foreground mt-2 text-[13.5px] leading-6">{s.text}</p>
        </div>
      ))
    }
  </div>

  {/* Bento : la couche de savoir — edge-to-edge, DecisionGraph en React Flow sur canvas à points. */}
  <div class="bg-card -mx-6 mt-6 grid items-center gap-8 border-y border-border px-6 py-8 sm:px-8 lg:-mx-10 lg:grid-cols-2 lg:gap-14 lg:px-10">
    <div>
      <h3 class="t-h3">Git remembers what changed. TaskForce remembers why.</h3>
      <p class="text-muted-foreground mt-3 text-[14px] leading-7">
        Not a search box over your docs — a map of why. TaskForce Memory links the decisions,
        constraints and trade-offs behind the system, and how they connect. Every run reads why the
        system is the way it is, and writes its own decisions back. Retrieval hands you passages; this
        hands you the reasoning.
      </p>
      <a
        href="/product/brain-os"
        class="link-underline text-primary mt-6 inline-flex items-center gap-1 text-[14px] font-medium"
      >
        Inside TaskForce Memory
        <ArrowRight className="size-4" />
      </a>
    </div>
    <div class="flow-canvas relative h-[340px] overflow-hidden border">
      <DecisionGraphFlow client:only="react" />
    </div>
  </div>

  <p class="text-muted-foreground mt-10 max-w-2xl text-[14px] leading-7">
    The payoff is daily: fewer meetings, fewer half-written tickets, less context re-explained — and
    agents that already understand your system.
  </p>
</SectionShell>

---
/**
 * Hero (.astro) - anciennement Hero.tsx (visuel = `SpecPanel`, fausse UI). Le hero utilise
 * maintenant **React Flow** (le run), présenté dans la **double-card** façon orchestration :
 * une card blanche (extérieure) → une card à points `flow-canvas` (intérieure) → le flow posé dessus.
 * Le texte reste en SSR (LCP protégé : le H1 est l'élément LCP) ; seul le flow est `client:only`
 * (React Flow a besoin du DOM), espace réservé par `aspect-ratio` → aucun CLS. Copie 100 % préservée.
 */
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { BrandLogo } from "@/components/site/BrandLogo";
import { HeroFlow } from "@/components/site/flows/OrchestrationFlows";

const BUILT_WITH = [
  { key: "anthropic", label: "Claude" },
  { key: "cursor", label: "Cursor" },
  { key: "openai", label: "OpenAI" },
  { key: "ollama", label: "Ollama" },
  { key: "github", label: "GitHub" },
  { key: "linear", label: "Linear" },
];
---

<section class="bg-card relative border-b">
  <div class="container-rail relative py-20 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,520px)_minmax(0,1fr)] lg:gap-16">
      {/* Colonne texte - SSR (le H1 = LCP) */}
      <div>
        <p class="text-primary mb-4 text-[14px] font-medium tracking-[-0.01em]">
          The AI delivery operating system
        </p>
        <h1 class="t-h1">
          Describe the outcome.<br class="hidden sm:block" /> TaskForce runs the delivery.
        </h1>
        <p class="t-lead mt-5 max-w-xl">
          You describe the outcome. TaskForce drafts the spec, the plan and the prompt your coding
          agent runs, keeps you on every decision, and remembers why. Today it works issue by issue -
          the full governed run is where it is headed.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={"/waitlist"} class={cn(buttonVariants({ size: "pill" }))}>
            Run your first workflow
          </a>
          <a href="/book-a-demo" class={cn(buttonVariants({ variant: "outline", size: "pill" }))}>
            Book a demo
          </a>
        </div>
        <p class="text-muted-foreground mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px]">
          <span>You approve every decision</span>
          <span aria-hidden class="text-border">·</span>
          <span>Runs on your models - local or hosted</span>
          <span aria-hidden class="text-border">·</span>
          <span>Self-hosted, your network</span>
        </p>
      </div>

      {/* Double-card : card blanche → card à points → le run (React Flow) */}
      <div class="lg:pl-4">
        <div class="bg-card mx-auto w-full max-w-[560px] rounded-2xl border p-3 sm:p-4">
          <div class="flow-canvas relative overflow-hidden border" style="aspect-ratio: 560 / 600">
            <HeroFlow client:only="react" />
          </div>
        </div>
        <p class="text-muted-foreground/60 mt-4 text-center font-mono text-[10px] tracking-wide uppercase">
          Illustrative - the full run is Planned
        </p>
      </div>
    </div>

    {/* Preuve sociale honnête : « Built with » (pas « customers ») - l'écosystème qu'on utilise. */}
    <div class="mt-14 flex flex-col gap-5 border-t pt-8 sm:flex-row sm:items-center sm:gap-8">
      <span class="text-muted-foreground shrink-0 text-[12.5px]">
        Works with the tools your engineers already trust
      </span>
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-4">
        {
          BUILT_WITH.map((b) => (
            <li>
              <BrandLogo
                brand={b.key}
                label={b.label}
                className="h-6 opacity-60 grayscale transition-[opacity,filter] duration-200 hover:opacity-100 hover:grayscale-0"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

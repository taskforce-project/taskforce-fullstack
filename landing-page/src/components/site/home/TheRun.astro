---
/**
 * TheRun (.astro) - « The run » : le run en **React Flow** (`HeroFlow`, sur canvas à points) au lieu de
 * l'ancienne timeline animée maison (`RunTimeline.tsx`). Copie conservée : 3 garanties, note honnête,
 * et le détail des 7 checkpoints (table). Converti en `.astro` pour héberger l'îlot RF.
 * 24/09 (validé CEO) : les 4 puces « entreprise » (audit, self-hosted, any coding agent, a model per
 * step) sont retirées, la section Enterprise les dit déjà presque mot pour mot.
 */
import SectionShell from "@/components/site/sections/SectionShell.astro";
import { StepChainFlow } from "@/components/site/flows/OrchestrationFlows";
import { LevelBadge } from "@/components/site/Section";
import { ArrowRight, ChevronDown } from "lucide-react";

const RUN_SUB = [
  { title: "Every step is attributable", text: "Each checkpoint names what produced it and the model it ran on." },
  { title: "Nothing advances without you", text: "Each checkpoint waits for a human, which is exactly what lets you hand agents more, not less." },
  { title: "Rejections carry your comment", text: "Send a step back with a note and it comes into the next attempt." },
];

// Le run comme TIMELINE HORIZONTALE (forme distincte du pipeline vertical de la page orchestration).
const RUN_STEPS = [
  { icon: "flag", title: "Outcome", sub: "the goal" },
  { icon: "compass", title: "Frame & spec", sub: "CPO" },
  { icon: "building", title: "Approach", sub: "CTO" },
  { icon: "calendar", title: "Plan", sub: "COO" },
  { icon: "rocket", title: "Ship", sub: "reviewed" },
];

const ANATOMY = [
  { step: "Vision", by: "CPO agent", artifact: "One page: the problem, who has it, what « done » looks like.", decision: "Approve the framing, or reframe it before anything is built on top.", level: "labs" as const },
  { step: "Product spec", by: "CPO agent", artifact: "Stories with acceptance criteria, and the edge cases nobody asked about.", decision: "Approve, or send it back with what is missing.", level: "labs" as const },
  { step: "Architecture", by: "CTO agent", artifact: "The proposed approach, and the option that was rejected with the reason.", decision: "Approve the trade-off. This is the decision that is expensive to reverse later.", level: "labs" as const },
  { step: "API contract", by: "CTO agent", artifact: "Endpoints, payloads and error cases, written against your existing conventions.", decision: "Approve or amend. Downstream steps are generated from what you sign here.", level: "labs" as const },
  { step: "Breakdown", by: "COO agent", artifact: "Issues, sized and ordered, each linked back to the line of spec it came from.", decision: "Approve it, then Smart Assign routes each issue to a person.", level: "live" as const },
  { step: "Implementation", by: "Your coding agent", artifact: "A branch. TaskForce hands over the context and stays out of the way.", decision: "Your normal code review. We do not replace it.", level: "live" as const },
  { step: "QA & deploy", by: "COO agent", artifact: "A checklist derived from the acceptance criteria you approved in step two.", decision: "Sign off. The whole chain is in the audit trail.", level: "beta" as const },
];
---

<SectionShell>
  <div class="max-w-2xl">
    <p class="t-eyebrow mb-3">The run</p>
    <h2 class="t-h2">Watch one outcome become a shipped change</h2>
    <p class="t-lead mt-4">
      A delivery is a sequence of decisions, not a single prompt. TaskForce makes each one explicit:
      an agent drafts it, a human signs it off, and the run moves on.
    </p>
  </div>

  {/* Le run en TIMELINE horizontale, pleine largeur (≠ le pipeline vertical d'orchestration). */}
  {/* Horizontale dès 640 px ; empilée en dessous (sinon textes illisibles), d'où la hauteur mobile. */}
  <div class="flow-canvas relative mt-10 h-[440px] w-full overflow-hidden border sm:h-[200px]">
    <StepChainFlow steps={RUN_STEPS} dir="h" stackOnMobile id="run-timeline" highlight={2} w={176} client:only="react" />
  </div>
  <p class="text-muted-foreground mt-3 text-[12.5px]">
    Illustrative: each step is an agent draft that a human approves. The seven real checkpoints are detailed below.
  </p>

  {/* Les 3 garanties, en 3 colonnes sous la timeline. */}
  <div class="mt-12 grid gap-8 border-t pt-10 sm:grid-cols-3">
    {
      RUN_SUB.map((s) => (
        <div>
          <h3 class="t-h5">{s.title}</h3>
          <p class="text-muted-foreground mt-1 text-[13.5px] leading-6">{s.text}</p>
        </div>
      ))
    }
  </div>
  <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
    <a
      href="/product/orchestration"
      class="link-underline text-primary inline-flex items-center gap-1 text-[14px] font-medium"
    >
      See a run end to end
      <ArrowRight className="size-4" />
    </a>
    <p class="text-muted-foreground text-[12.5px] leading-5">
      Drafting a spec and the breakdown ship <span class="text-foreground font-medium">today</span>;
      the full seven-checkpoint run is <span class="text-foreground font-medium">Planned</span>.
    </p>
  </div>

  {/* Le détail des 7 checkpoints - DÉPLIABLE (25/09, objectif home ~10 écrans validé CEO) : le titre et
      sa phrase portent le message et restent visibles ; le tableau (~700 px) s'ouvre au clic. Contenu
      toujours dans le DOM, donc toujours indexé. <details> natif : clavier et lecteurs d'écran OK. */}
  <details class="group mt-16">
    <summary class="flex cursor-pointer list-none flex-col gap-4 rounded-md sm:flex-row sm:items-end sm:justify-between [&::-webkit-details-marker]:hidden">
      <span class="block max-w-2xl">
        <h3 class="t-h3">Seven checkpoints. Seven artifacts. One accountable chain.</h3>
        <span class="text-muted-foreground mt-2 block text-[14px] leading-7">
          Not a black box that returns a pull request, but a sequence of artifacts, each one
          attributable and each one refusable.
        </span>
      </span>
      <span class="text-primary inline-flex shrink-0 items-center gap-1 text-[14px] font-medium">
        <span class="group-open:hidden">Show the seven checkpoints</span>
        <span class="hidden group-open:inline">Hide the checkpoints</span>
        <ChevronDown className="size-4 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none" />
      </span>
    </summary>
    <div class="-mx-6 mt-7 overflow-x-auto border-y border-border lg:-mx-10">
      <table class="w-full min-w-[860px] border-collapse text-left">
        <caption class="sr-only">What each checkpoint of a run produces and what the human decides</caption>
        <thead>
          <tr class="bg-secondary/50 text-muted-foreground text-[11px] tracking-[0.06em] uppercase">
            <th scope="col" class="px-5 py-3 font-medium">Checkpoint</th>
            <th scope="col" class="rail-x px-5 py-3 font-medium">Produced by</th>
            <th scope="col" class="rail-x px-5 py-3 font-medium">What lands in your workspace</th>
            <th scope="col" class="rail-x px-5 py-3 font-medium">What you decide</th>
          </tr>
        </thead>
        <tbody>
          {
            ANATOMY.map((r, i) => (
              <tr class="border-t align-top">
                <th scope="row" class="px-5 py-4 text-left">
                  <span class="text-muted-foreground font-mono text-[11px]">{String(i + 1).padStart(2, "0")}</span>
                  <span class="mt-1 flex items-center gap-2">
                    <span class="text-[14px] font-medium text-foreground">{r.step}</span>
                    <LevelBadge level={r.level} />
                  </span>
                </th>
                <td class="rail-x text-muted-foreground px-5 py-4 text-[13px] whitespace-nowrap">{r.by}</td>
                <td class="rail-x px-5 py-4 text-[13.5px] leading-6 text-foreground">{r.artifact}</td>
                <td class="rail-x text-muted-foreground px-5 py-4 text-[13.5px] leading-6">{r.decision}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="border-primary/40 mt-6 border-l-2 pl-5">
      <p class="text-[14px] font-semibold text-foreground">Adaptive by design</p>
      <p class="text-muted-foreground mt-1 text-[13.5px] leading-6">
        A bug fix doesn't need a strategy phase; a migration doesn't take the same path as a feature
        launch. The run adapts to the decision being made. It just never skips the approval.
      </p>
    </div>
  </details>
</SectionShell>

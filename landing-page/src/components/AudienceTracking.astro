---
/**
 * AudienceTracking - script de mesure d'audience de la landing (CERT-C20).
 *
 * Source unique du traceur : la landing est en cours de migration vers `BaseLayout.astro`, et
 * une partie des pages porte encore son propre `<head>`. Dupliquer le script dans chacune aurait
 * garanti une divergence ; ce composant est donc inclus partout, et disparaîtra naturellement des
 * pages au fur et à mesure qu'elles basculent sur le layout partagé.
 *
 * Outil retenu : Umami, auto-hébergé. Deux raisons de conformité, pas de confort.
 *  - Il ne dépose AUCUN cookie et ne conserve pas d'adresse IP, d'où l'absence de recueil de
 *    consentement préalable.
 *  - Il est auto-hébergé, donc aucun transfert hors UE. Le registre des traitements reste sans
 *    destinataire étranger, ce qui serait impossible avec une solution hébergée outre-Atlantique.
 *
 * Les deux variables sont vides par défaut : sans elles, rien n'est émis. C'est voulu, pour que
 * ni les constructions locales, ni les tests, ni les audits Lighthouse ne polluent les
 * statistiques avec du trafic fantôme.
 *
 * `PUBLIC_UMAMI_WEBSITE_ID` est genere par l'instance Umami a la creation du site : il ne peut
 * pas etre ecrit en dur, et n'a rien d'un secret puisqu'il est public par conception.
 */
const src = import.meta.env.PUBLIC_UMAMI_SRC;
const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const enabled = Boolean(src && websiteId);
---

{
  /* `defer` plutot qu'`async` : le traceur ne doit jamais concurrencer le rendu, la performance
     mesuree par Lighthouse etant elle-meme un critere evalue. */
  enabled && <script is:inline defer src={src} data-website-id={websiteId} />
}

# === Cloudflare Tunnel ===
# Dashboard Zero Trust → Networks → Tunnels → créer un tunnel → copier le token connecteur ici.
# Puis ajouter un public hostname pointant sur  Service = http://landing:4321
TUNNEL_TOKEN=

# === (optionnel) Mesure d'audience Umami ===
# Laisser vide = aucun script de mesure injecté dans les pages.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=

# === Cloudflare Tunnel ===
# Dashboard Zero Trust → Networks → Tunnels → créer un tunnel → copier le token connecteur ici.
# Puis ajouter un public hostname pointant sur  Service = http://landing:4321
TUNNEL_TOKEN=

# === Application (liens « Sign in » / CTA vers l'app) ===
# Le header et le pricing pointent vers app.<domaine>. « Préfixe (sous-domaine `app`) dans le code
# (src/components/site/nav.ts), suffixe (domaine) ici. » Non défini → défaut `taskforce-project.fr`.
PUBLIC_BASE_DOMAIN=taskforce-project.fr
# Échappatoire : URL d'app arbitraire (preview Vercel, domaine custom) — l'emporte sur PUBLIC_BASE_DOMAIN.
# PUBLIC_APP_URL=https://app.taskforce-project.fr

# === (optionnel) Mesure d'audience PostHog (UE) ===
# Analytics derrière consentement (opt-in cookies). Clé PROJET `phc_...` : PUBLIQUE et write-only.
# Non définie → défaut UE en dur (voir src/lib/analytics.ts). Région UE, aucune donnée hors UE.
# PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
